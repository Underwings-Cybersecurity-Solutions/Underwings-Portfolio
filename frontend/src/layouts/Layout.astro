---
// ===========================================
// BASE LAYOUT
// Underwings Cybersecurity Solutions
// ===========================================

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  keywords?: string;
  wfPage?: string;
  schema?: object | object[] | null;
  bodyClass?: string;
  hasArabicAlternate?: boolean;
  // Set on non-canonical variants (e.g. paginated /blog?page=N) so they are
  // noindex,follow with a self-canonical and no hreflang — the correct treatment
  // for archive pagination and what clears the crawler's hreflang "conflicts".
  noindex?: boolean;
}

const {
  title = "Underwings – Cybersecurity Solutions & Software Sales",
  description = "Underwings is a cybersecurity startup providing VAPT, ISO 27001 implementation, security awareness training, and security software sales in UAE.",
  ogImage = "/brand/og/og-default.png",
  canonical,
  keywords = "cybersecurity UAE, VAPT services Abu Dhabi, ISO 27001 implementation, security software sales, penetration testing UAE, cybersecurity training",
  wfPage = "6920627afaad5c7afb54bfa8",
  schema,
  bodyClass = "body",
  // Set to true on any English page that has a published Arabic equivalent at
  // the mirrored /ar/<path> URL. Lets hreflang scale to a full Arabic tree
  // without emitting alternates that point at pages which don't exist yet.
  hasArabicAlternate,
  noindex = false,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://underwings.org";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const nonce = Astro.locals.nonce || "";

// ── Canonicalisation ─────────────────────────────────────────────
// One deterministic URL form per page: no trailing slash, no query string.
// canonical, og:url and every hreflang href are built from this same value so
// they never disagree (the root cause of the crawler's hreflang "conflicts").
const rawPath = Astro.url.pathname;
const normalizedPath = rawPath === "/" ? "/" : rawPath.replace(/\/+$/, "");
const canonicalUrl =
  canonical || (normalizedPath === "/" ? siteUrl : `${siteUrl}${normalizedPath}`);

// ── hreflang ─────────────────────────────────────────────────────
// Arabic lives under /ar (today only the homepage; built to scale to /ar/*).
const isArabic = normalizedPath === "/ar" || normalizedPath.startsWith("/ar/");
const enPath = isArabic ? (normalizedPath.replace(/^\/ar/, "") || "/") : normalizedPath;
const enUrl = enPath === "/" ? siteUrl : `${siteUrl}${enPath}`;
const arUrl = enPath === "/" ? `${siteUrl}/ar` : `${siteUrl}/ar${enPath}`;
// Emit the en↔ar pair only where an Arabic equivalent actually exists.
const showArabic = hasArabicAlternate ?? (normalizedPath === "/" || isArabic);

// Schema logic: null = no schema, undefined = default Organization, custom = render custom
// Shared @id so every page's Organization reference consolidates into one entity
// in Google's Knowledge Graph (and is reused by the richer node on /about).
const orgId = `${siteUrl}/#organization`;
const defaultSchema = {
  "@context": "https://schema.org",
  // ProfessionalService is a LocalBusiness subtype, so this single node now
  // carries the LocalBusiness signals the SEO audit §2.5 flagged as missing for
  // UAE local / map-pack intent — while keeping the same shared @id so every
  // page's Organization reference still consolidates into one entity.
  "@type": ["Organization", "ProfessionalService"],
  "@id": orgId,
  "name": "Underwings Cybersecurity Solutions",
  "alternateName": "Underwings",
  "url": siteUrl,
  "logo": `${siteUrl}/brand/logos/underwings-icon-green.png`,
  "image": `${siteUrl}/brand/og/og-default.png`,
  "description": "UAE-based cybersecurity company delivering penetration testing (VAPT), ISO 27001 / NESA / UAE PDPL compliance, cloud and network security, security awareness training, and security software — by named, certified practitioners.",
  "foundingDate": "2026",
  "slogan": "Honest, practitioner-led cybersecurity for UAE businesses.",
  "email": "contact@underwings.org",
  "telephone": "+971 50 567 0394",
  "address": {
    "@type": "PostalAddress",
    // TODO (backlink strategy §1 / audit §2.5): add "streetAddress" + "postalCode"
    // once the real Abu Dhabi address is confirmed — required to match the
    // Google Business Profile + UAE directory citations byte-for-byte.
    "addressLocality": "Abu Dhabi",
    "addressRegion": "Abu Dhabi",
    "addressCountry": "AE"
  },
  // Safe to publish: every service page lists AED prices, so this is a fact
  // already on the site rather than a guess.
  "priceRange": "AED 3,500 – AED 88,000",
  // STILL BLOCKED — do not fill these in with placeholder values. Each one must
  // match the Google Business Profile byte-for-byte or it damages the local
  // citation consistency it is meant to establish:
  //   "streetAddress" + "postalCode" on address (needs the real office address)
  //   "geo": { "@type": "GeoCoordinates", "latitude": …, "longitude": … }
  //   "openingHoursSpecification": [...]   (needs confirmed business hours)
  //   "hasMap": "https://maps.google.com/?cid=…"  (generated by the GBP listing)
  "areaServed": [
    { "@type": "Country", "name": "United Arab Emirates" },
    { "@type": "City", "name": "Abu Dhabi" },
    { "@type": "City", "name": "Dubai" }
  ],
  "knowsAbout": [
    "Penetration Testing", "Vulnerability Assessment", "Web Application Security",
    "ISO/IEC 27001", "NESA / UAE IA", "UAE PDPL", "ADHICS",
    "Cloud Security", "Microsoft 365 Security", "Network Security",
    "Security Awareness Training", "Phishing Simulation"
  ],
  "sameAs": [
    "https://www.linkedin.com/company/underwings-cybersecurity",
    "https://www.instagram.com/underwings.uae"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+971 50 567 0394",
    "email": "contact@underwings.org",
    "contactType": "sales",
    "areaServed": "AE",
    "availableLanguage": ["en", "ar"]
  }
};

const schemaToRender = schema === null ? null : schema !== undefined ? schema : defaultSchema;
const schemaArray = schemaToRender === null ? [] : Array.isArray(schemaToRender) ? schemaToRender : [schemaToRender];
---

<!DOCTYPE html>
<html lang={isArabic ? "ar" : "en"} dir={isArabic ? "rtl" : "ltr"} data-wf-page={wfPage} data-wf-site="69206277faad5c7afb54beff">
<head>
  <meta charset="utf-8">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:image" content={`${siteUrl}${ogImage}`}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:locale" content="en_AE">
  <meta property="og:locale:alternate" content="ar_AE">

  <!-- hreflang: reciprocal en ↔ ar; all hrefs match the canonical URL form.
       Suppressed on noindex variants (e.g. /blog?page=N) — non-canonical
       pages must not emit alternates, which is what caused the crawler's
       hreflang "conflicts within page source code". -->
  {!noindex && (showArabic ? (
    <>
      <link rel="alternate" hreflang="en" href={enUrl}>
      <link rel="alternate" hreflang="ar" href={arUrl}>
      <link rel="alternate" hreflang="x-default" href={enUrl}>
    </>
  ) : (
    <>
      <link rel="alternate" hreflang="en" href={canonicalUrl}>
      <link rel="alternate" hreflang="x-default" href={canonicalUrl}>
    </>
  ))}
  <meta content="summary_large_image" name="twitter:card">
  <meta content="width=device-width, initial-scale=1" name="viewport">
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"}>
  <meta name="author" content="Underwings Cybersecurity Solutions">
  <meta name="geo.region" content="AE">
  <meta name="geo.placename" content="Abu Dhabi, UAE">
  <link rel="canonical" href={canonicalUrl}>
  <meta name="keywords" content={keywords}>

  <!-- Google Analytics — Consent Mode v2.
       Consent defaults to DENIED and is only granted once the visitor accepts
       the cookie banner. This must run BEFORE the gtag.js tag loads, otherwise
       a page_view is sent before the visitor has chosen — which is what the
       banner previously implied was not happening. -->
  <script is:inline nonce={nonce}>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}

    var uwConsent = null;
    try { uwConsent = localStorage.getItem('uw-cookie-consent'); } catch (e) {}
    var uwGranted = uwConsent === 'accepted' ? 'granted' : 'denied';

    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': uwGranted,
      'functionality_storage': 'granted',
      'security_storage': 'granted',
      'wait_for_update': 500
    });

    gtag('js', new Date());
    // send_page_view is suppressed until consent is granted; uwTrack() below
    // fires the page_view once the visitor accepts.
    gtag('config', 'G-YZG3QCH600', { 'send_page_view': uwConsent === 'accepted' });
  </script>
  <script is:inline nonce={nonce} async src="https://www.googletagmanager.com/gtag/js?id=G-YZG3QCH600"></script>

  <!-- Structured Data -->
  {schemaArray.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)}></script>
  ))}

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title="Underwings Blog" href="/rss.xml">

  <!-- Calendly stylesheet — loaded non-blocking.
       The widget is never above the fold, so a render-blocking third-party
       stylesheet in <head> delayed first paint on all pages for nothing.
       media="print" makes the browser fetch it at low priority without
       blocking paint; the nonced script below promotes it to media="all"
       once it lands. An inline onload= attribute cannot do the swap here —
       the CSP sets script-src without 'unsafe-inline', so inline event
       handlers are blocked. -->
  <link
    id="uw-calendly-css"
    href="https://assets.calendly.com/assets/external/widget.css"
    rel="stylesheet"
    media="print"
  >
  <script is:inline nonce={nonce}>
    (function() {
      var l = document.getElementById('uw-calendly-css');
      if (!l) return;
      var apply = function() { l.media = 'all'; };
      if (l.sheet) apply(); else l.addEventListener('load', apply, { once: true });
    })();
  </script>
  <noscript>
    <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet">
  </noscript>

  <!-- DNS Prefetch -->
  <link rel="dns-prefetch" href="//assets.calendly.com">
  <link rel="preconnect" href="https://assets.calendly.com" crossorigin>
  <link rel="dns-prefetch" href="//d3e54v103j8qbb.cloudfront.net">
  <link rel="dns-prefetch" href="//cdn.prod.website-files.com">
  <link rel="preconnect" href="https://d3e54v103j8qbb.cloudfront.net" crossorigin>
  <link rel="preconnect" href="https://cdn.prod.website-files.com" crossorigin>

  <!-- Font Preloads -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-400.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-600.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/fonts/geist-mono-400.woff2" crossorigin>
  <link rel="preload" as="script" href="/js/webflow.js">

  <!-- Styles -->
  <link href="/css/normalize.css" rel="stylesheet" type="text/css">
  <link href="/css/webflow.css" rel="stylesheet" type="text/css">
  <link href="/css/underwings-org.webflow.css" rel="stylesheet" type="text/css">

  <style is:global>
    /* Smooth Scroll */
    html {
      scroll-behavior: smooth;
    }

    /* Pill labels must hug their content, never stretch to parent width.
       Webflow's base .label rule omits a display value, so <div class="label">
       defaults to block and spans the full row in flex/grid columns. */
    .label {
      display: inline-flex;
      align-items: center;
      width: -moz-fit-content;
      width: fit-content;
      max-width: 100%;
    }

    /* Button reset for .button-hidden overlay (allows <button> to replace <a href="#"> for Calendly triggers) */
    button.button-hidden {
      background: none;
      border: none;
      font: inherit;
      color: inherit;
      cursor: pointer;
      padding: 0;
    }

    /* Header secondary button — match .button size */
    .header-btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 1.5rem 1.25rem;
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 0.5rem;
      color: #fff;
      font-size: 0.875rem;
      font-weight: 500;
      font-family: inherit;
      text-decoration: none;
      white-space: nowrap;
      transition: border-color 0.25s ease, background 0.25s ease, color 0.25s ease;
    }
    .header-btn-secondary:hover {
      border-color: #24d758;
      color: #24d758;
      background: rgba(36,215,88,0.05);
    }

    /* Calendly mobile nav link */
    .header-calendly-btn-mobile {
      display: none;
    }
    @media (max-width: 991px) {
      .header-btn-secondary { display: none; }
      .header-calendly-btn-mobile {
        display: block;
      }
      /* Mobile navbar: logo + hamburger only */
      .header-cta-button {
        display: none !important;
      }
      .navbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
    }

    /* Global Readability */
    body {
      font-size: 1.0625rem;
      line-height: 1.5;
    }
    .text {
      font-size: 1.0625rem;
      line-height: 1.6;
    }
    /* Semantic monospace — replaces <code> used purely for styling */
    .mono {
      font-family: ui-monospace, "JetBrains Mono", Menlo, Consolas, monospace;
    }
    .text-medium {
      font-size: 1.1rem;
      line-height: 1.65;
    }
    .text-small {
      font-size: 0.9rem;
      line-height: 1.5;
    }
    .heading-small {
      font-size: 1.85rem;
      line-height: 1.15;
    }
    .color-grey, .text-medium.color-grey {
      color: rgba(255, 255, 255, 0.7);
    }

    /* Skip to Content */
    .skip-to-content {
      position: absolute;
      top: -100%;
      left: 50%;
      transform: translateX(-50%);
      z-index: 9999;
      padding: 0.75rem 1.5rem;
      background: #24d758;
      color: #000;
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 0 0 8px 8px;
      text-decoration: none;
      transition: top 0.2s;
    }
    .skip-to-content:focus {
      top: 0;
    }
    /* Navigation Dropdown Styles */
    .nav-dropdown {
      position: relative;
      display: inline-block;
    }
    .nav-chevron {
      display: inline-block;
      margin-left: 3px;
      vertical-align: middle;
      transition: transform 0.25s ease;
    }
    .nav-dropdown:hover .nav-chevron,
    .nav-dropdown:focus-within .nav-chevron {
      transform: rotate(180deg);
    }

    /* Mega dropdown */
    .nav-mega-content {
      display: none;
      position: absolute;
      top: calc(100% + 0.5rem);
      left: 50%;
      transform: translateX(-50%);
      background: rgba(20, 20, 20, 0.98);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px;
      padding: 0.5rem;
      min-width: 300px;
      box-shadow: 0 12px 40px rgba(0,0,0,0.5);
      z-index: 1000;
      backdrop-filter: blur(12px);
    }
    /* Invisible bridge to cover the gap between trigger and dropdown */
    .nav-mega-content::before {
      content: '';
      position: absolute;
      top: -0.5rem;
      left: 0;
      right: 0;
      height: 0.5rem;
    }
    .nav-dropdown:hover .nav-mega-content,
    .nav-dropdown:focus-within .nav-mega-content {
      display: block;
    }
    .nav-mega-item {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.75rem 0.85rem;
      color: #fff;
      text-decoration: none;
      border-radius: 8px;
      transition: background 0.2s ease;
    }
    .nav-mega-item:hover {
      background: rgba(255,255,255,0.05);
    }
    .nav-mega-icon {
      color: #24d758;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .nav-mega-title {
      display: block;
      font-size: 0.875rem;
      font-weight: 600;
      color: #fff;
      line-height: 1;
      margin-bottom: 0.3rem;
    }
    .nav-mega-desc {
      display: block;
      font-size: 0.725rem;
      color: rgba(255,255,255,0.65);
      line-height: 1.35;
    }
    .nav-mega-item:hover .nav-mega-title {
      color: #24d758;
    }

    /* Mobile mega dropdown — desktop only styles kept */
    @media screen and (max-width: 991px) {
      .nav-dropdown { display: block; }
      .nav-chevron { display: none; }
    }

    .coming-soon-badge {
      font-size: 0.65rem;
      padding: 0.2rem 0.5rem;
      background: linear-gradient(135deg, #24d758, #27dab4);
      color: #000;
      border-radius: 4px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    /* Partners Section Styles */
    .partners-section {
      animation: fadeInUp 0.8s ease-out forwards;
      animation-delay: 0.5s;
    }
    .partners-section a {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .partners-section a img {
      max-width: 120px;
      object-fit: contain;
    }
    @keyframes fadeInUp {
      from { opacity: 0; filter: blur(3px); transform: translateY(20px); }
      to { opacity: 1; filter: blur(0); transform: translateY(0); }
    }
    @media (max-width: 768px) {
      .partners-section a img {
        height: 24px !important;
      }
    }

    /* Compact section spacing for service pages */
    .svc-compact .section {
      padding-top: 4.5rem;
      padding-bottom: 4.5rem;
    }
    .svc-compact .hero-section {
      padding-top: 7.5rem;
      padding-bottom: 4.5rem;
    }
    @media screen and (min-width: 1280px) {
      .svc-compact .section {
        padding-top: 5.5rem;
        padding-bottom: 5.5rem;
      }
      .svc-compact .hero-section {
        padding-top: 9rem;
        padding-bottom: 5.5rem;
      }
    }

    /* Lead Magnet Component */
    .lead-magnet {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      padding: 2rem 2.5rem;
      border: 1px solid rgba(36,215,88,0.2);
      border-radius: 14px;
      background: rgba(36,215,88,0.04);
      max-width: 900px;
      margin: 0 auto;
    }
    .lead-magnet-icon {
      color: #24d758;
      flex-shrink: 0;
      width: 56px;
      height: 56px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(36,215,88,0.1);
      border: 1px solid rgba(36,215,88,0.25);
      border-radius: 12px;
    }
    .lead-magnet-content { flex: 1; min-width: 0; }
    .lead-magnet-title {
      font-size: 1.15rem;
      font-weight: 600;
      color: #fff;
      margin-bottom: 0.4rem;
    }
    .lead-magnet-desc {
      font-size: 0.85rem;
      color: rgba(255,255,255,0.6);
      line-height: 1.6;
      margin-bottom: 0;
    }
    .lead-magnet-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem;
      margin-top: 0.75rem;
    }
    .lead-magnet-tags span {
      font-size: 0.65rem;
      padding: 0.2rem 0.5rem;
      background: rgba(36,215,88,0.1);
      border: 1px solid rgba(36,215,88,0.25);
      border-radius: 4px;
      color: #24d758;
      font-weight: 500;
      letter-spacing: 0.2px;
    }
    .lead-magnet-form {
      flex-shrink: 0;
      width: 240px;
      display: flex;
      flex-direction: column;
      gap: 0;
    }
    .lead-magnet-input {
      width: 100%;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.15);
      border-radius: 8px 8px 0 0;
      padding: 0.7rem 0.85rem;
      color: #fff;
      font-size: 0.825rem;
      font-family: inherit;
      outline: none;
      transition: border-color 0.2s;
      box-sizing: border-box;
    }
    .lead-magnet-input::placeholder { color: rgba(255,255,255,0.3); }
    .lead-magnet-input:focus { border-color: rgba(36,215,88,0.5); }
    .lead-magnet-btn {
      width: 100%;
      background: #24d758;
      border: none;
      border-radius: 0 0 8px 8px;
      padding: 0.65rem;
      color: #000;
      font-size: 0.85rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: background 0.2s;
    }
    .lead-magnet-btn:hover { background: #1db84a; }
    .lead-magnet-btn:disabled { opacity: 0.7; cursor: not-allowed; }
    .lm-msg {
      font-size: 0.75rem;
      margin-top: 0.4rem;
      line-height: 1.4;
    }
    .lm-success { color: #24d758; }
    .lm-error { color: #ff4444; }
    .lm-privacy {
      font-size: 0.65rem;
      color: rgba(255,255,255,0.3);
      margin: 0.3rem 0 0;
      text-align: center;
    }
    @media (max-width: 768px) {
      .lead-magnet {
        flex-direction: column;
        padding: 1.5rem;
        text-align: center;
      }
      .lead-magnet-icon { margin: 0 auto; }
      .lead-magnet-tags { justify-content: center; }
      .lead-magnet-form { width: 100%; }
    }

    /* ARIA Invalid State */
    [aria-invalid="true"] {
      border-color: #ff4444 !important;
      box-shadow: 0 0 0 1px rgba(255,68,68,0.3);
    }

    /* Focus Visible Styles */
    :focus-visible {
      outline: 2px solid #24d758;
      outline-offset: 2px;
    }
    .nav-link:focus-visible,
    .nav-mega-item:focus-visible {
      outline: 2px solid #24d758;
      outline-offset: 2px;
      border-radius: 4px;
    }
    .button-hidden:focus-visible {
      outline: 2px solid #24d758;
      outline-offset: 4px;
      border-radius: 4px;
    }
    button.button-hidden {
      background: none;
      border: none;
      padding: 0;
      margin: 0;
      cursor: pointer;
      font: inherit;
    }

    /* Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }

    /* ============================================================
       COMPREHENSIVE MOBILE RESPONSIVE
       Fills gaps left by Webflow-generated CSS across all sections
    ============================================================ */

    /* ── 991px: tablet ───────────────────────────────────────── */
    @media (max-width: 991px) {
      /* base type */
      body          { font-size: 1rem; }
      .text         { font-size: 1rem; line-height: 1.6; }
      .text-medium  { font-size: 1rem; line-height: 1.6; }
      .text-small   { font-size: 0.875rem; }
      .heading-small{ font-size: 1.6rem; line-height: 1.2; }

      /* sections — reduce vertical breathing room */
      .section {
        padding-top: var(--sizes--padding-large, 4rem);
        padding-bottom: var(--sizes--padding-large, 4rem);
      }

      /* hero stats row */
      .hero-stats {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1rem 1.5rem;
      }
      .hero-stat-divider { display: none; }
      .hero-stat { text-align: center; min-width: 120px; }

      /* buttons — full-width on mobile */
      .hero-cta-mobile-button .button,
      .hero-cta-mobile-button .button-hidden { width: 100%; max-width: 320px; }

      /* section-wrapper gaps */
      .section-wrapper         { gap: 2.5rem; }
      .section-wrapper-vertical{ gap: 2rem; }

      /* footer newsletter stacks */
      .footer-newsletter-inner { flex-direction: column; gap: 1.5rem; }
      .footer-newsletter-form  { max-width: 100%; width: 100%; }

      /* footer top grid → 2 col */
      .footer-top-content-grid {
        grid-template-columns: 1fr 1fr !important;
        grid-template-rows: auto auto;
      }
      /* footer 3-col nav grid → 2+1 */
      .footer-top-part.footer-top-part-grid {
        grid-template-columns: 1fr 1fr !important;
      }
    }

    /* ── 767px: mobile ───────────────────────────────────────── */
    @media (max-width: 767px) {
      /* type scale */
      body          { font-size: 0.9375rem; }
      .text         { font-size: 0.9375rem; line-height: 1.65; }
      .text-medium  { font-size: 0.9375rem; line-height: 1.65; }
      .heading      { font-size: 2rem !important; line-height: 1.15; }
      .heading-large{ font-size: 2.4rem !important; line-height: 1.1; }
      .heading-small{ font-size: 1.45rem; line-height: 1.2; }

      /* section vertical padding */
      .section { padding-top: 3.5rem !important; padding-bottom: 3.5rem !important; }
      .section.top-padding-small    { padding-top: 2rem !important; }
      .section.bottom-padding-clear { padding-bottom: 0 !important; }
      .section.bottom-padding-small { padding-bottom: 1.5rem !important; }

      /* heading wrapper */
      .heading-wrapper { padding-top: 1.25rem; }

      /* container side gutters */
      .container-medium,
      .container { padding-left: 1.25rem !important; padding-right: 1.25rem !important; }

      /* hero heading gap */
      .hero-heading-wrapper { gap: 1.25rem; }
      .hero-main-wrapper    { gap: 1.75rem; }

      /* hero stats */
      .hero-stats { gap: 0.75rem 1.25rem; }
      .hero-stat-num   { font-size: 1.1rem; }
      .hero-stat-label { font-size: 0.75rem; }

      /* VAPT homepage cards */
      .vapt-hp-top {
        flex-direction: column !important;
        gap: 1rem;
      }
      .vapt-hp-top-left,
      .vapt-hp-top-right { width: 100% !important; }
      .vapt-hp-bottom {
        flex-direction: column !important;
        gap: 1rem;
      }
      .vapt-hp-card { width: 100% !important; }

      /* vertical heading padding (cube section) */
      .vertical-heading-cube-padding {
        padding-top: 45vw !important;
        padding-bottom: 80vw !important;
      }

      /* footer top grid → full single column */
      .footer-top-content-grid {
        grid-template-columns: 1fr !important;
      }
      .footer-top-part.footer-top-part-grid {
        grid-template-columns: 1fr 1fr !important;
      }

      /* footer newsletter */
      .footer-newsletter { padding: 2rem 0; }
      .footer-newsletter-heading { font-size: 1rem; }
      .footer-newsletter-desc    { font-size: 0.78rem; }
      .nl-what-you-get { flex-wrap: wrap; gap: 0.35rem; }
      .nl-what-you-get span { font-size: 0.65rem; padding: 0.2rem 0.45rem; }

      /* footer bottom */
      .footer-bottom-content-grid {
        grid-template-columns: 1fr !important;
        text-align: center;
      }
      .copy-text { font-size: 0.8rem; }

      /* buttons */
      .button         { width: 100%; max-width: 320px; }
      .button-hidden  { font-size: 0.875rem; }
      .button-wrapper { padding: 0.75rem 1.25rem; }

      /* lead magnet */
      .lead-magnet { padding: 1.25rem; gap: 1.25rem; }
      .lead-magnet-title { font-size: 1rem; }

      /* section-wrapper gaps */
      .section-wrapper         { gap: 2rem !important; }
      .section-wrapper-vertical{ gap: 1.75rem !important; }
    }

    /* ── 479px: small phones ─────────────────────────────────── */
    @media (max-width: 479px) {
      /* type */
      body          { font-size: 0.9rem; }
      .text         { font-size: 0.9rem; }
      .text-medium  { font-size: 0.9rem; line-height: 1.6; }
      .text-small   { font-size: 0.8rem; }
      .heading      { font-size: 1.75rem !important; }
      .heading-large{ font-size: 2rem !important; line-height: 1.1; }
      .heading-small{ font-size: 1.3rem; }
      code.code, .mono.code { font-size: 0.85em; }

      /* section padding */
      .section { padding-top: 2.75rem !important; padding-bottom: 2.75rem !important; }
      .section.top-padding-small { padding-top: 1.5rem !important; }

      /* container gutters */
      .container-medium,
      .container { padding-left: 1rem !important; padding-right: 1rem !important; }

      /* hero heading */
      .hero-heading-wrapper { gap: 1rem; }
      .hero-main-wrapper    { gap: 1.25rem; }

      /* hero stats — stack vertically on very small screens */
      .hero-stats {
        flex-direction: row;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        justify-content: center;
      }
      .hero-stat  { min-width: 100px; }
      .hero-stat-num   { font-size: 1rem; }
      .hero-stat-label { font-size: 0.7rem; }

      /* neon line box */
      .neon-line-box { width: 60% !important; }

      /* cube vertical heading padding */
      .vertical-heading-cube-padding {
        padding-top: 55vw !important;
        padding-bottom: 90vw !important;
      }

      /* footer nav 3-col → 1-col on tiny */
      .footer-top-part.footer-top-part-grid {
        grid-template-columns: 1fr !important;
      }
      .footer-nav-list { margin-bottom: 1.25rem; }
      .footer-nav-link { font-size: 0.875rem; padding: 0.2rem 0; }

      /* footer newsletter form */
      .footer-newsletter-input-wrap { flex-direction: column; border-radius: 8px; }
      .footer-newsletter-input-wrap input {
        border-radius: 8px 8px 0 0;
        border-bottom: 1px solid rgba(255,255,255,0.08) !important;
        padding: 0.7rem 0.875rem;
      }
      .footer-newsletter-btn {
        border-radius: 0 0 8px 8px !important;
        width: 100%;
        padding: 0.7rem;
        font-size: 0.85rem;
      }

      /* back-to-top */
      .link-to-top { width: 2rem; height: 2rem; }

      /* section-wrapper gaps */
      .section-wrapper          { gap: 1.5rem !important; }
      .section-wrapper-vertical { gap: 1.5rem !important; }

      /* partners logos */
      .partners-section a img { height: 20px !important; }

      /* blog cards — single column */
      .blog-grid,
      [class*="blog-grid"],
      [class*="cards-grid"] {
        grid-template-columns: 1fr !important;
      }

      /* lead magnet */
      .lead-magnet { padding: 1rem; }
      .lead-magnet-form { width: 100%; }
      .lead-magnet-icon { width: 44px !important; height: 44px !important; }
    }

    /* ── 360px: very small (Galaxy A, old iPhones) ───────────── */
    @media (max-width: 360px) {
      body { font-size: 0.875rem; }
      .heading       { font-size: 1.6rem !important; }
      .heading-large { font-size: 1.8rem !important; }
      .heading-small { font-size: 1.2rem; }

      .section { padding-top: 2.25rem !important; padding-bottom: 2.25rem !important; }

      .container-medium,
      .container { padding-left: 0.875rem !important; padding-right: 0.875rem !important; }

      .hero-stats { gap: 0.4rem 0.75rem; }
      .hero-stat  { min-width: 90px; }

      /* buttons */
      .button-wrapper { padding: 0.65rem 1rem; }
      .button-text    { font-size: 0.825rem; }

      /* footer */
      .footer-newsletter-heading { font-size: 0.95rem; }
      .copy-text { font-size: 0.75rem; }
    }
  </style>

