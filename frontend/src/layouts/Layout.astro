  <script is:inline nonce={nonce}>
  (function() {
    var popup = document.getElementById('uw-exit-popup');
    var closeBtn = document.getElementById('uw-exit-close');
    var backdrop = document.getElementById('uw-exit-backdrop-overlay');
    var form = document.getElementById('uw-exit-form');
    var shown = false;
    var STORAGE_KEY = 'uw-exit-popup-shown';

    // Don't show if already shown or dismissed
    if (sessionStorage.getItem(STORAGE_KEY) || localStorage.getItem(STORAGE_KEY)) return;

    // Wait 15s minimum before showing
    var minTime = Date.now() + 15000;

    function showPopup() {
      if (shown || Date.now() < minTime) return;
      shown = true;
      popup.style.display = 'flex';
      sessionStorage.setItem(STORAGE_KEY, '1');
    }

    function closePopup() {
      popup.style.display = 'none';
      localStorage.setItem(STORAGE_KEY, '1');
    }

    // Exit intent: mouse leaves viewport from top
    document.addEventListener('mouseout', function(e) {
      if (e.clientY <= 0 && !shown) showPopup();
    });

    // Mobile: detect back/tab switch via visibilitychange (subtle approach)
    // Skipped to avoid being annoying on mobile

    closeBtn.addEventListener('click', closePopup);
    backdrop.addEventListener('click', closePopup);
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && shown && popup.style.display === 'flex') closePopup();
    });

    // Form submission
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = document.getElementById('uw-exit-email').value.trim();
      if (!email) return;
      var btn = document.getElementById('uw-exit-btn');
      var textEl = btn.querySelector('.uw-exit-btn-text');
      var loadEl = btn.querySelector('.uw-exit-btn-loading');
      textEl.style.display = 'none';
      loadEl.style.display = 'inline';
      btn.disabled = true;

      fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: email, lead_magnet: 'Security Assessment Checklist' })
      })
      .then(function(res) {
        if (res.ok) {
          document.getElementById('uw-exit-success').style.display = 'block';
          document.getElementById('uw-exit-error').style.display = 'none';
          form.querySelector('#uw-exit-email').value = '';
          localStorage.setItem(STORAGE_KEY, '1');
        } else { throw new Error('fail'); }
      })
      .catch(function() {
        document.getElementById('uw-exit-error').style.display = 'block';
      })
      .finally(function() {
        textEl.style.display = '';
        loadEl.style.display = 'none';
        btn.disabled = false;
      });
    });
  })();
  </script>

  <!-- ═══════════════════════════════════════════════════
       CONVERSION TRACKING
       Every lead path on the site emits a GA4 event so pipeline can be
       attributed to a page. Delegated from document, so it covers elements
       added later (chat, exit-intent) without re-binding.

       Consent Mode v2 governs storage: events raised before the visitor
       accepts are not stored by GA4, so this is safe to run unconditionally.

       Mark as key events in GA4 Admin → Events:
         book_call_click · contact_form_submit · whatsapp_click
       ═══════════════════════════════════════════════════ -->
  <script is:inline nonce={nonce}>
  (function() {
    function track(name, params) {
      if (typeof gtag !== 'function') return;
      var p = params || {};
      p.page_path = location.pathname;
      gtag('event', name, p);
    }

    // ── Click paths ────────────────────────────────────────────────
    document.addEventListener('click', function(e) {
      var el = e.target && e.target.closest ? e.target.closest('a, button, [data-calendly-open]') : null;
      if (!el) return;

      if (el.hasAttribute('data-calendly-open')) {
        track('book_call_click', { method: 'calendly', label: (el.textContent || '').trim().slice(0, 60) });
        return;
      }

      var href = el.getAttribute('href') || '';
      if (href.indexOf('https://wa.me/') === 0) {
        track('whatsapp_click', { label: (el.textContent || '').trim().slice(0, 60) });
      } else if (href.indexOf('mailto:') === 0) {
        track('email_click', { label: href.replace('mailto:', '').split('?')[0] });
      } else if (href.indexOf('tel:') === 0) {
        track('phone_click', { label: href.replace('tel:', '') });
      }
    }, true);

    // ── Form submissions ───────────────────────────────────────────
    var chatCounted = false;
    document.addEventListener('submit', function(e) {
      var f = e.target;
      if (!f || f.nodeName !== 'FORM') return;

      if (f.id === 'contact-form') {
        var svc = f.querySelector('[name="service"], #service, select');
        track('contact_form_submit', { service: svc && svc.value ? svc.value : 'unspecified' });

      } else if (f.id === 'newsletter-form') {
        track('newsletter_signup', { location: 'footer' });

      } else if (f.id === 'uw-exit-form') {
        track('lead_magnet_download', { asset: 'security-assessment-checklist' });

      } else if (f.hasAttribute('data-waitlist-form')) {
        track('waitlist_signup', {
          service: f.getAttribute('data-service-slug') || 'unknown',
          launch_year: f.getAttribute('data-service-year') || ''
        });

      } else if (f.id === 'uw-chat-form') {
        // Count engagement once per session, not per message.
        if (!chatCounted) { chatCounted = true; track('ai_chat_engaged', {}); }
      }
    }, true);
  })();
  </script>

  <!-- Link prefetching.
       Astro's built-in prefetch injects a script tag it cannot nonce, which
       'strict-dynamic' then blocks — so it is disabled in astro.config.mjs and
       replaced here with a nonced equivalent. Prefetches an internal page on
       hover/touch intent, once per URL. -->
  <script is:inline nonce={nonce}>
  (function() {
    if (!('connection' in navigator) || !navigator.connection.saveData) {
      var seen = {};
      var warm = function(e) {
        var a = e.target && e.target.closest ? e.target.closest('a') : null;
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (href.charAt(0) !== '/' || href.indexOf('//') === 0) return;
        if (a.hasAttribute('download') || a.getAttribute('target') === '_blank') return;
        if (seen[href]) return;
        seen[href] = 1;
        var l = document.createElement('link');
        l.rel = 'prefetch';
        l.href = href;
        document.head.appendChild(l);
      };
      document.addEventListener('mouseover', warm, { passive: true });
      document.addEventListener('touchstart', warm, { passive: true });
    }
  })();
  </script>
</body>
</html>
