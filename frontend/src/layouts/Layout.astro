  <style is:inline>
    #uw-chat-widget { position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9999; font-family: 'Geist', sans-serif; }

    /* Main FAB button */
    #uw-fab-toggle {
      width: 56px; height: 56px; border-radius: 50%; border: none;
      background: linear-gradient(135deg, #24d758, #1db84a); color: #fff;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      box-shadow: 0 4px 20px rgba(36,215,88,0.4);
      transition: transform 0.3s cubic-bezier(0.4,0,0.2,1), box-shadow 0.3s;
      position: relative; z-index: 3;
    }
    #uw-fab-toggle:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(36,215,88,0.5); }
    #uw-fab-toggle[aria-expanded="true"] { transform: rotate(0deg); }

    /* FAB options container */
    #uw-fab-options {
      position: absolute; bottom: 68px; right: 0;
      display: flex; flex-direction: column; align-items: flex-end; gap: 12px;
    }

    /* Individual option row */
    .uw-fab-option {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none; border: none; background: none;
      cursor: pointer; padding: 0; font-family: inherit;
      opacity: 0; transform: translateY(12px) scale(0.9);
      transition: opacity 0.25s cubic-bezier(0.4,0,0.2,1), transform 0.25s cubic-bezier(0.4,0,0.2,1);
    }
    .uw-fab-option.is-visible {
      opacity: 1; transform: translateY(0) scale(1);
    }

    /* Option label tooltip */
    .uw-fab-label {
      padding: 6px 12px; border-radius: 8px;
      background: rgba(20,20,20,0.95); color: #fff;
      font-size: 0.8rem; font-weight: 500; white-space: nowrap;
      box-shadow: 0 4px 16px rgba(0,0,0,0.4);
      border: 1px solid rgba(255,255,255,0.08);
      pointer-events: none;
      opacity: 0; transform: translateX(8px);
      transition: opacity 0.2s, transform 0.2s;
    }
    .uw-fab-option:hover .uw-fab-label {
      opacity: 1; transform: translateX(0);
    }

    /* Option icon circle */
    .uw-fab-option-icon {
      width: 46px; height: 46px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      transition: transform 0.2s, box-shadow 0.2s;
      flex-shrink: 0;
    }
    .uw-fab-option:hover .uw-fab-option-icon {
      transform: scale(1.1);
    }

    /* WhatsApp icon */
    .uw-fab-wa {
      background: #25D366; color: #fff;
      box-shadow: 0 3px 12px rgba(37,211,102,0.4);
    }
    .uw-fab-option:hover .uw-fab-wa {
      box-shadow: 0 4px 18px rgba(37,211,102,0.55);
    }

    /* AI Chat icon */
    .uw-fab-ai-icon {
      background: #141414; color: #24d758;
      border: 1.5px solid rgba(36,215,88,0.4);
      box-shadow: 0 3px 12px rgba(36,215,88,0.2);
    }
    .uw-fab-option:hover .uw-fab-ai-icon {
      box-shadow: 0 4px 18px rgba(36,215,88,0.4);
      border-color: rgba(36,215,88,0.7);
    }

    /* Backdrop overlay when FAB is open */
    #uw-fab-backdrop {
      display: none; position: fixed; inset: 0; z-index: 9998;
    }
    #uw-chat-panel {
      position: absolute; bottom: 72px; right: 0;
      width: 370px; max-height: 520px; border-radius: 16px;
      background: #141414; border: 1px solid rgba(255,255,255,0.1);
      box-shadow: 0 12px 48px rgba(0,0,0,0.6); display: flex; flex-direction: column;
      overflow: hidden; animation: uwChatIn 0.25s ease-out;
    }
    @keyframes uwChatIn { from { opacity: 0; transform: translateY(10px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
    #uw-chat-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 1rem 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.03);
    }
    #uw-chat-header-left { display: flex; align-items: center; gap: 0.6rem; }
    #uw-chat-avatar {
      width: 32px; height: 32px; border-radius: 8px; object-fit: cover;
    }
