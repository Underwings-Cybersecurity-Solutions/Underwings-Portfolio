  .privacy-content .pp-table th { color: #24d758; font-weight: 600; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; border-bottom: 1px solid rgba(36,215,88,0.35); }
  .privacy-content .pp-table td:first-child { color: #fff; }
