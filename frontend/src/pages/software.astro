                <strong>quoted in AED within 24 hours</strong>, configured by named engineers,
                supported locally. No shelfware, no vendor handoffs.
              </p>
            </div>

            <!-- Dual CTA -->
            <div class="sw-hero-cta-row sw-hero-fade" style="animation-delay: 0.55s">
              <a href="/#contact?intent=software-quote" class="sw-hero-btn sw-hero-btn-primary">
                <span>Get a 24-hour quote</span>
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M1.5 7.5h12M8 2l5.5 5.5L8 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="https://wa.me/971505670394?text=Hi%2C%20I%27d%20like%20a%20quote%20for%20security%20software"
                 target="_blank" rel="noopener"
                 class="sw-hero-btn sw-hero-btn-secondary"
                 aria-label="Open WhatsApp chat for a software quote">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.464 3.488"/>
                </svg>
                <span>WhatsApp us</span>
              </a>
            </div>

            <!-- Microtrust row -->
            <p class="sw-hero-microtrust-row sw-hero-fade" style="animation-delay: 0.7s">
              <span>Quoted in AED</span>
              <span class="sw-hero-microtrust-dot" aria-hidden="true">·</span>
              <span>Vendor-neutral advice</span>
              <span class="sw-hero-microtrust-dot" aria-hidden="true">·</span>
              <span>Local UAE delivery &amp; support</span>
            </p>

            <!-- Stats strip with count-up -->
            <div class="sw-hero-stats sw-hero-fade" style="animation-delay: 0.85s">
              <div class="sw-hero-stat">
                <span class="sw-hero-stat-num" data-target="24" data-suffix="h">24h</span>
                <span class="sw-hero-stat-label">Quote Turnaround</span>
              </div>
              <div class="sw-hero-stat">
                <span class="sw-hero-stat-num" data-target="10" data-suffix="+">10+</span>
                <span class="sw-hero-stat-label">Vendor Categories</span>
              </div>
              <div class="sw-hero-stat">
                <span class="sw-hero-stat-num" data-target="90" data-suffix="d">90d</span>
                <span class="sw-hero-stat-label">Post-Go-Live Support</span>
              </div>
              <div class="sw-hero-stat">
                <span class="sw-hero-stat-num" data-target="0" data-suffix="" data-text="AED">AED</span>
                <span class="sw-hero-stat-label">All Pricing</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Hero JS — typewriter rotator + stat count-up -->
    <script is:inline nonce={Astro.locals.nonce || ""}>
    (function () {
      function init() {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        var rotator = document.querySelector('.sw-hero-rotator-word[data-rotate]');
        var wrap    = document.querySelector('.sw-hero-rotator');
        if (!reduce && rotator && wrap) {
          var words;
          try { words = JSON.parse(rotator.getAttribute('data-rotate')); } catch (e) { words = []; }
          if (words.length > 1) {
            rotator.textContent = '';
            var wordIdx = 0, charIdx = 0, deleting = false;
            var TYPE_MIN = 55, TYPE_MAX = 110, DELETE_SPEED = 32, HOLD_FULL = 1400, HOLD_EMPTY = 240;
            function setState(s) {
              wrap.classList.remove('is-typing', 'is-deleting');
              if (s) wrap.classList.add(s);
            }
            function tick() {
              var word = words[wordIdx];
              if (!deleting) {
                setState('is-typing');
                charIdx++;
                rotator.textContent = word.slice(0, charIdx);
                if (charIdx === word.length) {
                  setState(null); deleting = true;
                  return setTimeout(tick, HOLD_FULL);
                }
                var jitter = TYPE_MIN + Math.random() * (TYPE_MAX - TYPE_MIN);
                return setTimeout(tick, jitter);
              } else {
                setState('is-deleting');
                charIdx--;
                rotator.textContent = word.slice(0, charIdx);
                if (charIdx === 0) {
                  setState(null); deleting = false;
                  wordIdx = (wordIdx + 1) % words.length;
                  return setTimeout(tick, HOLD_EMPTY);
                }
                return setTimeout(tick, DELETE_SPEED);
              }
            }
            setTimeout(tick, 700);
          }
        }

        var hasIO = (typeof IntersectionObserver !== 'undefined');
        if (!reduce && hasIO) {
          var stats = document.querySelectorAll('.sw-hero-stat-num[data-target]');
          if (stats.length) {
            var animated = new WeakSet();
            var io = new IntersectionObserver(function (entries) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                var el = entry.target;
                if (animated.has(el)) return;
                animated.add(el);
                var textOverride = el.getAttribute('data-text');
                if (textOverride) {
                  el.textContent = textOverride;
                  return;
                }
                var target = parseInt(el.getAttribute('data-target'), 10) || 0;
                var suffix = el.getAttribute('data-suffix') || '';
                var dur = 1200, start = performance.now();
                function tick(now) {
                  var t = Math.min(1, (now - start) / dur);
                  var eased = 1 - Math.pow(1 - t, 3);
                  el.textContent = Math.round(target * eased) + suffix;
                  if (t < 1) requestAnimationFrame(tick);
                }
                requestAnimationFrame(tick);
              });
            }, { threshold: 0.4 });
            stats.forEach(function (s) { io.observe(s); });
          }
        } else {
          // Reduced-motion: set final values immediately
          document.querySelectorAll('.sw-hero-stat-num[data-target]').forEach(function (el) {
            var textOverride = el.getAttribute('data-text');
            if (textOverride) { el.textContent = textOverride; return; }
            var target = parseInt(el.getAttribute('data-target'), 10) || 0;
            el.textContent = target + (el.getAttribute('data-suffix') || '');
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
    </script>

    <!-- ============ WHY BUY THROUGH US ============ -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div class="sw-section-head">
          <div class="sw-label">
            <div class="text-small color-grey">Why Underwings</div>
          </div>
          <h2 class="heading heading-center" style="margin-top: 0.75rem;">
            More than a <span class="text-gradient-clip bg-color-green-gradient">reseller</span>
          </h2>
          <p class="sw-section-sub">
            A licence is the easy part. The value is in scoping it right, configuring it well, and being
            reachable when something breaks at 11pm.
          </p>
        </div>
        <div class="sw-benefits-grid">
          <div class="sw-benefit-card">
            <div class="sw-benefit-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><path d="M14 3v22M3 14h22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><rect x="6" y="6" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.5"/></svg>
            </div>
            <h3 class="heading-small sw-benefit-title">Expert deployment</h3>
            <p class="text-medium color-grey">Configured against vendor + CIS hardening guides from day one. Integrated with your AD, SIEM, and ticketing — not dropped on your IT team to figure out.</p>
          </div>
