---
// ===========================================
// SOFTWARE SALES PAGE
// Underwings Cybersecurity Solutions
// ===========================================

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PartnerLogos from '../components/PartnerLogos.astro';

// The Device Management and Compliance Automation cards in the category grid
// name their product (Hexnode, Sprinto) and link to a dedicated page, because
// those two are signed partnerships with an offer worth explaining. Every other
// card stays vendor-neutral and routes to the quote form. "UEM" was dropped from
// the IT Ops & Monitoring card so two cards don't both claim device management.

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Cybersecurity Software Sales & Implementation",
  "provider": {
    "@type": "Organization",
    "name": "Underwings Cybersecurity Solutions",
    "url": "https://underwings.org"
  },
  "description": "Cybersecurity software sales with full implementation, training, and ongoing support. Endpoint protection, SIEM, email security, network security, and more — quoted in AED and deployed by named engineers.",
  "areaServed": ["AE", "IN"],
  "serviceType": "Cybersecurity Software Sales & Implementation"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Software", "item": "https://underwings.org/software" }
  ]
};

// Mirrors the EXISTING visible FAQ section below (schema only — no content change).
const faqs = [
  { q: "Are you cheaper than buying directly from the vendor?", a: "For most products list price is the same. The difference is implementation, training and local support — vendors charge separately for those, or not at all. With us, deployment is bundled, support is local, and you get a single AED invoice instead of vendor billing in USD." },
  { q: "What happens if I want to switch vendors later?", a: "You own your licences and your data — we don't lock you in. We'll help you migrate cleanly even if it means moving you off a vendor we sell. Long-term trust matters more to us than one product's margin." },
  { q: "Do you support only the products you sell, or anything we already own?", a: "We can take over support for tools you already have across most major vendors and cloud-native platforms. Tell us what's in place — if we can't support it, we'll tell you upfront." },
  { q: "How fast can you actually deploy?", a: "EDR for under 100 endpoints: 3–5 working days. Email security: 2–4 days. SIEM rollout: 2–4 weeks depending on log sources. Full SMB stack: 4–6 weeks. We can move faster for incident-response situations." },
  { q: "Can I pay annually, monthly, or in instalments?", a: "Most licences are annual. Implementation fees can be split 50/50 (start / go-live) or 30/30/40 for larger projects. We invoice in AED with full VAT compliance." },
  { q: "What if we don't know what we need?", a: "That's the most common starting point. Book a free 30-minute scoping call — we'll ask about your environment, risks and compliance pressure, then send a written recommendation in AED within 24 hours. No obligation." },
];
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
};

export const prerender = false;
---

<Layout
  title="Cybersecurity Software UAE — Quoted & Deployed | Underwings"
  description="Endpoint, SIEM, email, firewall and cloud security software quoted in AED within 24 hours, deployed by named engineers, supported locally."
  keywords="cybersecurity software UAE, security software sales AED, EDR UAE, SIEM UAE, endpoint protection UAE, security software bundles, vendor neutral cybersecurity UAE"
  wfPage="software-page"
  schema={[serviceSchema, breadcrumbSchema, faqSchema]}
  bodyClass="body"
>

  <Fragment slot="head">
    <style is:inline>
      /* ───── Hero blur-fade in (staggered) ───── */
      .sw-hero-fade { animation: swHeroFadeIn 0.8s ease-out both; animation-delay: 0.5s; }
      @keyframes swHeroFadeIn {
        from { filter: blur(3px); opacity: 0; transform: translateY(1rem); }
        to   { filter: blur(0);   opacity: 1; transform: translateY(0); }
      }

      .sw-hero-wrap { position: relative; overflow: hidden; }
      .sw-hero-wrap .hero-heading-wrapper {
        display: flex; flex-direction: column; align-items: center; gap: 1.1rem;
      }
      .sw-hero-wrap .hero-heading-wrapper > * { margin: 0; }
      .sw-hero-wrap .heading-large.hero-heading-large {
        line-height: 1.05; letter-spacing: -0.035em;
      }

      /* Eyebrow pill with pulse */
      .sw-hero-eyebrow {
        display: inline-flex; align-items: center; gap: 0.55rem;
        padding: 0.4rem 0.95rem; border-radius: 100px;
        background: rgba(36,215,88,0.06);
        border: 1px solid rgba(36,215,88,0.22);
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: #24d758;
      }
      .sw-hero-pulse {
        width: 7px; height: 7px; border-radius: 50%; background: #24d758;
        box-shadow: 0 0 0 0 rgba(36,215,88,0.55);
        animation: swHeroPulse 2.2s ease-out infinite;
      }
      @keyframes swHeroPulse {
        0%   { box-shadow: 0 0 0 0 rgba(36,215,88,0.55); opacity: 1; }
        70%  { box-shadow: 0 0 0 10px rgba(36,215,88,0); opacity: 0.7; }
        100% { box-shadow: 0 0 0 0 rgba(36,215,88,0); opacity: 1; }
      }

      /* Typewriter rotator */
      .sw-hero-rotator {
        position: relative; display: inline-block;
        vertical-align: baseline; white-space: nowrap;
      }
      .sw-hero-rotator-word {
        display: inline-block;
        background: linear-gradient(90deg, #24d758 0%, #27dab4 100%);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent; color: transparent;
        transition: text-shadow 0.25s ease;
      }
      .sw-hero-rotator.is-typing .sw-hero-rotator-word,
      .sw-hero-rotator.is-deleting .sw-hero-rotator-word {
        text-shadow: 0 0 22px rgba(36,215,88,0.25);
      }
      .sw-hero-rotator-caret {
        display: inline-block; width: 2px; height: 0.95em;
        margin-left: 4px;
        background: linear-gradient(180deg, #24d758, #27dab4);
        vertical-align: -0.08em; border-radius: 2px;
        box-shadow: 0 0 10px rgba(36,215,88,0.6);
        animation: swHeroCaretBlink 0.9s ease-in-out infinite;
      }
      .sw-hero-rotator.is-typing .sw-hero-rotator-caret,
      .sw-hero-rotator.is-deleting .sw-hero-rotator-caret {
        animation: none; opacity: 1;
      }
      @keyframes swHeroCaretBlink {
        0%, 49%   { opacity: 1; }
        50%, 100% { opacity: 0.15; }
      }
      @media (max-width: 560px) {
        .sw-hero-rotator { white-space: normal; }
      }

      /* Dual CTA row */
      .sw-hero-cta-row {
        display: flex; gap: 0.75rem; justify-content: center;
        flex-wrap: wrap; margin-top: 1.75rem;
      }
      .sw-hero-btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.85rem 1.5rem; border-radius: 10px;
        font-size: 0.92rem; font-weight: 600; letter-spacing: -0.005em;
        text-decoration: none; border: 1px solid transparent; cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
        font-family: inherit;
      }
      .sw-hero-btn-primary {
        background: linear-gradient(135deg, #24d758, #27dab4); color: #0a0a0a;
        box-shadow: 0 4px 18px rgba(36,215,88,0.18);
      }
      .sw-hero-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(36,215,88,0.28); }
      .sw-hero-btn-secondary {
        background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.15);
      }
      .sw-hero-btn-secondary:hover { background: rgba(36,215,88,0.06); border-color: rgba(36,215,88,0.35); }
      .sw-hero-btn svg { transition: transform 0.2s ease; }
      .sw-hero-btn:hover svg { transform: translateX(3px); }

      /* Microtrust */
      .sw-hero-microtrust-row {
        display: flex; align-items: center; justify-content: center;
        gap: 0.55rem; margin: 1rem 0 0; font-size: 0.8rem;
        color: rgba(255,255,255,0.48); flex-wrap: wrap;
      }
      .sw-hero-microtrust-dot { color: rgba(255,255,255,0.2); }

      /* Stats strip */
      .sw-hero-stats {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 1rem; margin: 2.25rem auto 0; max-width: 780px;
        padding: 1.25rem 1.75rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; position: relative; overflow: hidden;
      }
      .sw-hero-stats::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse at top, rgba(36,215,88,0.06) 0%, transparent 65%);
        pointer-events: none;
      }
      .sw-hero-stat { display: flex; flex-direction: column; gap: 0.15rem; align-items: center; text-align: center; position: relative; z-index: 1; }
      .sw-hero-stat-num {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 1.35rem; font-weight: 700; color: #24d758;
        letter-spacing: -0.01em; font-variant-numeric: tabular-nums;
      }
      .sw-hero-stat-label {
        font-size: 0.7rem; color: rgba(255,255,255,0.5);
        text-transform: uppercase; letter-spacing: 0.08em;
      }
      @media (max-width: 720px) {
        .sw-hero-stats { grid-template-columns: repeat(2, 1fr); gap: 0.9rem 0.5rem; padding: 1rem; }
        .sw-hero-stat-num { font-size: 1.15rem; }
      }

      /* Animated grid + orb backdrop */
      .sw-hero-grid {
        position: absolute; inset: 0;
        background-image:
          linear-gradient(rgba(36,215,88,0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(36,215,88,0.045) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
        pointer-events: none; z-index: 0;
        animation: swHeroGridDrift 24s linear infinite;
      }
      @keyframes swHeroGridDrift {
        from { background-position: 0 0, 0 0; }
        to   { background-position: 56px 56px, 56px 56px; }
      }
      .sw-hero-orb {
        position: absolute; width: 520px; height: 520px;
        top: -180px; left: 50%; transform: translateX(-50%);
        background: radial-gradient(circle, rgba(36,215,88,0.08) 0%, rgba(36,215,88,0.02) 35%, transparent 65%);
        filter: blur(20px); pointer-events: none; z-index: 0;
        animation: swHeroOrbDrift 9s ease-in-out infinite;
      }
      @keyframes swHeroOrbDrift {
        0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.85; }
        50%      { transform: translateX(-50%) translateY(18px); opacity: 1; }
      }

      /* Vendor ribbon */
      .sw-hero-ribbon {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
        gap: 0.5rem; margin-top: 2.25rem; padding: 0 1rem;
        position: relative; z-index: 1;
      }
      .sw-hero-ribbon-label {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: rgba(255,255,255,0.4); margin-right: 0.5rem;
      }
      .sw-hero-chip {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.04em;
        padding: 0.35rem 0.7rem; border-radius: 6px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.7);
        transition: border-color 0.2s, color 0.2s, background 0.2s;
      }
      .sw-hero-chip:hover {
        border-color: rgba(36,215,88,0.35);
        color: #24d758;
        background: rgba(36,215,88,0.06);
      }

      @media (prefers-reduced-motion: reduce) {
        .sw-hero-fade, .sw-hero-pulse, .sw-hero-orb, .sw-hero-grid,
        .sw-hero-rotator-word, .sw-hero-rotator-caret {
          animation: none !important;
        }
        .sw-hero-fade { opacity: 1; filter: none; transform: none; }
      }
    </style>
  </Fragment>

  <Header currentPage="software" />

  <main id="main" class="main">

    <!-- ============ HERO ============ -->
    <section class="section bottom-padding-clear top-padding-small sw-hero-wrap">
      <div class="sw-hero-grid" aria-hidden="true"></div>
      <div class="sw-hero-orb" aria-hidden="true"></div>
      <div class="container-medium" style="position: relative; z-index: 1;">
        <div class="hero">
          <div class="hero-main-wrapper">

            <div class="hero-heading-wrapper">
              <span class="sw-hero-eyebrow sw-hero-fade">
                <span class="sw-hero-pulse" aria-hidden="true"></span>
                Software · Implementation · Support
              </span>

              <h1 class="heading-large hero-heading-large sw-hero-fade" style="animation-delay: 0.2s">
                Deployed &amp; supported<br><span class="sw-hero-rotator" aria-live="polite"><span class="sw-hero-rotator-word" data-rotate='["Endpoint Protection","SIEM &amp; Analytics","Email Security","Cloud Security","Network Defence","Vulnerability Management","Identity &amp; Access","Backup &amp; Recovery"]'>Endpoint Protection</span><span class="sw-hero-rotator-caret" aria-hidden="true"></span></span>
              </h1>

              <p class="text text-center sw-hero-fade" style="animation-delay: 0.4s; max-width:720px; margin:0 auto;">
