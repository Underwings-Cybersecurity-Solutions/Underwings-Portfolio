---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PartnerLogos from '../components/PartnerLogos.astro';

export const prerender = false;

const siteUrl = "https://underwings.org";
const orgId = `${siteUrl}/#organization`;

// Team — kept in sync with the rendered cards below. Powers Person nodes with
// credentials, the strongest E-E-A-T / "who is behind this" signal for Google
// and generative engines (ChatGPT / Perplexity / Gemini).
const team = [
  { name: "Manoj Prabhakaran", role: "Founder", founder: true,
    certs: ["CPTS", "CDSA", "CompTIA Security+", "Azure Cloud Security", "ISO/IEC 27001 Lead Auditor", "HTB Omniscient"] },
  { name: "Nelson Durairaj", role: "Senior Penetration Tester",
    certs: ["OSCP", "eJPT", "CEH", "HTB Omniscient"] },
  { name: "Vinoth Sivasamy", role: "Co-founder — Networking & Infrastructure", founder: true,
    certs: ["CCNP", "Fortinet NSE", "Six Sigma", "Microsoft Azure"] },
  { name: "Gowtham", role: "Chief Executive Officer", certs: [] },
  { name: "Guna", role: "Business Development Manager", certs: [] },
  { name: "Prathima Selvaraj", role: "Digital Marketing Manager", certs: [] },
];

const toPerson = (m) => ({
  "@type": "Person",
  "name": m.name,
  "jobTitle": m.role,
  "worksFor": { "@id": orgId },
  ...(m.certs.length ? {
    "hasCredential": m.certs.map((c) => ({
      "@type": "EducationalOccupationalCredential",
      "credentialCategory": "certification",
      "name": c,
    })),
  } : {}),
});

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
      { "@type": "ListItem", "position": 2, "name": "About", "item": `${siteUrl}/about` },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "ProfessionalService"],
    "@id": orgId,
    "name": "Underwings Cybersecurity Solutions",
    "alternateName": "Underwings",
    "url": siteUrl,
    "logo": `${siteUrl}/brand/logos/underwings-icon-green.png?v=2`,
    "image": `${siteUrl}/brand/og/og-default.png?v=2`,
    "description": "UAE-based cybersecurity company delivering penetration testing (VAPT), ISO 27001 / NESA / UAE PDPL compliance, cloud and network security, and security awareness training — by named, certified practitioners.",
    "foundingDate": "2026",
    "slogan": "Honest, practitioner-led cybersecurity for UAE businesses.",
    "email": "contact@underwings.org",
    "telephone": "+971 50 567 0394",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Abu Dhabi",
      "addressRegion": "Abu Dhabi",
      "addressCountry": "AE",
    },
    "areaServed": [
      { "@type": "Country", "name": "United Arab Emirates" },
      { "@type": "City", "name": "Abu Dhabi" },
      { "@type": "City", "name": "Dubai" },
    ],
    "sameAs": [
      "https://www.linkedin.com/company/underwings-cybersecurity",
      "https://www.instagram.com/underwings.uae",
    ],
    "founder": team.filter((m) => m.founder).map(toPerson),
    "employee": team.map(toPerson),
  },
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    "name": "About Underwings Cybersecurity Solutions",
    "url": `${siteUrl}/about`,
    "mainEntity": { "@id": orgId },
  },
];
---

<Layout
  title="About Underwings - Cybersecurity Company UAE"
  description="Underwings is a cybersecurity startup operating from UAE, providing security software sales, VAPT services, ISO 27001 implementation, and security training — built for growing businesses."
  keywords="Underwings Cybersecurity Solutions, cybersecurity company UAE, security consulting Abu Dhabi, about Underwings"
  wfPage="about-page"
  schema={schema}
>
  <Fragment slot="head">
    <style is:inline>
    /* Neon line sweep */
    .neon-line-animate { animation: neonFadeIn 0.8s ease-out 0.3s both; }
    .neon-line-animate .neon-line-parent { animation: neonColorIn 1s ease-out 0.6s both; }
    .neon-line-animate .neon-line-inner { transform: translate3d(-50%, 0, 0); animation: neonSweep 3s ease-in-out 0.8s infinite; }
    .neon-line-animate .neon-line-shadow { opacity: 0; animation: neonGlow 3s ease-in-out 0.8s infinite; }
    @keyframes neonFadeIn { from { filter: blur(3px); opacity: 0; } to { filter: blur(0); opacity: 1; } }
    @keyframes neonColorIn { from { filter: grayscale(100%); } to { filter: grayscale(0%); } }
    @keyframes neonSweep { 0% { transform: translate3d(-50%, 0, 0); } 50% { transform: translate3d(0%, 0, 0); } 100% { transform: translate3d(-50%, 0, 0); } }
    @keyframes neonGlow { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.9; } }

    .ab-fade { animation: abFade 0.8s ease-out both; }
    @keyframes abFade {
      from { filter: blur(3px); opacity: 0; transform: translateY(1rem); }
      to   { filter: blur(0);   opacity: 1; transform: translateY(0); }
    }

    /* Hero wrap */
    .ab-hero { position: relative; overflow: hidden; }
    .ab-hero .hero-heading-wrapper { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
    .ab-hero .hero-heading-wrapper > * { margin: 0; }
    .ab-hero .heading-large.hero-heading-large { line-height: 1.05; letter-spacing: -0.035em; }

    .ab-hero-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(36,215,88,0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(36,215,88,0.045) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
      pointer-events: none; z-index: 0;
      animation: abGridDrift 26s linear infinite;
    }
    @keyframes abGridDrift {
      from { background-position: 0 0, 0 0; }
      to   { background-position: 56px 56px, 56px 56px; }
    }
    .ab-hero-orb {
      position: absolute; width: 520px; height: 520px;
      top: -180px; left: 50%; transform: translateX(-50%);
      background: radial-gradient(circle, rgba(36,215,88,0.08) 0%, rgba(36,215,88,0.02) 35%, transparent 65%);
      filter: blur(20px); pointer-events: none; z-index: 0;
      animation: abOrbDrift 10s ease-in-out infinite;
    }
    @keyframes abOrbDrift {
      0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.85; }
      50%      { transform: translateX(-50%) translateY(18px); opacity: 1; }
    }
    .ab-hero > .container-medium { position: relative; z-index: 1; }

    .ab-eyebrow {
      display: inline-flex; align-items: center; gap: 0.55rem;
      padding: 0.4rem 0.95rem; border-radius: 100px;
      background: rgba(36,215,88,0.06);
      border: 1px solid rgba(36,215,88,0.22);
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.72rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: #24d758;
    }
    .ab-eyebrow-dot {
      width: 7px; height: 7px; border-radius: 50%; background: #24d758;
      box-shadow: 0 0 0 0 rgba(36,215,88,0.55);
      animation: abPulse 2.2s ease-out infinite;
    }
    @keyframes abPulse {
      0%   { box-shadow: 0 0 0 0 rgba(36,215,88,0.55); opacity: 1; }
      70%  { box-shadow: 0 0 0 10px rgba(36,215,88,0); opacity: 0.7; }
      100% { box-shadow: 0 0 0 0 rgba(36,215,88,0); opacity: 1; }
    }

    /* Section eyebrow (small green pill above h2) */
    .ab-section-eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: #24d758; margin: 0 0 0.75rem;
    }
    .ab-section-eyebrow::before {
      content: ''; width: 22px; height: 1px;
      background: linear-gradient(90deg, #24d758, transparent);
    }

    /* Dot grid backdrop for sections */
    .ab-dotted { position: relative; overflow: hidden; }
    .ab-dotted::before {
      content: ''; position: absolute; inset: 0;
      background-image: radial-gradient(circle, rgba(36,215,88,0.06) 1px, transparent 1.5px);
      background-size: 32px 32px;
      mask-image: radial-gradient(ellipse 90% 70% at 50% 50%, #000 0%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 50%, #000 0%, transparent 80%);
      pointer-events: none; z-index: 0;
    }
    .ab-dotted > .container,
    .ab-dotted > .container-medium { position: relative; z-index: 1; }

    /* Scroll reveal */
    .ab-reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.7s ease, transform 0.7s ease; }
    .ab-reveal.is-visible { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .ab-reveal { opacity: 1; transform: none; transition: none; }
      .ab-fade, .ab-hero-grid, .ab-hero-orb, .ab-eyebrow-dot, .neon-line-animate,
      .neon-line-animate .neon-line-parent, .neon-line-animate .neon-line-inner,
      .neon-line-animate .neon-line-shadow { animation: none !important; }
      .ab-fade { opacity: 1; filter: none; transform: none; }
    }

    /* Story section: pull-quote accent + numbered count */
    .about-story-left { position: relative; padding-left: 1rem; }
    .about-story-left::before {
      content: ''; position: absolute; left: 0; top: 0.25rem;
      width: 2px; height: 60%;
      background: linear-gradient(180deg, #24d758, transparent);
    }
    .about-story-right p { color: rgba(255,255,255,0.78); }
    .about-story-right p:last-child { color: rgba(255,255,255,0.55); font-style: italic; }
    .ab-story-tag {
      display: inline-flex; align-items: center; gap: 0.5rem;
      margin-top: 1.25rem; padding: 0.35rem 0.8rem;
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase;
      color: #9fe7bf;
      background: rgba(36,215,88,0.06);
      border: 1px solid rgba(36,215,88,0.22);
      border-radius: 100px;
    }

    /* Philosophy numbered cards */
    .about-value-card { position: relative; transition: border-color 0.3s ease, background 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease; }
    .about-value-card:hover { transform: translateY(-3px); box-shadow: 0 18px 38px -22px rgba(36,215,88,0.30); }
    .about-value-num {
      position: absolute; top: 1rem; right: 1.25rem;
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.68rem; letter-spacing: 0.14em;
      color: rgba(36,215,88,0.65);
    }

    /* Team cards — founder badge, link row */
    .about-team-card { position: relative; }
    .about-team-founder-badge {
      position: absolute; top: 1rem; right: 1rem;
      padding: 0.18rem 0.55rem; border-radius: 100px;
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.6rem; letter-spacing: 0.14em;
      text-transform: uppercase; font-weight: 700;
      color: #0a0a0a;
      background: linear-gradient(135deg, #24d758, #27dab4);
    }
    .about-team-links {
      display: flex; gap: 0.5rem; margin-top: 0.75rem;
    }
    .about-team-link {
      width: 32px; height: 32px; border-radius: 8px;
      display: inline-flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,0.55);
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      transition: color 0.2s ease, background 0.2s ease, border-color 0.2s ease;
    }
    .about-team-link:hover {
      color: #24d758; background: rgba(36,215,88,0.08);
      border-color: rgba(36,215,88,0.3);
    }

    /* Mission & Vision cards */
    .ab-mv-grid {
      display: grid; grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem; max-width: 1040px; margin: 0 auto;
    }
    .ab-mv-card {
      position: relative; overflow: hidden;
      padding: 2rem 2rem 2.25rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 16px;
      transition: border-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    }
    .ab-mv-card:hover {
      border-color: rgba(36,215,88,0.3);
      transform: translateY(-3px);
      box-shadow: 0 22px 50px -28px rgba(36,215,88,0.32);
    }
    .ab-mv-card::before {
      content: ''; position: absolute; top: -60px; right: -60px;
      width: 220px; height: 220px; border-radius: 50%;
      background: radial-gradient(circle, rgba(36,215,88,0.1), transparent 70%);
      pointer-events: none;
    }
    .ab-mv-vision::before {
      background: radial-gradient(circle, rgba(39,218,180,0.12), transparent 70%);
    }
    .ab-mv-card > * { position: relative; z-index: 1; }

    .ab-mv-head {
      display: flex; align-items: center; gap: 0.75rem;
      margin-bottom: 1.25rem;
    }
    .ab-mv-icon {
      width: 2.75rem; height: 2.75rem;
      display: inline-flex; align-items: center; justify-content: center;
      color: #24d758;
      background: rgba(36,215,88,0.08);
      border: 1px solid rgba(36,215,88,0.2);
      border-radius: 12px;
    }
    .ab-mv-tag {
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.7rem; letter-spacing: 0.16em;
      text-transform: uppercase; font-weight: 700;
      color: #24d758;
    }
    .ab-mv-title {
      font-size: 1.25rem; font-weight: 600; line-height: 1.35;
      color: #fff; margin: 0 0 1rem; letter-spacing: -0.01em;
    }
    .ab-mv-body {
      font-size: 0.95rem; line-height: 1.65;
      color: rgba(255,255,255,0.7);
      margin: 0 0 1.25rem;
    }
    .ab-mv-list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column; gap: 0.55rem;
    }
    .ab-mv-list li {
      position: relative; padding-left: 1.5rem;
      font-size: 0.9rem; line-height: 1.5;
      color: rgba(255,255,255,0.75);
    }
    .ab-mv-list li::before {
      content: ''; position: absolute; left: 0; top: 0.55rem;
      width: 10px; height: 10px; border-radius: 2px;
      background: linear-gradient(135deg, #24d758, #27dab4);
      box-shadow: 0 0 8px rgba(36,215,88,0.4);
    }
    .ab-mv-roadmap li {
      display: flex; align-items: flex-start; gap: 0.85rem;
      padding-left: 0;
    }
    .ab-mv-roadmap li::before { display: none; }
    .ab-mv-year {
      flex-shrink: 0;
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.72rem; letter-spacing: 0.1em; font-weight: 700;
      color: #24d758;
      background: rgba(36,215,88,0.08);
      border: 1px solid rgba(36,215,88,0.25);
      border-radius: 6px;
      padding: 0.3rem 0.55rem;
      min-width: 56px; text-align: center;
    }
    @media (max-width: 840px) {
      .ab-mv-grid { grid-template-columns: 1fr; }
    }

    /* Final CTA: immersive */
    .ab-final-cta { position: relative; overflow: hidden; }
    .ab-final-cta::before {
      content: ''; position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(36,215,88,0.05) 1px, transparent 1px),
        linear-gradient(90deg, rgba(36,215,88,0.05) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 70% 80% at 50% 50%, #000 0%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 70% 80% at 50% 50%, #000 0%, transparent 75%);
      pointer-events: none; z-index: 0;
      animation: abGridDrift 26s linear infinite;
    }
    .ab-final-cta::after {
      content: ''; position: absolute; left: 50%; top: 50%;
      width: 600px; height: 600px;
      transform: translate(-50%, -50%);
      background: radial-gradient(circle, rgba(36,215,88,0.10) 0%, transparent 60%);
      filter: blur(24px); pointer-events: none; z-index: 0;
      animation: abOrbDrift 11s ease-in-out infinite;
    }
    .ab-final-cta > .container { position: relative; z-index: 1; }

    /* Hero CTA buttons */
    .ab-hero-cta-row {
      display: flex; gap: 0.75rem; justify-content: center;
      flex-wrap: wrap; margin-top: 1.75rem;
    }
    .ab-hero-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.85rem 1.5rem; border-radius: 10px;
      font-size: 0.92rem; font-weight: 600; letter-spacing: -0.005em;
      text-decoration: none; border: 1px solid transparent; cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
      font-family: inherit;
    }
    .ab-hero-btn-primary {
      background: linear-gradient(135deg, #24d758, #27dab4); color: #0a0a0a;
      box-shadow: 0 4px 18px rgba(36,215,88,0.18);
    }
    .ab-hero-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(36,215,88,0.28); }
    .ab-hero-btn-secondary {
      background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.15);
    }
    .ab-hero-btn-secondary:hover { background: rgba(36,215,88,0.06); border-color: rgba(36,215,88,0.35); }
    .ab-hero-btn svg { transition: transform 0.2s ease; }
    .ab-hero-btn:hover svg { transform: translateX(3px); }
    </style>
  </Fragment>

  <Header currentPage="about" />

  <main id="main" class="main">

    <!-- ============ HERO ============ -->
    <section class="section top-padding-small bottom-padding-medium ab-hero">
      <div class="ab-hero-grid" aria-hidden="true"></div>
      <div class="ab-hero-orb" aria-hidden="true"></div>
      <div class="container-medium">
        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="neon-line-box neon-line-animate">
              <div class="neon-line-parent">
                <div class="neon-line-inner"></div>
              </div>
              <div class="neon-line-shadow"></div>
            </div>
            <div class="hero-heading-wrapper">
              <span class="ab-eyebrow ab-fade">
                <span class="ab-eyebrow-dot" aria-hidden="true"></span>
                About Underwings
              </span>
              <h1 class="heading-large hero-heading-large ab-fade" style="animation-delay: 0.2s">Fresh Start,<br><span class="text-gradient-clip bg-color-green-gradient">Serious Security</span></h1>
              <p class="text text-center ab-fade" style="animation-delay: 0.4s; max-width: 700px; margin: 0 auto; text-align: center;">We're a cybersecurity startup building the partner we wish existed when we were on the other side — one that leads with honesty, does the actual work, and doesn't charge enterprise prices for startup-sized problems.</p>

              <div class="ab-hero-cta-row ab-fade" style="animation-delay: 0.55s">
                <a href="#team" class="ab-hero-btn ab-hero-btn-primary">
                  <span>Meet the team</span>
                  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                    <path d="M1.5 7.5h12M8 2l5.5 5.5L8 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <a href="#contact-section" class="ab-hero-btn ab-hero-btn-secondary">
                  <span>Get in touch</span>
                  <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                    <path d="M1.5 7.5h12M8 2l5.5 5.5L8 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Stats Bar -->
        <div class="about-stats ab-fade" style="animation-delay: 0.7s">
          <div class="about-stat">
            <span class="about-stat-number">UAE</span>
            <span class="about-stat-label">Operating From</span>
          </div>
          <div class="about-stat-divider"></div>
          <div class="about-stat">
            <span class="about-stat-number" data-target="10" data-suffix="+">10+</span>
            <span class="about-stat-label">Certifications Held</span>
          </div>
          <div class="about-stat-divider"></div>
          <div class="about-stat">
            <span class="about-stat-number">OSCP</span>
            <span class="about-stat-label">CPTS &bull; CEH &bull; CDSA</span>
          </div>
          <div class="about-stat-divider"></div>
          <div class="about-stat">
            <span class="about-stat-number" data-target="24" data-suffix="h">24h</span>
            <span class="about-stat-label">Response Time</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ OUR STORY / MISSION ============ -->
    <section class="section bg-color-dark ab-dotted">
      <div class="container">
        <div class="about-story ab-reveal">
          <div class="about-story-left">
            <div class="ab-section-eyebrow">Our Story</div>
            <h2 class="heading">Why We <span class="text-gradient-clip bg-color-green-gradient">Started</span></h2>
            <div class="ab-story-tag" aria-hidden="true">Founded 2026 · UAE</div>
          </div>
          <div class="about-story-right">
            <p class="text-medium" style="margin-bottom: 1.5rem;">We started Underwings because we kept seeing the same problem — businesses buying security tools they didn't need, or getting generic advice that didn't fit their actual risks. The gap between what's sold and what actually protects is wide.</p>
            <p class="text-medium" style="margin-bottom: 1.5rem;">So we're building something different. A small, focused team of certified security professionals who lead with understanding before recommending. We don't push products — we solve problems. Whether it's a penetration test, ISO 27001 implementation, or the right security software, we start by listening.</p>
            <p class="text-medium">We're just getting started, operating from the UAE, and working with businesses that want security done right — practical, affordable, and built around real risks, not vendor hype.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ MISSION & VISION ============ -->
    <section class="section ab-dotted" style="padding-top: 3rem; padding-bottom: 3rem;">
      <div class="container">
        <div style="text-align: center; margin-bottom: 2rem;" class="ab-reveal">
          <div class="ab-section-eyebrow" style="justify-content: center; margin-bottom: 0.5rem;">Purpose</div>
          <h2 class="heading heading-center" style="margin-bottom: 0.5rem;">Mission &amp; <span class="text-gradient-clip bg-color-green-gradient">Vision</span></h2>
          <p class="text-medium" style="max-width: 600px; margin: 0.5rem auto 0; color: rgba(255,255,255,0.65);">What we do today, and where we're taking UAE cybersecurity over the next three years.</p>
        </div>

        <div class="ab-mv-grid">
          <div class="ab-mv-card ab-reveal" style="transition-delay: 0ms">
