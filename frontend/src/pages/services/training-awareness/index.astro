---
// ===========================================
// CATEGORY HUB — Training & Awareness
// 2 flagship services + Y2 coming-soon roadmap
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PricingTiers from '../../../components/PricingTiers.astro';
import '../../../styles/category-hub.css';

const tiers = [
  {
    name: "Starter",
    price: "AED 6,000",
    ideal: "Small UAE companies running their first awareness session.",
    includes: [
      "One 2-hour workshop",
      "Up to 15 staff",
      "Live attack demos",
      "Attendance certificate per attendee",
    ],
    notIncluded: [
      "Phishing simulation",
      "Tabletop exercise",
    ],
  },
  {
    name: "Essentials",
    price: "AED 12,000",
    ideal: "Growing companies running annual training across one team.",
    includes: [
      "One 2-hour workshop",
      "Up to 30 staff",
      "Live attack demos + Q&A",
      "Tailored to your sector",
      "Pre/post knowledge check",
    ],
    notIncluded: [
      "Phishing simulation",
      "Quarterly drills",
    ],
  },
  {
    name: "Professional",
    price: "AED 28,000",
    ideal: "Mid-market companies wanting a measurable behavior-change program.",
    includes: [
      "Workshop (up to 60 staff)",
      "Tabletop incident response exercise",
      "One simulated phishing campaign",
      "Click-rate baseline + post-training comparison",
      "Executive readout",
    ],
    notIncluded: [
      "Quarterly recurring drills",
      "Multi-language delivery",
    ],
    popular: true,
  },
  {
    name: "Enterprise",
    price: "AED 40,000–55,000",
    ideal: "Multi-site companies needing an annual program with quarterly drills.",
    includes: [
      "Annual program (workshops, multiple cohorts)",
      "Quarterly tabletop or phishing drill",
      "Role-specific training (executives, IT, finance)",
      "Multi-language delivery (EN/AR)",
      "Annual board-readout report",
    ],
    notIncluded: [
      "Custom e-learning module development",
      "On-site delivery outside UAE",
    ],
  },
];

const flagship = [
  {
    slug: "security-awareness-training",
    title: "Security Awareness Training — Workshops",
    tagline: "Classroom or virtual workshops on phishing, social engineering, password, data handling. Live attack demos by the same team that runs the pen tests.",
    price: "AED 3,500 – 12,000",
    certs: ["CEH", "OSCP", "GRC Mastery"],
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/training-awareness/security-awareness-training",
  },
  {
    slug: "tabletop-incident-response",
    title: "Tabletop Incident Response Exercise",
    tagline: "1-day simulated cyber-incident drill with your team. Test the plan, surface the gaps, produce an improvement report. No tooling needed.",
    price: "AED 3,500 – 10,000",
    certs: ["CPTS", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/training-awareness/tabletop-incident-response",
  },
];

const comingY2 = [
  { slug: "awareness-e-learning-platform", title: "Security Awareness E-Learning Platform", desc: "Our own self-serve LMS with per-seat annual licensing. Micro-lessons, phishing scores, compliance tracking. UAE-local content, Arabic support." },
  { slug: "role-specific-training-tracks", title: "Role-Specific Training Tracks", desc: "Targeted tracks for developers (secure coding), executives (board-level cyber), and finance teams (wire-fraud and social engineering)." },
];

const comingY3 = [];

// Mirrors the EXISTING visible FAQ section below (schema only — no content change).
const faqs = [
  { q: "In-person or virtual? Where can you deliver?", a: "Both. In-person across the UAE (Dubai, Abu Dhabi, Sharjah, Northern Emirates), and virtual via Teams or Zoom for distributed teams. Hybrid is fine — main session in-person with a remote feed. Travel outside the UAE is quoted on request." },
  { q: "Can the training be delivered in Arabic?", a: "Yes. The standard package is English by default; Advanced and Custom include Arabic delivery. Mixed-language teams get bilingual slides plus an Arabic-speaking instructor co-delivering. Other languages (Hindi, Urdu, Tagalog, Russian) are available for Custom programmes." },
  { q: "How do you actually measure that behaviour changed?", a: "Three ways: a pre/post quiz for a knowledge baseline; phishing simulation campaigns before and after to measure real click-rate change; and 30/60/90-day follow-up phishing runs to confirm the change holds. Advanced and Custom packages include this measurement loop." },
  { q: "Is the workshop suitable for non-technical staff?", a: "Yes — that's the design. Content is calibrated to the audience: front-line workshops focus on what attackers do day-to-day (phishing emails, fake calls, password reuse), while custom tracks for technical staff or executives go deeper into BEC, wire-fraud red flags, and supply-chain risk." },
  { q: "Will this map to ISO 27001 / NESA / PDPL training requirements?", a: "Yes. Advanced and Custom packages include an evidence pack mapped to ISO 27001 A.6.3, UAE IA HR-3, ADHICS v2, and PDPL awareness clauses. Attendance registers, content outlines and post-quiz scores are formatted for direct submission to your auditor." },
  { q: "Can we schedule annual training as a retainer?", a: "Yes — most clients on the Custom package convert to an annual retainer covering one main workshop, four quarterly phishing simulations, one tabletop incident-response exercise, and ad-hoc executive briefings. Predictable fixed-fee, billed annually or quarterly in AED." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Training & Awareness", "item": "https://underwings.org/services/training-awareness" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Training & Awareness Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({ "@type": "ListItem", "position": i + 1, "name": s.title, "url": `https://underwings.org${s.href}` }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="Security Awareness Training UAE & IR Drills | Underwings"
  description="Security awareness training in the UAE: phishing simulation, cybersecurity training workshops and tabletop IR drills. Live demos by OSCP practitioners."
  keywords="security awareness training UAE, cybersecurity training UAE, cyber security awareness UAE, phishing simulation UAE, tabletop incident response UAE, IR tabletop exercise"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Fragment slot="head">
    <style is:inline>
      .tr-hero-fade { animation: trHeroFadeIn 0.8s ease-out both; animation-delay: 0.5s; }
      @keyframes trHeroFadeIn {
        from { filter: blur(3px); opacity: 0; transform: translateY(1rem); }
        to   { filter: blur(0);   opacity: 1; transform: translateY(0); }
      }

      .tr-hero-wrap { position: relative; overflow: hidden; }
      .tr-hero-wrap .hero-heading-wrapper {
        display: flex; flex-direction: column; align-items: center; gap: 1.1rem;
      }
      .tr-hero-wrap .hero-heading-wrapper > * { margin: 0; }
      .tr-hero-wrap .heading-large.hero-heading-large {
        line-height: 1.05; letter-spacing: -0.035em;
      }

      .tr-hero-eyebrow {
        display: inline-flex; align-items: center; gap: 0.55rem;
        padding: 0.4rem 0.95rem; border-radius: 100px;
        background: rgba(36,215,88,0.06);
        border: 1px solid rgba(36,215,88,0.22);
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: #24d758;
      }
      .tr-hero-pulse {
        width: 7px; height: 7px; border-radius: 50%; background: #24d758;
        box-shadow: 0 0 0 0 rgba(36,215,88,0.55);
        animation: trHeroPulse 2.2s ease-out infinite;
      }
      @keyframes trHeroPulse {
        0%   { box-shadow: 0 0 0 0 rgba(36,215,88,0.55); opacity: 1; }
        70%  { box-shadow: 0 0 0 10px rgba(36,215,88,0); opacity: 0.7; }
        100% { box-shadow: 0 0 0 0 rgba(36,215,88,0); opacity: 1; }
      }

      .tr-hero-rotator {
        position: relative; display: inline-block;
        vertical-align: baseline; white-space: nowrap;
      }
      .tr-hero-rotator-word {
        display: inline-block;
        background: linear-gradient(90deg, #24d758 0%, #27dab4 100%);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent; color: transparent;
        transition: text-shadow 0.25s ease;
      }
      .tr-hero-rotator.is-typing .tr-hero-rotator-word,
      .tr-hero-rotator.is-deleting .tr-hero-rotator-word {
        text-shadow: 0 0 22px rgba(36,215,88,0.25);
      }
      .tr-hero-rotator-caret {
        display: inline-block; width: 2px; height: 0.95em;
        margin-left: 4px;
        background: linear-gradient(180deg, #24d758, #27dab4);
        vertical-align: -0.08em; border-radius: 2px;
        box-shadow: 0 0 10px rgba(36,215,88,0.6);
        animation: trHeroCaretBlink 0.9s ease-in-out infinite;
      }
      .tr-hero-rotator.is-typing .tr-hero-rotator-caret,
      .tr-hero-rotator.is-deleting .tr-hero-rotator-caret {
        animation: none; opacity: 1;
      }
      @keyframes trHeroCaretBlink {
        0%, 49%   { opacity: 1; }
        50%, 100% { opacity: 0.15; }
      }
      @media (max-width: 560px) {
        .tr-hero-rotator { white-space: normal; }
      }

      .tr-hero-cta-row {
        display: flex; gap: 0.75rem; justify-content: center;
        flex-wrap: wrap; margin-top: 1.75rem;
      }
      .tr-hero-btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.85rem 1.5rem; border-radius: 10px;
        font-size: 0.92rem; font-weight: 600; letter-spacing: -0.005em;
        text-decoration: none; border: 1px solid transparent; cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
        font-family: inherit;
      }
      .tr-hero-btn-primary {
        background: linear-gradient(135deg, #24d758, #27dab4); color: #0a0a0a;
        box-shadow: 0 4px 18px rgba(36,215,88,0.18);
      }
      .tr-hero-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(36,215,88,0.28); }
      .tr-hero-btn-secondary {
        background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.15);
      }
      .tr-hero-btn-secondary:hover { background: rgba(36,215,88,0.06); border-color: rgba(36,215,88,0.35); }
      .tr-hero-btn svg { transition: transform 0.2s ease; }
      .tr-hero-btn:hover svg { transform: translateX(3px); }

      .tr-hero-microtrust {
        display: flex; align-items: center; justify-content: center;
        gap: 0.55rem; margin: 1rem 0 0; font-size: 0.8rem;
        color: rgba(255,255,255,0.48); flex-wrap: wrap;
      }
      .tr-hero-microtrust-dot { color: rgba(255,255,255,0.2); }

      .tr-hero-stats {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 1rem; margin: 2.25rem auto 0; max-width: 780px;
        padding: 1.25rem 1.75rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; position: relative; overflow: hidden;
      }
      .tr-hero-stats::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse at top, rgba(36,215,88,0.06) 0%, transparent 65%);
        pointer-events: none;
      }
      .tr-hero-stat { display: flex; flex-direction: column; gap: 0.15rem; align-items: center; text-align: center; position: relative; z-index: 1; }
      .tr-hero-stat-num {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 1.35rem; font-weight: 700; color: #24d758;
        letter-spacing: -0.01em; font-variant-numeric: tabular-nums;
      }
      .tr-hero-stat-label {
        font-size: 0.7rem; color: rgba(255,255,255,0.5);
        text-transform: uppercase; letter-spacing: 0.08em;
      }
      @media (max-width: 720px) {
        .tr-hero-stats { grid-template-columns: repeat(2, 1fr); gap: 0.9rem 0.5rem; padding: 1rem; }
        .tr-hero-stat-num { font-size: 1.15rem; }
      }

      .tr-hero-grid {
        position: absolute; inset: 0;
        background-image:
          linear-gradient(rgba(36,215,88,0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(36,215,88,0.045) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
        pointer-events: none; z-index: 0;
        animation: trHeroGridDrift 24s linear infinite;
      }
      @keyframes trHeroGridDrift {
        from { background-position: 0 0, 0 0; }
        to   { background-position: 56px 56px, 56px 56px; }
      }
      .tr-hero-orb {
        position: absolute; width: 520px; height: 520px;
        top: -180px; left: 50%; transform: translateX(-50%);
        background: radial-gradient(circle, rgba(36,215,88,0.08) 0%, rgba(36,215,88,0.02) 35%, transparent 65%);
        filter: blur(20px); pointer-events: none; z-index: 0;
        animation: trHeroOrbDrift 9s ease-in-out infinite;
      }
      @keyframes trHeroOrbDrift {
        0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.85; }
        50%      { transform: translateX(-50%) translateY(18px); opacity: 1; }
      }

      .tr-hero-wrap .crumbs { position: relative; z-index: 1; }

      .tr-method-ribbon {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
        gap: 0.5rem; margin-top: 2.25rem; padding: 0 1rem;
        position: relative; z-index: 1;
      }
      .tr-method-label {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: rgba(255,255,255,0.4); margin-right: 0.5rem;
      }
      .tr-method-chip {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.04em;
        padding: 0.35rem 0.7rem; border-radius: 6px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.7);
      }

      /* ───── Packages ───── */
      .tr-pkg-head { text-align: center; margin-bottom: 3rem; }
      .tr-pkg-sub { max-width: 600px; margin: 1rem auto 0; color: rgba(255,255,255,0.65); font-size: 0.95rem; line-height: 1.6; text-align: center; }

      .tr-pkg-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; align-items: stretch;
      }
      .tr-pkg-card {
        position: relative;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 2rem 1.75rem;
        display: flex; flex-direction: column;
        transition: border-color 0.3s ease, transform 0.3s ease;
      }
      .tr-pkg-card:hover { border-color: rgba(36,215,88,0.25); transform: translateY(-3px); }
      .tr-pkg-card-featured {
        border-color: rgba(36,215,88,0.4);
        background: linear-gradient(180deg, rgba(36,215,88,0.06) 0%, rgba(255,255,255,0.03) 60%);
        box-shadow: 0 0 0 1px rgba(36,215,88,0.15), 0 20px 40px rgba(36,215,88,0.05);
      }
      .tr-pkg-tag {
        display: inline-block; align-self: flex-start;
        font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.16em;
        font-weight: 600; padding: 0.3rem 0.65rem;
        background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.6);
        border-radius: 4px; margin-bottom: 1rem;
      }
      .tr-pkg-tag-featured {
        background: linear-gradient(135deg, #24d758, #27dab4); color: #000;
      }
      .tr-pkg-title {
        font-size: 1.4rem; font-weight: 600; color: #fff;
        margin: 0 0 0.4rem; letter-spacing: -0.02em;
      }
      .tr-pkg-tagline {
        font-size: 0.85rem; color: rgba(255,255,255,0.6);
        margin-bottom: 1.5rem; line-height: 1.5;
      }
      .tr-pkg-price { margin-bottom: 1.25rem; padding-bottom: 1.25rem; border-bottom: 1px solid rgba(255,255,255,0.06); }
      .tr-pkg-from {
        display: block; font-size: 0.7rem; color: rgba(255,255,255,0.45);
        text-transform: uppercase; letter-spacing: 0.12em; margin-bottom: 0.25rem;
      }
      .tr-pkg-amount { display: block; font-size: 1.65rem; font-weight: 700; color: #fff; line-height: 1.1; margin-bottom: 0.25rem; }
      .tr-pkg-period { display: block; font-size: 0.78rem; color: rgba(255,255,255,0.5); }
      .tr-pkg-list { list-style: none; padding: 0; margin: 0 0 1.5rem; flex-grow: 1; }
      .tr-pkg-list li {
        display: flex; align-items: flex-start; gap: 0.5rem;
        font-size: 0.85rem; color: rgba(255,255,255,0.78);
        line-height: 1.5; padding: 0.4rem 0;
      }
      .tr-pkg-list svg { flex-shrink: 0; margin-top: 4px; }
      .tr-pkg-cta {
        display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
        width: 100%; padding: 0.75rem 1rem;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.12);
        border-radius: 8px;
        color: rgba(255,255,255,0.85);
        text-decoration: none; font-size: 0.85rem; font-weight: 500;
        transition: background 0.2s, border-color 0.2s, color 0.2s;
      }
      .tr-pkg-cta:hover {
        background: rgba(36,215,88,0.08);
        border-color: rgba(36,215,88,0.3);
        color: #fff;
      }
      .tr-pkg-cta-featured {
        background: linear-gradient(135deg, #24d758, #27dab4);
        color: #000; border-color: transparent; font-weight: 600;
      }
      .tr-pkg-cta-featured:hover {
        background: linear-gradient(135deg, #2bea61, #2eedc0);
        color: #000;
      }
      .tr-pkg-disclaimer {
        text-align: center; margin-top: 2rem;
        font-size: 0.78rem; color: rgba(255,255,255,0.45);
        max-width: 720px; margin-left: auto; margin-right: auto; line-height: 1.6;
      }

      /* FAQ */
      .tr-faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.75rem; }
      .tr-faq-item {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        transition: border-color 0.2s ease;
      }
      .tr-faq-item:hover { border-color: rgba(255,255,255,0.16); }
      .tr-faq-item[open] { border-color: rgba(36,215,88,0.25); }
      .tr-faq-q {
        list-style: none; cursor: pointer;
        padding: 1.1rem 1.5rem; font-size: 0.95rem; font-weight: 500; color: #fff;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        -webkit-tap-highlight-color: transparent;
      }
      .tr-faq-q::-webkit-details-marker { display: none; }
      .tr-faq-icon { color: rgba(255,255,255,0.5); transition: transform 0.25s ease, color 0.2s ease; flex-shrink: 0; }
      .tr-faq-item[open] .tr-faq-icon { transform: rotate(180deg); color: #24d758; }
      .tr-faq-a { padding: 0 1.5rem 1.25rem; color: rgba(255,255,255,0.72); font-size: 0.9rem; line-height: 1.65; }

      @media (max-width: 991px) {
        .tr-pkg-grid { grid-template-columns: 1fr; max-width: 480px; margin-left: auto; margin-right: auto; }
      }
      @media (max-width: 479px) {
        .tr-faq-q { padding: 1rem 1.1rem; font-size: 0.9rem; }
        .tr-faq-a { padding: 0 1.1rem 1rem; font-size: 0.85rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .tr-hero-fade, .tr-hero-pulse, .tr-hero-orb, .tr-hero-grid,
        .tr-hero-rotator-word, .tr-hero-rotator-caret {
          animation: none !important;
        }
        .tr-hero-fade { opacity: 1; filter: none; transform: none; }
      }
    </style>
  </Fragment>

  <Header currentPage="services" />

  <main id="main" class="main">

    <section class="section bottom-padding-clear top-padding-small tr-hero-wrap">
      <div class="tr-hero-grid" aria-hidden="true"></div>
      <div class="tr-hero-orb" aria-hidden="true"></div>
      <div class="container-medium" style="position: relative; z-index: 1;">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">›</span>
          <span class="crumbs-current">Training &amp; Awareness</span>
        </nav>

        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <span class="tr-hero-eyebrow tr-hero-fade">
                <span class="tr-hero-pulse" aria-hidden="true"></span>
                Training &amp; Awareness · Live Attack Demos
              </span>

              <h1 class="heading-large hero-heading-large tr-hero-fade" style="animation-delay: 0.2s">
                Awareness training for<br><span class="tr-hero-rotator" aria-live="polite"><span class="tr-hero-rotator-word" data-rotate='["Phishing &amp; BEC","Social Engineering","Wire-Fraud Defence","Password &amp; MFA Hygiene","Tabletop IR Drills","Executive Briefings","Secure Coding Tracks"]'>Phishing &amp; BEC</span><span class="tr-hero-rotator-caret" aria-hidden="true"></span></span>
              </h1>

              <p class="text text-center tr-hero-fade" style="animation-delay: 0.4s; max-width:720px; margin:0 auto;">
                Workshops led by the <strong>same OSCP-certified team that runs the pen tests</strong>. Live attack
                demos, before/after phishing metrics, and HR-ready reports — not annual slideshows employees click through.
              </p>
            </div>

            <div class="tr-hero-cta-row tr-hero-fade" style="animation-delay: 0.55s">
              <a href="/#contact?service=training-awareness" class="tr-hero-btn tr-hero-btn-primary">
                <span>Get a 24-hour quote</span>
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M1.5 7.5h12M8 2l5.5 5.5L8 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="https://wa.me/971505670394?text=Hi%2C%20I%27d%20like%20to%20discuss%20a%20security%20awareness%20training%20package"
                 target="_blank" rel="noopener"
