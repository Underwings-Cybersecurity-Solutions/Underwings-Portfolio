---
// ============================================================
// SERVICE PAGE — Tabletop Incident Response Exercise (LIGHTER TEMPLATE)
// Category: Training & Awareness (Y1 Flagship — easy wedge)
// ============================================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/service-page.css';

const faqs = [
  { q: "What scenario do you run?", a: "We pick a scenario calibrated to your sector, threat profile, and existing IR plan — typical choices: ransomware detection + containment, business-email-compromise fraud attempt, phishing-led credential compromise, data exfiltration, supply-chain compromise, or ransomware incident with regulatory-notification obligations. Scenario selected during scoping, tailored to your environment." },
  { q: "Who should attend?", a: "Incident response team members (typically IT, security, legal, comms / PR, HR, executive sponsor). 6 – 12 people is ideal — small enough for everyone to participate, large enough to cover all decision roles. We also run executive-only versions for board and C-suite." },
  { q: "Do I need an IR plan for this to be useful?", a: "No. If you don't have one, the exercise reveals exactly what's missing. You leave with a list of the decisions you couldn't make fast enough — that's the real output. If you do have a plan, the exercise stress-tests it." },
  { q: "Is this the same as a Red Team exercise?", a: "No. Red Team is a live adversary simulation against real systems (on our roadmap). Tabletop is a discussion-based scenario walk-through — zero technical risk, zero tooling, high preparedness value. Much faster and cheaper." },
];

const schema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
    { "@type": "ListItem", "position": 3, "name": "Training & Awareness", "item": "https://underwings.org/services/training-awareness" },
    { "@type": "ListItem", "position": 4, "name": "Tabletop Incident Response Exercise", "item": "https://underwings.org/services/training-awareness/tabletop-incident-response" }
  ]},
  { "@context": "https://schema.org", "@type": "Service", "name": "Tabletop Incident Response Exercise", "serviceType": "Incident Response Tabletop Exercise",
    "provider": { "@type": "Organization", "name": "Underwings Cybersecurity Solutions", "url": "https://underwings.org" },
    "areaServed": { "@type": "Country", "name": "United Arab Emirates" },
    "description": "UAE tabletop incident response exercise — 1-day simulated cyber-incident drill. Test the plan, surface gaps, produce improvement report. CPTS + ISO 27001 LA led.",
    "url": "https://underwings.org/services/training-awareness/tabletop-incident-response"
  },
  { "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="Tabletop Incident Response Exercise UAE | Underwings"
  description="UAE 1-day tabletop incident response exercise. Simulated cyber-incident drill, test your IR plan, surface gaps, improvement report. CPTS + ISO 27001 LA led."
  keywords="tabletop incident response UAE, IR tabletop exercise Dubai, cyber incident simulation UAE, incident response drill UAE, IR plan testing UAE"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/services">Services</a><span aria-hidden="true">›</span>
          <a href="/services/training-awareness">Training &amp; Awareness</a><span aria-hidden="true">›</span>
          <span class="crumbs-current">Tabletop Incident Response Exercise</span>
        </nav>

        <div class="svc-hero">
          <div class="label" style="justify-content:center;"><div class="text-small color-grey">Training &amp; Awareness — Flagship Service</div></div>
          <h1 class="heading-large">Tabletop Incident Response Exercise</h1>
          <p class="text" style="max-width:680px;margin:1rem auto 0;">
            A <strong>1-day simulated cyber-incident drill</strong> with your IR team — ransomware, BEC, data breach, supply-chain compromise. Test the plan. Find the gaps. Walk away with a ranked improvement list. No tooling required; maximum preparedness value per dollar.
          </p>

          <div class="svc-hero-badges">
            <span class="svc-hero-badge svc-hero-badge-certs">CPTS · ISO 27001 LA</span>
            <span class="svc-hero-badge svc-hero-badge-time">1 day + report</span>
          </div>

          <div class="svc-hero-ctas">
            <div class="button">
              <a href="/#contact?service=tabletop-ir" class="button-hidden w-button">Book a 30-min Scoping Call →</a>
              <div class="button-wrapper"><div class="button-text">Book a 30-min Scoping Call →</div></div>
              <div class="button-accent-gradinet"></div>
            </div>
            <a href="#faq" class="svc-hero-cta-secondary">Jump to FAQ</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What it is</h2>
        <div class="svc-sec-body">
          <p>A <strong>discussion-based exercise</strong> in which your incident response team walks through a realistic cyber incident — injects, decisions, escalations, external notifications — in a controlled facilitated setting. No technical systems are touched; nothing is at risk.</p>
          <p>The purpose is simple: find the decisions your team can't make fast enough, the gaps in your playbook, the escalation paths that don't actually work, and the roles and responsibilities that no-one has practised. <strong>Incidents are not the time to discover this.</strong> Tabletop is.</p>
          <p>Frequently chosen as a first engagement because it's low-cost, low-risk, high-value. Also one of the easiest to sell to boards because the output (a gap list) is directly actionable.</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Who this is for</h2>
        <div class="svc-triggers">
          <div class="svc-trigger"><div class="svc-trigger-num">1</div><div>You have an <strong>IR plan you've never tested</strong> — or you don't have one and need to know what good looks like.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">2</div><div>Your <strong>board or audit committee</strong> has asked how your organisation would actually respond to a ransomware event.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">3</div><div>You're preparing for <strong>ISO 27001 / NESA audit</strong> and need evidence of IR plan testing (Annex A.5.24).</div></div>
        </div>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What you get</h2>
        <ul class="svc-deliv-list">
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Tailored scenario design</strong> — calibrated to your sector, threat profile, and existing IR maturity.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>1-day facilitated exercise</strong> — typically 6 hours with breaks, covering detection through recovery + regulatory notification.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Observer-notes transcript</strong> — decisions made, decisions struggled-with, gaps surfaced.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Improvement report</strong> — prioritised recommendations across IR plan, playbooks, roles, escalations, comms, regulatory-notification process.</div></li>
          <li class="svc-deliv-item"><svg class="svc-deliv-ico" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg><div><strong>Attendance record</strong> — for ISO 27001 / NESA audit evidence.</div></li>
        </ul>
      </div>
    </section>

    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">How we deliver</h2>
        <div class="svc-process-table">
          <div class="svc-process-row"><div class="svc-process-row-num">01</div><div><div class="svc-process-row-step">Scoping &amp; scenario design</div><div class="svc-process-row-duration">1 week before</div></div><div class="svc-process-row-desc">60-minute call, scenario selection, attendee list, injects tailored to your environment.</div></div>
          <div class="svc-process-row"><div class="svc-process-row-num">02</div><div><div class="svc-process-row-step">Exercise day</div><div class="svc-process-row-duration">6 hours on-site (or virtual)</div></div><div class="svc-process-row-desc">Facilitated walk-through with injects, role-specific decision points, comms and escalation drills, regulatory-notification simulation.</div></div>
          <div class="svc-process-row"><div class="svc-process-row-num">03</div><div><div class="svc-process-row-step">Reporting</div><div class="svc-process-row-duration">3 days post-exercise</div></div><div class="svc-process-row-desc">Observer-notes transcript, prioritised improvement report with ranked recommendations.</div></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Your cert-backed lead</h2>
        <div class="svc-team" style="grid-template-columns:1fr;max-width:540px;">
          <div class="svc-team-card">
            <p class="svc-team-role">Lead Facilitator</p>
            <h3 class="svc-team-name">Manoj Prabhakaran</h3>
            <p class="svc-team-certs">CPTS · CDSA · ISO 27001 Lead Auditor · GRC Mastery</p>
            <p class="svc-team-focus"><strong>Focus:</strong> Scenario design, facilitation, observation, improvement recommendations. <strong>Angle:</strong> offensive-security background means the injects are realistic — not "a hacker did something bad" but specific, credible attacker actions.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section bg-color-dark" id="faq">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Frequently asked questions</h2>
        <div class="svc-faq">
          {faqs.map(item => (
            <details class="svc-faq-item">
              <summary>{item.q}</summary>
              <p class="svc-faq-answer" set:html={item.a}></p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">You might also need</h2>
        <div class="svc-related-grid" style="grid-template-columns:1fr 1fr;">
          <a href="/services/training-awareness/security-awareness-training" class="svc-related-card">
            <h4>Security Awareness Training</h4>
            <p>Most incidents start with a phishing click — train the whole workforce to reduce exposure.</p>
            <div class="svc-related-cta">Read full details <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 6h6M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          </a>
          <a href="/services/grc/iso-27001-implementation" class="svc-related-card">
            <h4>ISO 27001 Implementation</h4>
            <p>IR plan testing is a required sub-deliverable — tabletop evidence satisfies Annex A.5.24.</p>
            <div class="svc-related-cta">Read full details <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 6h6M7 3l3 3-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          </a>
        </div>
      </div>
    </section>

    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <div class="section-wrapper-vertical" style="align-items:center;text-align:center;">
          <h2 class="heading" style="max-width:600px;">If ransomware hit tomorrow, would your team know exactly what to do in the first hour?</h2>
          <p class="text-medium" style="max-width:600px;">1 day of work. Changes everything. Written quote in 48 hours.</p>
          <div class="button">
            <a href="/#contact?service=tabletop-ir" class="button-hidden w-button">Book a Scoping Call →</a>
            <div class="button-wrapper"><div class="button-text">Book a Scoping Call →</div></div>
            <div class="button-accent-gradinet"></div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
