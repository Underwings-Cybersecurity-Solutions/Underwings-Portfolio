---
// ===========================================
// CATEGORY HUB — Cloud Security
// 2 flagship services + Y2/Y3 coming-soon roadmap
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PricingTiers from '../../../components/PricingTiers.astro';
import '../../../styles/category-hub.css';

const tiers = [
  {
    name: "Starter",
    price: "AED 9,000",
    ideal: "Sub-30-employee UAE companies wanting a first cloud baseline check.",
    includes: [
      "Azure OR M365 baseline review (one platform, not both)",
      "Up to 30 users / single tenant",
      "CIS top-tier control review",
      "Findings report + 30-min remediation walkthrough",
    ],
    notIncluded: [
      "Combined Azure + M365 review",
      "Identity deep-dive (Conditional Access design)",
    ],
  },
  {
    name: "Essentials",
    price: "AED 15,000",
    ideal: "Small-to-mid companies on a single cloud platform with growing user base.",
    includes: [
      "Azure OR M365 full posture review (one platform)",
      "Up to 100 users / single tenant",
      "CIS Benchmark + Microsoft Secure Score deep-dive",
      "Identity, MFA, Conditional Access analysis",
      "Prioritised remediation roadmap",
    ],
    notIncluded: [
      "Cross-platform mapping (Azure + M365)",
      "Custom application or workload review",
    ],
  },
  {
    name: "Professional",
    price: "AED 30,000–55,000",
    ideal: "Mid-market companies running both Azure and M365.",
    includes: [
      "Azure + M365 combined posture review",
      "Identity & access deep-dive across both",
      "Defender for Cloud / Defender XDR review",
      "Privileged access path analysis",
      "Executive readout + technical workshop",
    ],
    notIncluded: [
      "Hybrid AD or on-prem AD review",
      "Multi-tenant federation design",
    ],
    popular: true,
  },
  {
    name: "Enterprise",
    price: "AED 50,000–75,000",
    ideal: "Multi-tenant or hybrid-cloud organisations with custom workloads.",
    includes: [
      "Hybrid cloud (Azure + M365 + on-prem AD federation)",
      "Custom application review (API, app registrations, managed identities)",
      "Multi-tenant access path mapping",
      "Privileged Identity Management (PIM) design",
      "Quarterly posture re-check for 12 months",
    ],
    notIncluded: [
      "AWS or GCP review (separate quote)",
      "Custom application source-code review",
    ],
  },
];

const flagship = [
  {
    slug: "azure-cloud-security-assessment",
    title: "Azure Cloud Security Assessment",
    tagline: "Azure tenant, Entra ID, RBAC, storage, NSGs, Defender for Cloud — reviewed against CIS Azure Benchmark and Microsoft best practices.",
    price: "AED 11,000 – 24,000",
    certs: ["Azure Security"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/cloud-security/azure-cloud-security-assessment",
  },
  {
    slug: "microsoft-365-security-review",
    title: "Microsoft 365 Security Review",
    tagline: "Exchange, SharePoint, Teams, Conditional Access, MFA, DLP — the Microsoft 365 posture most UAE organisations haven't configured.",
    price: "AED 7,000 – 18,000",
    certs: ["Azure Security", "Security+"],
    lead: "Vinoth Samiyappa",
    hasPage: true,
    href: "/services/cloud-security/microsoft-365-security-review",
  },
];

const comingY2 = [
  { slug: "aws-cloud-security-assessment", title: "AWS Cloud Security Assessment", desc: "CIS AWS benchmark, IAM, VPC, S3, GuardDuty. Launching when AWS adoption in our UAE client base crosses threshold." },
];

const comingY3 = [
  { slug: "gcp-cloud-security-assessment", title: "GCP Cloud Security Assessment", desc: "CIS GCP benchmark, IAM, Cloud Logging, Security Command Center. Demand-driven rollout." },
  { slug: "cnapp-implementation", title: "Cloud Native Application Protection (CNAPP) Implementation", desc: "Unified CSPM + CWPP + CIEM platform rollout — for mid-market organisations with complex multi-cloud footprints." },
];

// Mirrors the EXISTING visible FAQ section below (schema only — no content change).
const faqs = [
  { q: "We're already on Azure / M365 with default config — is that really risky?", a: "Yes. Microsoft ships secure defaults for some settings, but the most impactful controls (Conditional Access policies, Defender posture, RBAC scope, storage anonymous access, SharePoint external sharing, Entra privileged-role membership) all need explicit configuration. Every UAE tenant we've seen has 10–30 high-severity findings out of the box." },
  { q: "Will an assessment disrupt our users or production environment?", a: "No. The assessment is read-only — we use a Global Reader role (Azure) and a delegated read-only admin (M365). No changes are made without your explicit approval during the remediation phase. Users see nothing and operations are unaffected." },
  { q: "Do you just give a report, or do you actually fix the issues?", a: "Both. The deliverable is a CIS-mapped findings report with a prioritised remediation plan, and we can implement the fixes for you — change-controlled, in your maintenance window, with your team shadowing for knowledge transfer." },
  { q: "What's the difference between an Azure assessment and an M365 review?", a: "An Azure assessment covers subscription-level resources: VMs, networking, storage, key vault, RBAC, Defender for Cloud posture, and Entra ID at the directory level. An M365 review covers user-facing workloads: Exchange, SharePoint, Teams, OneDrive, Conditional Access, MFA, DLP and sensitivity labels. Most clients need both — we usually bundle them at a discount." },
  { q: "What level of access do you need to start?", a: "For Azure: a guest account with the Global Reader role at the tenant root, plus Reader on the subscriptions in scope. For M365: a delegated read-only admin role. We sign an NDA before access is granted, and access can be revoked the moment delivery is complete. No credentials leave your tenant." },
  { q: "Will this work prepare us for ISO 27001, NESA or PDPL?", a: "Yes. Every finding is mapped to ISO 27001 Annex A controls, UAE IA V2, ADHICS v2, and relevant PDPL clauses on request. The remediation evidence we produce becomes audit evidence — one of the highest-leverage activities for any UAE compliance programme." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Cloud Security", "item": "https://underwings.org/services/cloud-security" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Cloud Security Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({ "@type": "ListItem", "position": i + 1, "name": s.title, "url": `https://underwings.org${s.href}` }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="Cloud Security UAE — Azure & M365 | Underwings"
  description="UAE cloud security assessments for Azure and Microsoft 365 against CIS benchmarks. Fix the 10–30 high-severity misconfigurations most businesses miss."
  keywords="Azure security assessment UAE, Microsoft 365 security review UAE, cloud security Dubai, Entra ID security UAE, CIS Azure benchmark assessment"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Fragment slot="head">
    <style is:inline>
      /* ───── Hero blur-fade in (staggered) ───── */
      .cs-hero-fade { animation: csHeroFadeIn 0.8s ease-out both; animation-delay: 0.5s; }
      @keyframes csHeroFadeIn {
        from { filter: blur(3px); opacity: 0; transform: translateY(1rem); }
        to   { filter: blur(0);   opacity: 1; transform: translateY(0); }
      }

      .cs-hero-wrap { position: relative; overflow: hidden; }
      .cs-hero-wrap .hero-heading-wrapper {
        display: flex; flex-direction: column; align-items: center; gap: 1.1rem;
      }
      .cs-hero-wrap .hero-heading-wrapper > * { margin: 0; }
      .cs-hero-wrap .heading-large.hero-heading-large {
        line-height: 1.05; letter-spacing: -0.035em;
      }

      /* Eyebrow pill with pulse */
      .cs-hero-eyebrow {
        display: inline-flex; align-items: center; gap: 0.55rem;
        padding: 0.4rem 0.95rem; border-radius: 100px;
        background: rgba(36,215,88,0.06);
        border: 1px solid rgba(36,215,88,0.22);
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: #24d758;
      }
      .cs-hero-pulse {
        width: 7px; height: 7px; border-radius: 50%; background: #24d758;
        box-shadow: 0 0 0 0 rgba(36,215,88,0.55);
        animation: csHeroPulse 2.2s ease-out infinite;
      }
      @keyframes csHeroPulse {
        0%   { box-shadow: 0 0 0 0 rgba(36,215,88,0.55); opacity: 1; }
        70%  { box-shadow: 0 0 0 10px rgba(36,215,88,0); opacity: 0.7; }
        100% { box-shadow: 0 0 0 0 rgba(36,215,88,0); opacity: 1; }
      }

      /* Typewriter rotator */
      .cs-hero-rotator {
        position: relative; display: inline-block;
        vertical-align: baseline; white-space: nowrap;
      }
      .cs-hero-rotator-word {
        display: inline-block;
        background: linear-gradient(90deg, #24d758 0%, #27dab4 100%);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent; color: transparent;
        transition: text-shadow 0.25s ease;
      }
      .cs-hero-rotator.is-typing .cs-hero-rotator-word,
      .cs-hero-rotator.is-deleting .cs-hero-rotator-word {
        text-shadow: 0 0 22px rgba(36,215,88,0.25);
      }
      .cs-hero-rotator-caret {
        display: inline-block; width: 2px; height: 0.95em;
        margin-left: 4px;
        background: linear-gradient(180deg, #24d758, #27dab4);
        vertical-align: -0.08em; border-radius: 2px;
        box-shadow: 0 0 10px rgba(36,215,88,0.6);
        animation: csHeroCaretBlink 0.9s ease-in-out infinite;
      }
      .cs-hero-rotator.is-typing .cs-hero-rotator-caret,
      .cs-hero-rotator.is-deleting .cs-hero-rotator-caret {
        animation: none; opacity: 1;
      }
      @keyframes csHeroCaretBlink {
        0%, 49%   { opacity: 1; }
        50%, 100% { opacity: 0.15; }
      }
      @media (max-width: 560px) {
        .cs-hero-rotator { white-space: normal; }
      }

      /* Dual CTA row */
      .cs-hero-cta-row {
        display: flex; gap: 0.75rem; justify-content: center;
        flex-wrap: wrap; margin-top: 1.75rem;
      }
      .cs-hero-btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.85rem 1.5rem; border-radius: 10px;
        font-size: 0.92rem; font-weight: 600; letter-spacing: -0.005em;
        text-decoration: none; border: 1px solid transparent; cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
        font-family: inherit;
      }
      .cs-hero-btn-primary {
        background: linear-gradient(135deg, #24d758, #27dab4); color: #0a0a0a;
        box-shadow: 0 4px 18px rgba(36,215,88,0.18);
      }
      .cs-hero-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(36,215,88,0.28); }
      .cs-hero-btn-secondary {
        background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.15);
      }
      .cs-hero-btn-secondary:hover { background: rgba(36,215,88,0.06); border-color: rgba(36,215,88,0.35); }
      .cs-hero-btn svg { transition: transform 0.2s ease; }
      .cs-hero-btn:hover svg { transform: translateX(3px); }

      /* Microtrust */
      .cs-hero-microtrust {
        display: flex; align-items: center; justify-content: center;
        gap: 0.55rem; margin: 1rem 0 0; font-size: 0.8rem;
        color: rgba(255,255,255,0.48); flex-wrap: wrap;
      }
      .cs-hero-microtrust-dot { color: rgba(255,255,255,0.2); }

      /* Stats strip */
      .cs-hero-stats {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 1rem; margin: 2.25rem auto 0; max-width: 780px;
        padding: 1.25rem 1.75rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; position: relative; overflow: hidden;
      }
      .cs-hero-stats::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse at top, rgba(36,215,88,0.06) 0%, transparent 65%);
        pointer-events: none;
      }
      .cs-hero-stat { display: flex; flex-direction: column; gap: 0.15rem; align-items: center; text-align: center; position: relative; z-index: 1; }
      .cs-hero-stat-num {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 1.35rem; font-weight: 700; color: #24d758;
        letter-spacing: -0.01em; font-variant-numeric: tabular-nums;
      }
      .cs-hero-stat-label {
        font-size: 0.7rem; color: rgba(255,255,255,0.5);
        text-transform: uppercase; letter-spacing: 0.08em;
      }
      @media (max-width: 720px) {
        .cs-hero-stats { grid-template-columns: repeat(2, 1fr); gap: 0.9rem 0.5rem; padding: 1rem; }
        .cs-hero-stat-num { font-size: 1.15rem; }
      }

      /* Animated grid + orb backdrop */
      .cs-hero-grid {
        position: absolute; inset: 0;
        background-image:
          linear-gradient(rgba(36,215,88,0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(36,215,88,0.045) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
        pointer-events: none; z-index: 0;
        animation: csHeroGridDrift 24s linear infinite;
      }
      @keyframes csHeroGridDrift {
        from { background-position: 0 0, 0 0; }
        to   { background-position: 56px 56px, 56px 56px; }
      }
      .cs-hero-orb {
        position: absolute; width: 520px; height: 520px;
        top: -180px; left: 50%; transform: translateX(-50%);
        background: radial-gradient(circle, rgba(36,215,88,0.08) 0%, rgba(36,215,88,0.02) 35%, transparent 65%);
        filter: blur(20px); pointer-events: none; z-index: 0;
        animation: csHeroOrbDrift 9s ease-in-out infinite;
      }
      @keyframes csHeroOrbDrift {
        0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.85; }
        50%      { transform: translateX(-50%) translateY(18px); opacity: 1; }
      }

      .cs-hero-wrap .crumbs { position: relative; z-index: 1; }

      /* Methodology ribbon */
      .cs-method-ribbon {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
        gap: 0.5rem; margin-top: 2.25rem; padding: 0 1rem;
        position: relative; z-index: 1;
      }
      .cs-method-label {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: rgba(255,255,255,0.4); margin-right: 0.5rem;
      }
      .cs-method-chip {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.04em;
        padding: 0.35rem 0.7rem; border-radius: 6px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.7);
      }

      /* FAQ */
      .cs-faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.75rem; }
      .cs-faq-item {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        transition: border-color 0.2s ease;
      }
      .cs-faq-item:hover { border-color: rgba(255,255,255,0.16); }
      .cs-faq-item[open] { border-color: rgba(36,215,88,0.25); }
      .cs-faq-q {
        list-style: none; cursor: pointer;
        padding: 1.1rem 1.5rem; font-size: 0.95rem; font-weight: 500; color: #fff;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        -webkit-tap-highlight-color: transparent;
      }
      .cs-faq-q::-webkit-details-marker { display: none; }
      .cs-faq-icon { color: rgba(255,255,255,0.5); transition: transform 0.25s ease, color 0.2s ease; flex-shrink: 0; }
      .cs-faq-item[open] .cs-faq-icon { transform: rotate(180deg); color: #24d758; }
      .cs-faq-a { padding: 0 1.5rem 1.25rem; color: rgba(255,255,255,0.72); font-size: 0.9rem; line-height: 1.65; }

      @media (max-width: 479px) {
        .cs-faq-q { padding: 1rem 1.1rem; font-size: 0.9rem; }
        .cs-faq-a { padding: 0 1.1rem 1rem; font-size: 0.85rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .cs-hero-fade, .cs-hero-pulse, .cs-hero-orb, .cs-hero-grid,
        .cs-hero-rotator-word, .cs-hero-rotator-caret {
          animation: none !important;
        }
        .cs-hero-fade { opacity: 1; filter: none; transform: none; }
      }
    </style>
  </Fragment>

  <Header currentPage="services" />

  <main id="main" class="main">

    <section class="section bottom-padding-clear top-padding-small cs-hero-wrap">
      <div class="cs-hero-grid" aria-hidden="true"></div>
      <div class="cs-hero-orb" aria-hidden="true"></div>
      <div class="container-medium" style="position: relative; z-index: 1;">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">›</span>
          <span class="crumbs-current">Cloud Security</span>
        </nav>

        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <span class="cs-hero-eyebrow cs-hero-fade">
                <span class="cs-hero-pulse" aria-hidden="true"></span>
                Cloud Security · CIS-Benchmarked
              </span>

              <h1 class="heading-large hero-heading-large cs-hero-fade" style="animation-delay: 0.2s">
                Audit &amp; harden your<br><span class="cs-hero-rotator" aria-live="polite"><span class="cs-hero-rotator-word" data-rotate='["Azure Tenant","Microsoft 365 Estate","Entra ID Identity","Conditional Access","Defender for Cloud","SharePoint Sharing","Storage &amp; RBAC"]'>Azure Tenant</span><span class="cs-hero-rotator-caret" aria-hidden="true"></span></span>
              </h1>

              <p class="text text-center cs-hero-fade" style="animation-delay: 0.4s; max-width:720px; margin:0 auto;">
                Most UAE mid-market organisations run their entire business on Azure and Microsoft 365 — and most haven't
                configured security beyond the default Conditional Access policy. We find the
                <strong>10 – 30 high-severity misconfigurations</strong> hiding in your tenant and fix them in 1 – 2 weeks.
              </p>
            </div>

            <!-- Dual CTA -->
            <div class="cs-hero-cta-row cs-hero-fade" style="animation-delay: 0.55s">
              <a href="/#contact" class="cs-hero-btn cs-hero-btn-primary">
                <span>Talk to us</span>
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M1.5 7.5h12M8 2l5.5 5.5L8 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="https://wa.me/971505670394?text=Hi%2C%20I%27d%20like%20a%20cloud%20security%20assessment%20quote"
                 target="_blank" rel="noopener"
                 class="cs-hero-btn cs-hero-btn-secondary"
                 aria-label="Open WhatsApp chat for a cloud security quote">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.464 3.488"/>
                </svg>
                <span>WhatsApp us</span>
              </a>
            </div>

            <!-- Microtrust -->
            <p class="cs-hero-microtrust cs-hero-fade" style="animation-delay: 0.7s">
              <span>Azure Security &amp; CDSA-certified lead</span>
              <span class="cs-hero-microtrust-dot" aria-hidden="true">·</span>
              <span>30-day free retest of high-severity fixes</span>
              <span class="cs-hero-microtrust-dot" aria-hidden="true">·</span>
              <span>Read-only access — zero disruption</span>
            </p>

            <!-- Stats strip with count-up -->
            <div class="cs-hero-stats cs-hero-fade" style="animation-delay: 0.85s">
              <div class="cs-hero-stat">
                <span class="cs-hero-stat-num" data-target="24" data-suffix="h">0h</span>
                <span class="cs-hero-stat-label">Quote Turnaround</span>
              </div>
              <div class="cs-hero-stat">
                <span class="cs-hero-stat-num" data-target="14" data-suffix="d">0d</span>
                <span class="cs-hero-stat-label">Typical Delivery</span>
              </div>
              <div class="cs-hero-stat">
                <span class="cs-hero-stat-num" data-target="30" data-suffix="d">0d</span>
                <span class="cs-hero-stat-label">Free Retest</span>
              </div>
              <div class="cs-hero-stat">
                <span class="cs-hero-stat-num" data-target="100" data-suffix="%">0%</span>
                <span class="cs-hero-stat-label">CIS Mapped</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Methodology ribbon -->
        <div class="cs-method-ribbon cs-hero-fade" style="animation-delay: 1s">
          <span class="cs-method-label">Methodology</span>
          <span class="cs-method-chip">CIS Azure Benchmark</span>
          <span class="cs-method-chip">CIS M365 Benchmark</span>
