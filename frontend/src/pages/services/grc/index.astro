---
// ===========================================
// CATEGORY HUB — Cybersecurity GRC
// flagship services
// Underwings Cybersecurity Solutions
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';

// Y1 flagship services
// hasPage: true = dedicated service page exists (Phase 3 anchor)
// hasPage: false = book-via-contact (Phase 3 deferred / Month 2)
const flagship = [
  {
    slug: "iso-27001-implementation",
    title: "ISO 27001 Implementation & Certification Support",
    tagline: "End-to-end from policy authoring to accredited-body audit.",
    certs: ["ISO 27001 LA", "GRC Mastery"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/iso-27001-implementation",
  },
  {
    slug: "iso-27001-gap-assessment",
    title: "ISO 27001 Gap Assessment",
    tagline: "Current-state assessment + prioritised remediation roadmap.",
    certs: ["ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/iso-27001-gap-assessment",
  },
  {
    slug: "nesa-uae-ia",
    title: "NESA / UAE IA V2 Gap Assessment",
    tagline: "UAE national standards — full controls assessment for govt-adjacent clients.",
    certs: ["GRC Mastery", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/nesa-uae-ia",
  },
  {
    slug: "uae-pdpl-advisory",
    title: "UAE PDPL Compliance Advisory",
    tagline: "Data mapping, privacy notices, consent, breach-notification process.",
    certs: ["GRC Mastery", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/uae-pdpl-advisory",
  },
  {
    slug: "adhics-compliance",
    title: "ADHICS v2 Compliance — Abu Dhabi Healthcare",
    tagline: "DoH-mandated healthcare standard — gap assessment, remediation, Malaffi-readiness.",
    price: "AED 16,000 – 42,000",
    certs: ["GRC Mastery", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/adhics-compliance",
  },
  {
    slug: "risk-assessment-register",
    title: "Risk Assessment & Risk Register Build",
    tagline: "ISO 27005-aligned, quantitative where appropriate. Standalone or ISO 27001 sub-deliverable.",
    certs: ["GRC Mastery", "ISO 27001 LA"],
    lead: "Manoj Prabhakaran",
    hasPage: true,
    href: "/services/grc/risk-assessment-register",
  },
];

// Mirrors the EXISTING visible FAQ section below (schema only — no content change).
// Powers FAQPage rich results + AI-answer eligibility.
const faqs = [
  { q: "Are you also the auditor? Isn't that a conflict of interest?", a: "No — and we never will be. We are the implementer. The certificate is issued by an accredited certification body (DNV, BSI, BV, Intertek, TÜV — your choice). This separation is required by ISO/IEC 17021 and we keep it absolute. We'll happily make the introduction to a certifier we trust." },
  { q: "How long does ISO 27001 take from kickoff to certification?", a: "Typical SME path: 4–6 months end-to-end. Gap assessment (2–3 weeks), implementation including risk register, SoA, policies and controls (8–12 weeks), internal audit + management review (2 weeks), Stage 1 audit (1 week), remediation, Stage 2 audit (1 week). Larger or multi-site organisations need 6–9 months." },
  { q: "Will you actually do the work, or just hand us templates?", a: "We do the work. Policies are authored to fit your business — not generic boilerplate. The risk register is populated from interviews and asset inventories we run with your team. Controls are configured in your systems, not ticked on a spreadsheet. The deliverable is operational evidence, not paperwork." },
  { q: "We need ISO 27001 + UAE PDPL + NESA — can you do all three together?", a: "Yes — and you should. There's around 70% control overlap between ISO 27001 Annex A, UAE IA V2 and PDPL. We deliver a unified control set mapped against all three frameworks, so you implement once and evidence three times. Adding ADHICS v2 or PCI DSS is a matter of mapping, not duplicate effort." },
  { q: "What if our scope changes mid-project (acquisition, new region, new product)?", a: "Scope changes are normal. Every engagement has a written change-control clause: small additions are absorbed, larger ones get a transparent change-order with adjusted timeline and fee — no surprise invoices. The certification scope statement can be drafted to cover anticipated growth." },
  { q: "Do you provide ongoing support after certification?", a: "Yes. After Stage 2, most clients move onto a maintenance retainer covering surveillance audit prep, internal audits, management reviews, policy updates, control re-tests, and evidence pack curation — billed monthly or per surveillance cycle, so you stay certified without re-running an implementation project every year." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Cybersecurity GRC", "item": "https://underwings.org/services/grc" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Cybersecurity GRC Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": s.title,
      "url": `https://underwings.org${s.href}`
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="GRC Services UAE — ISO 27001, NESA, PDPL | Underwings"
  description="UAE cybersecurity GRC services by an ISO 27001 Lead Auditor. ISO 27001 gap + implementation, NESA / UAE IA V2, UAE PDPL advisory, risk register, managed continuous compliance. Partner-issued certification."
  keywords="ISO 27001 UAE, NESA gap assessment, UAE PDPL advisory, cybersecurity GRC Dubai, ISO 27001 consultant UAE, risk assessment UAE"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Fragment slot="head">
    <style is:inline>
      .grc-hero-fade { animation: grcHeroFadeIn 0.8s ease-out both; animation-delay: 0.5s; }
      @keyframes grcHeroFadeIn {
        from { filter: blur(3px); opacity: 0; transform: translateY(1rem); }
        to   { filter: blur(0);   opacity: 1; transform: translateY(0); }
      }

      .grc-hero-wrap { position: relative; overflow: hidden; }
      .grc-hero-wrap .hero-heading-wrapper {
        display: flex; flex-direction: column; align-items: center; gap: 1.1rem;
      }
      .grc-hero-wrap .hero-heading-wrapper > * { margin: 0; }
      .grc-hero-wrap .heading-large.hero-heading-large {
        line-height: 1.05; letter-spacing: -0.035em;
      }

      .grc-hero-eyebrow {
        display: inline-flex; align-items: center; gap: 0.55rem;
        padding: 0.4rem 0.95rem; border-radius: 100px;
        background: rgba(36,215,88,0.06);
        border: 1px solid rgba(36,215,88,0.22);
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: #24d758;
      }
      .grc-hero-pulse {
        width: 7px; height: 7px; border-radius: 50%; background: #24d758;
        box-shadow: 0 0 0 0 rgba(36,215,88,0.55);
        animation: grcHeroPulse 2.2s ease-out infinite;
      }
      @keyframes grcHeroPulse {
        0%   { box-shadow: 0 0 0 0 rgba(36,215,88,0.55); opacity: 1; }
        70%  { box-shadow: 0 0 0 10px rgba(36,215,88,0); opacity: 0.7; }
        100% { box-shadow: 0 0 0 0 rgba(36,215,88,0); opacity: 1; }
      }

      .grc-hero-rotator {
        position: relative; display: inline-block;
        vertical-align: baseline; white-space: nowrap;
      }
      .grc-hero-rotator-word {
        display: inline-block;
        background: linear-gradient(90deg, #24d758 0%, #27dab4 100%);
        -webkit-background-clip: text; background-clip: text;
        -webkit-text-fill-color: transparent; color: transparent;
        transition: text-shadow 0.25s ease;
      }
      .grc-hero-rotator.is-typing .grc-hero-rotator-word,
      .grc-hero-rotator.is-deleting .grc-hero-rotator-word {
        text-shadow: 0 0 22px rgba(36,215,88,0.25);
      }
      .grc-hero-rotator-caret {
        display: inline-block; width: 2px; height: 0.95em;
        margin-left: 4px;
        background: linear-gradient(180deg, #24d758, #27dab4);
        vertical-align: -0.08em; border-radius: 2px;
        box-shadow: 0 0 10px rgba(36,215,88,0.6);
        animation: grcHeroCaretBlink 0.9s ease-in-out infinite;
      }
      .grc-hero-rotator.is-typing .grc-hero-rotator-caret,
      .grc-hero-rotator.is-deleting .grc-hero-rotator-caret {
        animation: none; opacity: 1;
      }
      @keyframes grcHeroCaretBlink {
        0%, 49%   { opacity: 1; }
        50%, 100% { opacity: 0.15; }
      }
      @media (max-width: 560px) {
        .grc-hero-rotator { white-space: normal; }
      }

      .grc-hero-cta-row {
        display: flex; gap: 0.75rem; justify-content: center;
        flex-wrap: wrap; margin-top: 1.75rem;
      }
      .grc-hero-btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.85rem 1.5rem; border-radius: 10px;
        font-size: 0.92rem; font-weight: 600; letter-spacing: -0.005em;
        text-decoration: none; border: 1px solid transparent; cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
        font-family: inherit;
      }
      .grc-hero-btn-primary {
        background: linear-gradient(135deg, #24d758, #27dab4); color: #0a0a0a;
        box-shadow: 0 4px 18px rgba(36,215,88,0.18);
      }
      .grc-hero-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(36,215,88,0.28); }
      .grc-hero-btn-secondary {
        background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.15);
      }
      .grc-hero-btn-secondary:hover { background: rgba(36,215,88,0.06); border-color: rgba(36,215,88,0.35); }
      .grc-hero-btn svg { transition: transform 0.2s ease; }
      .grc-hero-btn:hover svg { transform: translateX(3px); }

      .grc-hero-microtrust {
        display: flex; align-items: center; justify-content: center;
        gap: 0.55rem; margin: 1rem 0 0; font-size: 0.8rem;
        color: rgba(255,255,255,0.48); flex-wrap: wrap;
      }
      .grc-hero-microtrust-dot { color: rgba(255,255,255,0.2); }

      .grc-hero-stats {
        display: grid; grid-template-columns: repeat(4, 1fr);
        gap: 1rem; margin: 2.25rem auto 0; max-width: 780px;
        padding: 1.25rem 1.75rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px; position: relative; overflow: hidden;
      }
      .grc-hero-stats::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse at top, rgba(36,215,88,0.06) 0%, transparent 65%);
        pointer-events: none;
      }
      .grc-hero-stat { display: flex; flex-direction: column; gap: 0.15rem; align-items: center; text-align: center; position: relative; z-index: 1; }
      .grc-hero-stat-num {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 1.35rem; font-weight: 700; color: #24d758;
        letter-spacing: -0.01em; font-variant-numeric: tabular-nums;
      }
      .grc-hero-stat-label {
        font-size: 0.7rem; color: rgba(255,255,255,0.5);
        text-transform: uppercase; letter-spacing: 0.08em;
      }
      @media (max-width: 720px) {
        .grc-hero-stats { grid-template-columns: repeat(2, 1fr); gap: 0.9rem 0.5rem; padding: 1rem; }
        .grc-hero-stat-num { font-size: 1.15rem; }
      }

      .grc-hero-grid {
        position: absolute; inset: 0;
        background-image:
          linear-gradient(rgba(36,215,88,0.045) 1px, transparent 1px),
          linear-gradient(90deg, rgba(36,215,88,0.045) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
        pointer-events: none; z-index: 0;
        animation: grcHeroGridDrift 24s linear infinite;
      }
      @keyframes grcHeroGridDrift {
        from { background-position: 0 0, 0 0; }
        to   { background-position: 56px 56px, 56px 56px; }
      }
      .grc-hero-orb {
        position: absolute; width: 520px; height: 520px;
        top: -180px; left: 50%; transform: translateX(-50%);
        background: radial-gradient(circle, rgba(36,215,88,0.08) 0%, rgba(36,215,88,0.02) 35%, transparent 65%);
        filter: blur(20px); pointer-events: none; z-index: 0;
        animation: grcHeroOrbDrift 9s ease-in-out infinite;
      }
      @keyframes grcHeroOrbDrift {
        0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.85; }
        50%      { transform: translateX(-50%) translateY(18px); opacity: 1; }
      }

      .grc-hero-wrap .crumbs { position: relative; z-index: 1; }

      .grc-method-ribbon {
        display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
        gap: 0.5rem; margin-top: 2.25rem; padding: 0 1rem;
        position: relative; z-index: 1;
      }
      .grc-method-label {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: rgba(255,255,255,0.4); margin-right: 0.5rem;
      }
      .grc-method-chip {
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.04em;
        padding: 0.35rem 0.7rem; border-radius: 6px;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.1);
        color: rgba(255,255,255,0.7);
      }

      /* FAQ */
      .grc-faq-list { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 0.75rem; }
      .grc-faq-item {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        transition: border-color 0.2s ease;
      }
      .grc-faq-item:hover { border-color: rgba(255,255,255,0.16); }
      .grc-faq-item[open] { border-color: rgba(36,215,88,0.25); }
      .grc-faq-q {
        list-style: none; cursor: pointer;
        padding: 1.1rem 1.5rem; font-size: 0.95rem; font-weight: 500; color: #fff;
        display: flex; align-items: center; justify-content: space-between; gap: 1rem;
        -webkit-tap-highlight-color: transparent;
      }
      .grc-faq-q::-webkit-details-marker { display: none; }
      .grc-faq-icon { color: rgba(255,255,255,0.5); transition: transform 0.25s ease, color 0.2s ease; flex-shrink: 0; }
      .grc-faq-item[open] .grc-faq-icon { transform: rotate(180deg); color: #24d758; }
      .grc-faq-a { padding: 0 1.5rem 1.25rem; color: rgba(255,255,255,0.72); font-size: 0.9rem; line-height: 1.65; }

      @media (max-width: 479px) {
        .grc-faq-q { padding: 1rem 1.1rem; font-size: 0.9rem; }
        .grc-faq-a { padding: 0 1.1rem 1rem; font-size: 0.85rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .grc-hero-fade, .grc-hero-pulse, .grc-hero-orb, .grc-hero-grid,
        .grc-hero-rotator-word, .grc-hero-rotator-caret {
          animation: none !important;
        }
        .grc-hero-fade { opacity: 1; filter: none; transform: none; }
      }

      /* ── Managed GRC — Continuous Compliance ─────────────────── */
      #managed-grc { scroll-margin-top: 96px; }

      .mgrc-eyebrow {
        display: inline-flex; align-items: center; gap: 0.55rem;
        padding: 0.4rem 0.95rem; border-radius: 100px;
        background: rgba(36,215,88,0.06);
        border: 1px solid rgba(36,215,88,0.22);
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.72rem; letter-spacing: 0.14em;
        text-transform: uppercase; color: #24d758;
        margin-bottom: 0.9rem;
      }

      .mgrc-grid {
        display: grid; grid-template-columns: repeat(2, 1fr);
        gap: 1rem; width: 100%;
      }
      @media (max-width: 860px) { .mgrc-grid { grid-template-columns: 1fr; } }

      .mgrc-card {
        position: relative; overflow: hidden;
        display: flex; flex-direction: column; gap: 1.1rem;
        padding: 1.5rem 1.6rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 14px;
        transition: border-color 200ms ease, transform 200ms ease, box-shadow 240ms ease;
      }
      .mgrc-card::before {
        content: ''; position: absolute; inset: 0;
        background: radial-gradient(ellipse at top left, rgba(36,215,88,0.05) 0%, transparent 60%);
        pointer-events: none;
      }
      .mgrc-card > * { position: relative; z-index: 1; }
      .mgrc-card:hover {
        transform: translateY(-2px);
        border-color: rgba(36,215,88,0.35);
        box-shadow: 0 18px 40px -22px rgba(36,215,88,0.28);
      }
      @media (prefers-reduced-motion: reduce) {
        .mgrc-card, .mgrc-card:hover { transform: none; transition: none; }
      }

      .mgrc-cadence {
        display: flex; align-items: center; gap: 0.75rem;
        font-family: 'Geist Mono', ui-monospace, monospace;
        font-size: 0.68rem; letter-spacing: 0.18em;
        text-transform: uppercase; color: #24d758;
      }
      .mgrc-cadence::after {
        content: ''; flex: 1; height: 1px;
        background: linear-gradient(90deg, rgba(36,215,88,0.35), transparent);
      }

      .mgrc-item + .mgrc-item {
        margin-top: 1.1rem; padding-top: 1.1rem;
        border-top: 1px dashed rgba(255,255,255,0.09);
      }
      .mgrc-item-title {
        margin: 0 0 0.35rem; font-size: 0.98rem; font-weight: 600;
        color: #fff; letter-spacing: -0.01em;
      }
      .mgrc-item-desc {
        margin: 0; font-size: 0.9rem; line-height: 1.65;
        color: rgba(255,255,255,0.68);
      }

      .mgrc-foot {
        display: flex; align-items: center; justify-content: space-between;
        gap: 1.25rem 2rem; flex-wrap: wrap; width: 100%;
        margin-top: 0.25rem; padding: 1.25rem 1.6rem;
        background: rgba(36,215,88,0.045);
        border: 1px solid rgba(36,215,88,0.18);
        border-radius: 14px;
      }
      .mgrc-foot-note {
        margin: 0; max-width: 620px;
        font-size: 0.88rem; line-height: 1.6;
        color: rgba(255,255,255,0.62);
      }
      .mgrc-foot-note a { color: #37dc82; text-decoration: underline; }
    </style>
  </Fragment>

  <Header currentPage="services" />

  <main id="main" class="main">

    <!-- Breadcrumb + Animated Hero -->
    <section class="section bottom-padding-clear top-padding-small grc-hero-wrap">
      <div class="grc-hero-grid" aria-hidden="true"></div>
      <div class="grc-hero-orb" aria-hidden="true"></div>
      <div class="container-medium" style="position: relative; z-index: 1;">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">›</span>
          <a href="/services">Services</a>
          <span aria-hidden="true">›</span>
          <span class="crumbs-current">Cybersecurity GRC</span>
        </nav>

        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <span class="grc-hero-eyebrow grc-hero-fade">
                <span class="grc-hero-pulse" aria-hidden="true"></span>
                GRC · ISO 27001 LA-led Implementation
              </span>

              <h1 class="heading-large hero-heading-large grc-hero-fade" style="animation-delay: 0.2s">
                Implementation, not advice — for<br><span class="grc-hero-rotator" aria-live="polite"><span class="grc-hero-rotator-word" data-rotate='["ISO 27001 Certification","NESA / UAE IA V2","UAE PDPL Readiness","ADHICS Compliance","Risk Register Build","Dubai ISR v2","PCI DSS v4.0"]'>ISO 27001 Certification</span><span class="grc-hero-rotator-caret" aria-hidden="true"></span></span>
              </h1>

              <p class="text text-center grc-hero-fade" style="animation-delay: 0.4s; max-width:720px; margin:0 auto;">
                ISO 27001, NESA / UAE IA V2, PDPL, ADHICS, and formal risk programs — delivered hands-on by an
                <strong>ISO 27001 Lead Auditor</strong>. We implement. Accredited certification bodies certify.
                <strong>Never both.</strong> No conflict of interest, ever.
              </p>
            </div>

            <div class="grc-hero-cta-row grc-hero-fade" style="animation-delay: 0.55s">
              <a href="/#contact" class="grc-hero-btn grc-hero-btn-primary">
                <span>Talk to us</span>
                <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                  <path d="M1.5 7.5h12M8 2l5.5 5.5L8 13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href="https://wa.me/971547078203?text=Hi%2C%20I%27d%20like%20to%20discuss%20a%20GRC%20%2F%20ISO%2027001%20program"
                 target="_blank" rel="noopener"
                 class="grc-hero-btn grc-hero-btn-secondary"
                 aria-label="Open WhatsApp chat for a GRC quote">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
