---
// ============================================================
// SERVICE PAGE — NESA / UAE IA V2 Gap Assessment
// Category: GRC (Y1 Flagship — UAE differentiator, govt-adjacent)
// ============================================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/service-page.css';

const faqs = [
  { q: "What's the difference between NESA and UAE IA V2?", a: "UAE IA (Information Assurance) Standard V2 is the current national standard, issued by the Signals Intelligence Agency (SIA, formerly NESA — the National Electronic Security Authority). People still use \"NESA\" colloquially for the framework. V2 is the updated version that most UAE critical-sector and government-adjacent entities are now being assessed against." },
  { q: "Does NESA apply to my organisation?", a: "If you're a critical-information-infrastructure entity, a government entity, or a supplier to either, yes — directly. If you're in the broader UAE business ecosystem, NESA increasingly appears in enterprise procurement as a posture question. Even when not directly mandated, NESA alignment is often a differentiator." },
  { q: "What's the difference between NESA and ISO 27001?", a: "ISO 27001 is an international voluntary certification covering ISMS management. NESA / UAE IA V2 is a UAE national standard with specific controls designed for critical-infrastructure and government-adjacent entities. Significant overlap with ISO 27001 exists (~50 – 60%), but NESA has UAE-specific controls around cross-border data, national security, and supply-chain assurance that ISO 27001 doesn't explicitly cover." },
  { q: "Do you get us certified?", a: "NESA / UAE IA V2 isn't a certification in the ISO sense — it's compliance assessed by the issuing authority or an authorised auditor against the standard's controls. We deliver the <strong>gap assessment</strong> and remediation roadmap; formal assessment against the standard is conducted by designated auditors. Where applicable we support your authorised-auditor engagement." },
  { q: "How long does the gap assessment take?", a: "3 – 4 weeks end-to-end for a typical mid-market organisation. Larger or multi-entity engagements extend to 5 – 6 weeks. The controls framework is deep — we don't rush coverage." },
  { q: "Can you combine this with ISO 27001 Gap?", a: "Yes — and many clients do. Running both assessments in parallel is materially more efficient than sequential engagements because interview and documentation work overlaps significantly. Ask us about the combined engagement during scoping — you'll get a written quote within 48 hours of the scoping call." },
  { q: "What evidence do you produce?", a: "A controls-by-controls assessment report with maturity rating and gap severity, a prioritised remediation roadmap, an executive summary, and a mapping document showing where existing ISO 27001 / CIS / NIST controls already satisfy NESA requirements (avoiding duplicate work)." },
  { q: "Do you cover ADHICS and Dubai ISR too?", a: "ADHICS (Abu Dhabi healthcare) is scoped separately — similar framework, sector-specific controls. Dubai ISR v2 is on our roadmap and will be added when our Dubai-government engagement pipeline justifies it." },
];

const schema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
    { "@type": "ListItem", "position": 3, "name": "Cybersecurity GRC", "item": "https://underwings.org/services/grc" },
    { "@type": "ListItem", "position": 4, "name": "NESA / UAE IA V2 Gap Assessment", "item": "https://underwings.org/services/grc/nesa-uae-ia" }
  ]},
  { "@context": "https://schema.org", "@type": "Service", "name": "NESA / UAE IA V2 Gap Assessment", "serviceType": "UAE IA V2 Gap Assessment",
    "provider": { "@type": "Organization", "name": "Underwings Cybersecurity Solutions", "url": "https://underwings.org" },
    "areaServed": { "@type": "Country", "name": "United Arab Emirates" },
    "description": "NESA / UAE Information Assurance Standard V2 gap assessment — controls-by-controls review, maturity ratings, prioritised roadmap. GRC Mastery + ISO 27001 LA led.",
    "url": "https://underwings.org/services/grc/nesa-uae-ia"
  },
  { "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="NESA / UAE IA V2 Gap Assessment | Underwings"
  description="UAE IA V2 / NESA gap assessment for government-adjacent entities, critical infrastructure, and suppliers. Controls review, maturity rating, prioritised roadmap. Written quote within 48 hours of a scoping call."
  keywords="NESA gap assessment UAE, UAE IA V2 compliance, NESA consultant UAE, UAE Information Assurance Standard, SIA compliance UAE, critical infrastructure security UAE"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <section class="section bottom-padding-clear top-padding-small">
