---
// ============================================================
// SERVICE PAGE — ADHICS v2 Compliance (Abu Dhabi Healthcare)
// Category: GRC (Y1 Flagship — UAE differentiator, healthcare vertical)
// ============================================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/service-page.css';

const faqs = [
  { q: "What is ADHICS?", a: "ADHICS is the <strong>Abu Dhabi Healthcare Information and Cyber Security Standard</strong>, issued by the Department of Health – Abu Dhabi (DoH). It's the mandatory information-security framework for healthcare entities operating in the Emirate of Abu Dhabi. The current version is <strong>ADHICS v2</strong>. It defines management and security controls that providers, payers, and other DoH-licensed entities must implement to protect health information." },
  { q: "Does ADHICS apply to my organisation?", a: "If you're a DoH-licensed healthcare entity in Abu Dhabi — a hospital, clinic, day-surgery centre, diagnostic lab, pharmacy, insurer/payer, or a health-IT provider handling patient data — ADHICS applies to you directly. It's a licensing and operational requirement, not optional. Entities connecting to <strong>Malaffi</strong> (the Abu Dhabi Health Information Exchange) must demonstrate ADHICS alignment as a condition of integration." },
  { q: "What's the difference between ADHICS and ISO 27001?", a: "ISO 27001 is an international, voluntary ISMS certification. ADHICS is an Abu Dhabi <strong>mandatory</strong> healthcare standard with sector-specific controls around health information, medical systems, and DoH governance. There's significant overlap (~60 – 70%) with ISO 27001 Annex A — so existing ISO work accelerates ADHICS — but ADHICS adds healthcare-specific requirements ISO doesn't cover, and applies whether or not you hold ISO 27001." },
  { q: "Is ADHICS the same as HIPAA?", a: "No. HIPAA is a US law. ADHICS is the Abu Dhabi standard and is the framework DoH assesses you against locally. There's conceptual overlap (both protect health information), but mapping US HIPAA controls to ADHICS is exactly the kind of gap work we do — the control structure, classifications, and evidence expectations differ." },
  { q: "Do you get us compliant, or certified?", a: "ADHICS compliance is assessed by the <strong>Department of Health – Abu Dhabi</strong> (or its designated auditors) against the standard's controls — it isn't an ISO-style certificate. We deliver the <strong>gap assessment, remediation, and evidence pack</strong> that get you to a compliant, assessment-ready state. Where a formal DoH submission or audit is required, we prepare you for it and support the process." },
  { q: "How long does the ADHICS gap assessment take?", a: "3 – 5 weeks end-to-end for a typical single-facility provider. Multi-facility groups or hospitals with complex clinical systems extend to 6 – 8 weeks. Healthcare environments carry more in-scope systems (EMR, PACS, LIS, medical devices), so we don't compress coverage." },
  { q: "Can you combine ADHICS with ISO 27001 or PDPL?", a: "Yes — and most healthcare clients should. ISO 27001 Annex A, ADHICS v2, and UAE PDPL share a large control base. We deliver a <strong>unified control set</strong> mapped across all three, so you implement once and evidence against each framework — 15 – 20% cheaper than running them sequentially." },
  { q: "What evidence do you produce?", a: "A controls-by-controls assessment against the applicable ADHICS v2 domains with maturity rating and gap severity, a prioritised remediation roadmap, an executive summary for the board / medical director, and a cross-framework mapping showing where existing ISO 27001 / NIST / CIS controls already satisfy ADHICS (so you don't rebuild what's done)." },
];

const schema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
    { "@type": "ListItem", "position": 3, "name": "Cybersecurity GRC", "item": "https://underwings.org/services/grc" },
    { "@type": "ListItem", "position": 4, "name": "ADHICS v2 Compliance", "item": "https://underwings.org/services/grc/adhics-compliance" }
  ]},
  { "@context": "https://schema.org", "@type": "Service", "name": "ADHICS v2 Compliance & Gap Assessment", "serviceType": "ADHICS Healthcare Compliance",
    "provider": { "@type": "Organization", "name": "Underwings Cybersecurity Solutions", "url": "https://underwings.org" },
    "areaServed": { "@type": "Country", "name": "United Arab Emirates" },
    "audience": { "@type": "Audience", "audienceType": "Abu Dhabi healthcare providers, payers, and health-IT entities" },
    "offers": { "@type": "AggregateOffer", "priceCurrency": "AED", "lowPrice": "16000", "highPrice": "42000" },
    "description": "ADHICS v2 (Abu Dhabi Healthcare Information and Cyber Security Standard) gap assessment and remediation — controls-by-controls review, maturity ratings, prioritised roadmap, DoH assessment-readiness. GRC Mastery + ISO 27001 LA led.",
    "url": "https://underwings.org/services/grc/adhics-compliance"
  },
  { "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="ADHICS v2 Compliance UAE — Abu Dhabi Healthcare | Underwings"
  description="ADHICS v2 gap assessment & compliance for Abu Dhabi healthcare providers, payers, and health-IT entities. DoH-aligned controls review, remediation roadmap, Malaffi-readiness. AED 16,000 – 42,000."
  keywords="ADHICS compliance, ADHICS v2, Abu Dhabi healthcare cybersecurity, DoH ADHICS, ADHICS gap assessment UAE, Malaffi security compliance, healthcare data protection Abu Dhabi"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/services">Services</a><span aria-hidden="true">›</span>
