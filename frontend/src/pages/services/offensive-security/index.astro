---
// ===========================================
// CATEGORY HUB — Offensive Security
// PTES / OWASP-aligned. Pre-engagement-first structure.
// flagship services
// ===========================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/offensive-hub.css';

const flagship = [
  {
    slug: "network-penetration-testing",
    title: "Network Penetration Testing",
    tagline: "External + internal + Active Directory + lateral movement. PTES-aligned, manual, exploit-driven.",
    methodology: "PTES · NIST SP 800-115",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/network-penetration-testing",
  },
  {
    slug: "web-application-penetration-testing",
    title: "Web Application Penetration Testing",
    tagline: "OWASP Top 10, API security, authentication flaws, business-logic testing.",
    methodology: "OWASP WSTG · API Top 10",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/web-application-penetration-testing",
  },
  {
    slug: "mobile-application-penetration-testing",
    title: "Mobile Application Penetration Testing",
    tagline: "iOS and Android — static + dynamic, Frida runtime instrumentation, MASVS-mapped.",
    methodology: "OWASP MASTG · MASVS",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/mobile-application-penetration-testing",
    isNew: true,
  },
  {
    slug: "phishing-simulation",
    title: "Phishing Simulation & Social Engineering",
    tagline: "Controlled phishing and vishing campaigns with click-rate reporting. Before/after metric for awareness training.",
    methodology: "PTES Pre-engagement · NIST SP 800-115",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/phishing-simulation",
  },
  {
    slug: "vulnerability-assessment",
    title: "Vulnerability Assessment (VA only)",
    tagline: "Scan-and-prioritise service for SMEs not ready for full pen testing. Fast, affordable, actionable.",
    methodology: "NIST SP 800-115",
    lead: "Nelson Durairaj",
    hasPage: true,
    href: "/services/offensive-security/vulnerability-assessment",
  },
];

// PTaaS — folded into this hub as a dedicated section (standalone page retired)
const ptaas = {
  features: [
    { title: "Continuous testing cadence", desc: "Monthly OSCP-led testing sprints across your agreed scope — not a once-a-year snapshot that goes stale." },
    { title: "Live findings portal", desc: "Findings published as they're validated, with CVSS scores, PoC evidence, and remediation guidance." },
    { title: "On-demand retests", desc: "Fixed a finding? Request a retest from the portal and get validation within days, not next year's engagement." },
    { title: "Annual deep-dive included", desc: "A full-scope PTES engagement once per subscription year, with the complete audit-grade report pack." },
    { title: "Audit-ready evidence", desc: "Rolling penetration-test evidence for ISO 27001 Annex A 8.8, UAE IA, ADHICS, PCI DSS, and SOC 2 — always current." },
    { title: "Named practitioner team", desc: "Led by Nelson Durairaj (OSCP, eJPT, CEH), supervised by Manoj Prabhakaran (CPTS, CDSA). Same team every sprint." },
  ],
};

// PTES + HTB-aligned 8-stage process (client-facing adaptation)
const stages = [
  { num: "01", name: "Pre-Engagement", desc: "NDA, scoping workshop, rules of engagement, timeline, deliverable lock. We educate, you choose scope.", clientFacing: true },
  { num: "02", name: "Information Gathering", desc: "Passive + active reconnaissance. OSINT, enumeration, technology fingerprinting, attack-surface mapping." },
  { num: "03", name: "Vulnerability Assessment", desc: "Automated + manual analysis. Known CVE sweep, configuration review, version analysis, attack-vector hypothesis." },
  { num: "04", name: "Exploitation", desc: "Controlled execution of attack paths. Every exploit documented, every action reversible." },
  { num: "05", name: "Post-Exploitation", desc: "Privilege escalation, impact demonstration, pillaging for sensitive data. We show what an attacker would actually get." },
  { num: "06", name: "Lateral Movement", desc: "If in scope — pivot through the environment, chain access, demonstrate breach spread. Internal network engagements only." },
  { num: "07", name: "Proof-of-Concept", desc: "Reproducible evidence for every finding. Screenshots, scripts, step-by-step. No unverifiable claims." },
  { num: "08", name: "Post-Engagement", desc: "Executive summary, technical report, live walkthrough, clean-up evidence, free 30-day retest of critical/high fixes.", clientFacing: true },
];

// Scope chips — what client can include in engagement
const scopes = [
  { key: "network-ext", label: "External Network", desc: "Internet-exposed infrastructure, perimeter", href: "/services/offensive-security/network-penetration-testing" },
  { key: "network-int", label: "Internal Network", desc: "Corporate LAN, Active Directory, lateral movement", href: "/services/offensive-security/network-penetration-testing" },
  { key: "webapp", label: "Web Application", desc: "OWASP WSTG — authenticated, business logic", href: "/services/offensive-security/web-application-penetration-testing" },
  { key: "mobile", label: "Mobile App (iOS / Android)", desc: "OWASP MASTG — static + dynamic + runtime", href: "/services/offensive-security/mobile-application-penetration-testing", isNew: true },
  { key: "api", label: "API", desc: "OWASP API Top 10 — REST, GraphQL, SOAP", href: "/services/offensive-security/web-application-penetration-testing" },
  { key: "wireless", label: "Wireless", desc: "WiFi, rogue-AP, Evil Twin, WPA2/3 weaknesses", href: "#scoping" },
  { key: "phishing", label: "Phishing & Social Engineering", desc: "Email, SMS, vishing — realistic attacker simulation", href: "/services/offensive-security/phishing-simulation" },
  { key: "cloud", label: "Cloud Configuration", desc: "AWS, Azure, GCP — IAM, misconfig, privilege paths", href: "/services/cloud-security" },
  { key: "va-only", label: "VA only (budget)", desc: "Scan + prioritise. Compliance box-check, not a pen test", href: "/services/offensive-security/vulnerability-assessment" },
];

// Compliance framework → required/recommended scope mapping
const compliance = [
  { framework: "ISO 27001 (Annex A 8.8)", required: "VA + annual pen test", recommended: "External network + primary web app", link: "/services/grc/iso-27001-implementation" },
  { framework: "UAE IA (T3.6.1)", required: "External + internal pen test", recommended: "+ phishing simulation + wireless", link: "/services/grc" },
  { framework: "ADHICS v2 (Healthcare UAE)", required: "Annual pen test", recommended: "+ mobile app (if patient-facing) + PHI systems", link: "/services/grc" },
  { framework: "PCI DSS 11.3", required: "Internal + external pen test", recommended: "+ segmentation testing + web app (if CDE)", link: "/services/grc" },
  { framework: "SOC 2 (CC7.1)", required: "Annual pen test", recommended: "External network + web app + API", link: "/services/grc" },
];

// Hub-level FAQ — answer-first, high commercial-intent. Powers FAQPage rich
// results + AI-answer citations. Additive: does not alter any existing copy.
const faqs = [
  { q: "How much does penetration testing cost in the UAE?", a: "Cost depends on scope — the number and type of assets, whether internal networks and Active Directory are included, and the compliance context. After a free 30-minute scoping call, you receive a written, fixed-scope quote within 48 hours. No hourly billing, no scope creep." },
  { q: "What's the difference between a vulnerability assessment and a penetration test?", a: "A vulnerability assessment scans and prioritises known weaknesses — useful as a compliance box-check and triage step. A penetration test is manual: a certified tester actively exploits and chains weaknesses the way a real attacker would, including business-logic flaws scanners can't find. Underwings delivers manual testing aligned to PTES and OWASP, not scanner PDFs." },
  { q: "How long does a penetration test take?", a: "A single web application or small external network is typically 2–3 weeks end-to-end (scoping, testing, reporting, walkthrough). Larger or API-heavy scopes extend to 3–4 weeks. Expedited delivery is available." },
  { q: "Will your penetration test report satisfy ISO 27001, SOC 2, PCI DSS or NESA audits?", a: "Yes. Reports include scope, methodology, dates, named tester credentials, CVSS-scored findings, reproduction steps, remediation guidance, and retest validation — usable as audit evidence for ISO 27001, SOC 2, PCI DSS, HIPAA, NESA, and ADHICS." },
  { q: "Who performs the testing, and what certifications do they hold?", a: "Every engagement is delivered by named, certified practitioners — OSCP, CPTS, CDSA, CEH — with the tester named in the report. No anonymous juniors and no outsourcing." },
  { q: "Is a retest included after we fix the findings?", a: "Yes. One free retest of critical and high findings within 30 days of the final report is included on Essentials and above, with a separate report confirming remediation." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Offensive Security", "item": "https://underwings.org/services/offensive-security" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Offensive Security Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({
      "@type": "ListItem", "position": i + 1, "name": s.title, "url": `https://underwings.org${s.href}`
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

export const prerender = false;
---

<Layout
  title="Penetration Testing UAE & VAPT Services | Underwings"
  description="UAE penetration testing company: OSCP and CPTS-certified VAPT services aligned to PTES, OWASP and NIST SP 800-115. Free first retest."
  keywords="penetration testing UAE, penetration testing company UAE, VAPT services UAE, VAPT company UAE, cyber security testing UAE, pen test Dubai, network pen test Abu Dhabi, OWASP pentest UAE, mobile app pentest UAE"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Fragment slot="head">
    <style is:inline>
    /* Neon Line Sweep */
    .neon-line-animate { animation: neonFadeIn 0.8s ease-out 0.3s both; }
    .neon-line-animate .neon-line-parent { animation: neonColorIn 1s ease-out 0.6s both; }
    .neon-line-animate .neon-line-inner { transform: translate3d(-50%, 0, 0); animation: neonSweep 3s ease-in-out 0.8s infinite; }
    .neon-line-animate .neon-line-shadow { opacity: 0; animation: neonGlow 3s ease-in-out 0.8s infinite; }
    @keyframes neonFadeIn { from { filter: blur(3px); opacity: 0; } to { filter: blur(0); opacity: 1; } }
    @keyframes neonColorIn { from { filter: grayscale(100%); } to { filter: grayscale(0%); } }
    @keyframes neonSweep { 0% { transform: translate3d(-50%, 0, 0); } 50% { transform: translate3d(0%, 0, 0); } 100% { transform: translate3d(-50%, 0, 0); } }
    @keyframes neonGlow { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.9; } }

    /* Hero blur-fade in */
    .hero-fade-in { animation: heroFadeIn 0.8s ease-out both; animation-delay: 0.5s; }
    @keyframes heroFadeIn {
      from { filter: blur(3px); opacity: 0; transform: translateY(1rem); }
      to   { filter: blur(0);   opacity: 1; transform: translateY(0); }
    }

    .off-hero-wrap { position: relative; overflow: hidden; }
    .off-hero-wrap .hero-heading-wrapper {
      display: flex; flex-direction: column; align-items: center; gap: 1.1rem;
    }
    .off-hero-wrap .hero-heading-wrapper > * { margin: 0; }
    .off-hero-wrap .heading-large.hero-heading-large {
      line-height: 1.05; letter-spacing: -0.035em;
    }

    /* Eyebrow pill */
    .off-hero-eyebrow {
      display: inline-flex; align-items: center; gap: 0.55rem;
      padding: 0.4rem 0.95rem; border-radius: 100px;
      background: rgba(36,215,88,0.06);
      border: 1px solid rgba(36,215,88,0.22);
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.72rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: #24d758;
    }
    .off-hero-pulse {
      width: 7px; height: 7px; border-radius: 50%; background: #24d758;
      box-shadow: 0 0 0 0 rgba(36,215,88,0.55);
      animation: offHeroPulse 2.2s ease-out infinite;
    }
    @keyframes offHeroPulse {
      0%   { box-shadow: 0 0 0 0 rgba(36,215,88,0.55); opacity: 1; }
      70%  { box-shadow: 0 0 0 10px rgba(36,215,88,0); opacity: 0.7; }
      100% { box-shadow: 0 0 0 0 rgba(36,215,88,0); opacity: 1; }
    }

    /* Typewriter rotator */
    .off-hero-rotator {
      position: relative; display: inline-block;
      vertical-align: baseline; white-space: nowrap;
    }
    .off-hero-rotator-word {
      display: inline-block;
      background: linear-gradient(90deg, #24d758 0%, #27dab4 100%);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
      transition: text-shadow 0.25s ease;
    }
    .off-hero-rotator.is-typing .off-hero-rotator-word,
    .off-hero-rotator.is-deleting .off-hero-rotator-word {
      text-shadow: 0 0 22px rgba(36,215,88,0.25);
    }
    .off-hero-rotator-caret {
      display: inline-block; width: 2px; height: 0.95em;
      margin-left: 4px;
      background: linear-gradient(180deg, #24d758, #27dab4);
      vertical-align: -0.08em; border-radius: 2px;
      box-shadow: 0 0 10px rgba(36,215,88,0.6);
      animation: offRotCaretBlink 0.9s ease-in-out infinite;
    }
    .off-hero-rotator.is-typing .off-hero-rotator-caret,
    .off-hero-rotator.is-deleting .off-hero-rotator-caret {
      animation: none; opacity: 1;
    }
    @keyframes offRotCaretBlink {
      0%, 49%   { opacity: 1; }
      50%, 100% { opacity: 0.15; }
    }
    @media (max-width: 560px) {
      .off-hero-rotator { white-space: normal; }
    }

    /* Dual CTA row */
    .off-hero-cta-row {
      display: flex; gap: 0.75rem; justify-content: center;
      flex-wrap: wrap; margin-top: 1.75rem;
    }
    .off-hero-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.85rem 1.5rem; border-radius: 10px;
      font-size: 0.92rem; font-weight: 600; letter-spacing: -0.005em;
      text-decoration: none; border: 1px solid transparent; cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
      font-family: inherit;
    }
    .off-hero-btn-primary {
      background: linear-gradient(135deg, #24d758, #27dab4); color: #0a0a0a;
      box-shadow: 0 4px 18px rgba(36,215,88,0.18);
    }
    .off-hero-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(36,215,88,0.28); }
    .off-hero-btn-secondary {
      background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.15);
    }
    .off-hero-btn-secondary:hover { background: rgba(36,215,88,0.06); border-color: rgba(36,215,88,0.35); }
    .off-hero-btn svg { transition: transform 0.2s ease; }
    .off-hero-btn:hover svg { transform: translateX(3px); }

    /* Microtrust */
    .off-hero-microtrust {
      display: flex; align-items: center; justify-content: center;
      gap: 0.55rem; margin: 1rem 0 0; font-size: 0.8rem;
      color: rgba(255,255,255,0.48); flex-wrap: wrap;
    }
    .off-hero-microtrust-dot { color: rgba(255,255,255,0.2); }

    /* Stats strip */
    .off-hero-stats {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 1rem; margin: 2.25rem auto 0; max-width: 780px;
      padding: 1.25rem 1.75rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px; position: relative; overflow: hidden;
    }
    .off-hero-stats::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse at top, rgba(36,215,88,0.06) 0%, transparent 65%);
      pointer-events: none;
    }
    .off-hero-stat { display: flex; flex-direction: column; gap: 0.15rem; align-items: center; text-align: center; position: relative; z-index: 1; }
    .off-hero-stat-num {
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 1.35rem; font-weight: 700; color: #24d758;
      letter-spacing: -0.01em; font-variant-numeric: tabular-nums;
    }
    .off-hero-stat-label {
      font-size: 0.7rem; color: rgba(255,255,255,0.5);
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    @media (max-width: 720px) {
      .off-hero-stats { grid-template-columns: repeat(2, 1fr); gap: 0.9rem 0.5rem; padding: 1rem; }
      .off-hero-stat-num { font-size: 1.15rem; }
    }

    /* Animated grid + orb backdrop */
    .off-hero-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(36,215,88,0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(36,215,88,0.045) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
      pointer-events: none; z-index: 0;
      animation: offGridDrift 24s linear infinite;
    }
    @keyframes offGridDrift {
      from { background-position: 0 0, 0 0; }
      to   { background-position: 56px 56px, 56px 56px; }
    }
    .off-hero-orb {
      position: absolute; width: 520px; height: 520px;
      top: -180px; left: 50%; transform: translateX(-50%);
      background: radial-gradient(circle, rgba(36,215,88,0.08) 0%, rgba(36,215,88,0.02) 35%, transparent 65%);
      filter: blur(20px); pointer-events: none; z-index: 0;
      animation: offOrbDrift 9s ease-in-out infinite;
    }
    @keyframes offOrbDrift {
      0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.85; }
      50%      { transform: translateX(-50%) translateY(18px); opacity: 1; }
    }

    /* Crumbs above the hero */
    .off-hero-wrap .crumbs { position: relative; z-index: 1; }

    /* Method ribbon tuning */
    .off-hero-wrap .method-ribbon { margin-top: 2rem; position: relative; z-index: 1; }

    @media (prefers-reduced-motion: reduce) {
      .hero-fade-in, .neon-line-animate, .neon-line-animate .neon-line-parent,
      .neon-line-animate .neon-line-inner, .neon-line-animate .neon-line-shadow,
      .off-hero-pulse, .off-hero-orb, .off-hero-grid,
      .off-hero-rotator-word, .off-hero-rotator-caret {
        animation: none !important;
      }
      .hero-fade-in { opacity: 1; filter: none; transform: none; }
    }

    /* ═════════════════════════════════════════════════════════════
       Section-wide improvements (whole page)
       ═════════════════════════════════════════════════════════════ */

    /* Scroll reveal — any element with .off-reveal fades + lifts in */
    .off-reveal {
      opacity: 0; transform: translateY(18px);
      transition: opacity 0.7s ease, transform 0.7s ease;
      will-change: opacity, transform;
    }
    .off-reveal.is-visible { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .off-reveal { opacity: 1; transform: none; transition: none; }
    }

    /* Section header: subtle green eyebrow before every h2 */
    .off-section-eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: #24d758; margin: 0 0 0.5rem;
    }
    .off-section-eyebrow::before {
      content: ''; width: 22px; height: 1px;
      background: linear-gradient(90deg, #24d758, transparent);
    }

    /* Section dot grid backdrop — used on lighter sections */
    .off-section-dotted { position: relative; overflow: hidden; }
    .off-section-dotted::before {
      content: ''; position: absolute; inset: 0;
      background-image: radial-gradient(circle, rgba(36,215,88,0.06) 1px, transparent 1.5px);
      background-size: 32px 32px;
      mask-image: radial-gradient(ellipse 90% 70% at 50% 50%, #000 0%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 50%, #000 0%, transparent 80%);
      pointer-events: none; z-index: 0;
    }
    .off-section-dotted > .container-medium,
    .off-section-dotted > .container { position: relative; z-index: 1; }

    /* ── Entry cards: add letter to card visually, connector feel ── */
    .entry-card { position: relative; transition: background 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 220ms ease; }
    .entry-card:hover {
      box-shadow: 0 18px 40px -20px rgba(36,215,88,0.25);
    }
    .entry-card-featured::before {
      content: ''; position: absolute; inset: 0;
      border-radius: 18px;
      background: radial-gradient(circle at 80% -10%, rgba(36,215,88,0.18), transparent 55%);
      pointer-events: none;
    }
    .entry-card-featured > * { position: relative; z-index: 1; }

    /* ── Scope chips: add tiny icon dot + arrow animation ────── */
    .scope-chip { transition: background 180ms ease, border-color 180ms ease, transform 180ms ease; }
    .scope-chip:hover { transform: translateY(-2px); }
    .scope-chip-cta svg { transition: transform 0.2s ease; }
    .scope-chip:hover .scope-chip-cta svg { transform: translateX(3px); }

    /* ── 8-stage PTES: visual spine + num glow + hover elevation ── */
    .ptes-stages { position: relative; counter-reset: ptesn; }
    .ptes-stage {
      position: relative; transition: background 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 220ms ease;
    }
    .ptes-stage:hover {
      transform: translateY(-2px);
      border-color: rgba(36,215,88,0.35);
      box-shadow: 0 18px 38px -22px rgba(36,215,88,0.30);
    }
    .ptes-stage-num {
      position: relative; overflow: hidden;
    }
    .ptes-stage-num::after {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(circle at 30% 20%, rgba(36,215,88,0.35), transparent 60%);
      opacity: 0.6; pointer-events: none;
    }

    /* ── Flagship cards: hover lift ───────────────────────────── */
    .flag-card {
      transition: background 180ms ease, border-color 180ms ease, transform 180ms ease, box-shadow 240ms ease;
    }
    .flag-card:hover {
      transform: translateY(-3px);
      border-color: rgba(36,215,88,0.35);
      box-shadow: 0 22px 50px -28px rgba(36,215,88,0.32);
    }
    /* ── Compliance table: row accent on hover ────────────────── */
    .compliance-table tbody tr { transition: background 160ms ease; }
    .compliance-table td:first-child { position: relative; }
    .compliance-table tbody tr:hover td:first-child::before {
      content: ''; position: absolute; left: 0; top: 0; bottom: 0;
      width: 2px; background: linear-gradient(180deg, #24d758, #27dab4);
    }

    /* ── Deliverables: colored number + hover lift ───────────── */
    .deliverable-item {
      transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
    }
    .deliverable-item:hover {
      transform: translateY(-2px); border-color: rgba(36,215,88,0.3);
      background: rgba(36,215,88,0.035);
    }

    /* ── Coming-soon cards polish ─────────────────────────────── */
    .soon-card {
      position: relative; overflow: hidden;
      transition: border-color 200ms ease, transform 200ms ease;
    }
    .soon-card:hover {
      transform: translateY(-2px);
      border-color: rgba(36,215,88,0.3);
    }
    .soon-card::before {
