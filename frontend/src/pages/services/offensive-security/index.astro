export const prerender = false;
---

<Layout
  title="Penetration Testing Services UAE | Underwings"
  description="UAE penetration testing by OSCP and CPTS-certified practitioners. PTES, OWASP and NIST SP 800-115 aligned. Transparent pricing, free first retest."
  keywords="penetration testing UAE, pen test Dubai, PTES UAE, OWASP pentest UAE, mobile app pentest UAE, network pen test Abu Dhabi, VAPT UAE, cybersecurity startup Dubai"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Fragment slot="head">
    <style is:inline>
    /* Neon Line Sweep */
    .neon-line-animate { animation: neonFadeIn 0.8s ease-out 0.3s both; }
    .neon-line-animate .neon-line-parent { animation: neonColorIn 1s ease-out 0.6s both; }
    .neon-line-animate .neon-line-inner { transform: translate3d(-50%, 0, 0); animation: neonSweep 3s ease-in-out 0.8s infinite; }
    .neon-line-animate .neon-line-shadow { opacity: 0; animation: neonGlow 3s ease-in-out 0.8s infinite; }
    @keyframes neonFadeIn { from { filter: blur(3px); opacity: 0; } to { filter: blur(0); opacity: 1; } }
    @keyframes neonColorIn { from { filter: grayscale(100%); } to { filter: grayscale(0%); } }
    @keyframes neonSweep { 0% { transform: translate3d(-50%, 0, 0); } 50% { transform: translate3d(0%, 0, 0); } 100% { transform: translate3d(-50%, 0, 0); } }
    @keyframes neonGlow { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.9; } }

    /* Hero blur-fade in */
    .hero-fade-in { animation: heroFadeIn 0.8s ease-out both; animation-delay: 0.5s; }
    @keyframes heroFadeIn {
      from { filter: blur(3px); opacity: 0; transform: translateY(1rem); }
      to   { filter: blur(0);   opacity: 1; transform: translateY(0); }
    }

    .off-hero-wrap { position: relative; overflow: hidden; }
    .off-hero-wrap .hero-heading-wrapper {
      display: flex; flex-direction: column; align-items: center; gap: 1.1rem;
    }
    .off-hero-wrap .hero-heading-wrapper > * { margin: 0; }
    .off-hero-wrap .heading-large.hero-heading-large {
      line-height: 1.05; letter-spacing: -0.035em;
    }

    /* Eyebrow pill */
    .off-hero-eyebrow {
      display: inline-flex; align-items: center; gap: 0.55rem;
      padding: 0.4rem 0.95rem; border-radius: 100px;
      background: rgba(36,215,88,0.06);
      border: 1px solid rgba(36,215,88,0.22);
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.72rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: #24d758;
    }
    .off-hero-pulse {
      width: 7px; height: 7px; border-radius: 50%; background: #24d758;
      box-shadow: 0 0 0 0 rgba(36,215,88,0.55);
      animation: offHeroPulse 2.2s ease-out infinite;
    }
    @keyframes offHeroPulse {
      0%   { box-shadow: 0 0 0 0 rgba(36,215,88,0.55); opacity: 1; }
      70%  { box-shadow: 0 0 0 10px rgba(36,215,88,0); opacity: 0.7; }
      100% { box-shadow: 0 0 0 0 rgba(36,215,88,0); opacity: 1; }
    }

    /* Typewriter rotator */
    .off-hero-rotator {
      position: relative; display: inline-block;
      vertical-align: baseline; white-space: nowrap;
    }
    .off-hero-rotator-word {
      display: inline-block;
      background: linear-gradient(90deg, #24d758 0%, #27dab4 100%);
      -webkit-background-clip: text; background-clip: text;
      -webkit-text-fill-color: transparent; color: transparent;
      transition: text-shadow 0.25s ease;
    }
    .off-hero-rotator.is-typing .off-hero-rotator-word,
    .off-hero-rotator.is-deleting .off-hero-rotator-word {
      text-shadow: 0 0 22px rgba(36,215,88,0.25);
    }
    .off-hero-rotator-caret {
      display: inline-block; width: 2px; height: 0.95em;
      margin-left: 4px;
      background: linear-gradient(180deg, #24d758, #27dab4);
      vertical-align: -0.08em; border-radius: 2px;
      box-shadow: 0 0 10px rgba(36,215,88,0.6);
      animation: offRotCaretBlink 0.9s ease-in-out infinite;
    }
    .off-hero-rotator.is-typing .off-hero-rotator-caret,
    .off-hero-rotator.is-deleting .off-hero-rotator-caret {
      animation: none; opacity: 1;
    }
    @keyframes offRotCaretBlink {
      0%, 49%   { opacity: 1; }
      50%, 100% { opacity: 0.15; }
    }
    @media (max-width: 560px) {
      .off-hero-rotator { white-space: normal; }
    }

    /* Dual CTA row */
    .off-hero-cta-row {
      display: flex; gap: 0.75rem; justify-content: center;
      flex-wrap: wrap; margin-top: 1.75rem;
    }
    .off-hero-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.85rem 1.5rem; border-radius: 10px;
      font-size: 0.92rem; font-weight: 600; letter-spacing: -0.005em;
      text-decoration: none; border: 1px solid transparent; cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
      font-family: inherit;
    }
    .off-hero-btn-primary {
      background: linear-gradient(135deg, #24d758, #27dab4); color: #0a0a0a;
      box-shadow: 0 4px 18px rgba(36,215,88,0.18);
    }
    .off-hero-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(36,215,88,0.28); }
    .off-hero-btn-secondary {
      background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.15);
    }
    .off-hero-btn-secondary:hover { background: rgba(36,215,88,0.06); border-color: rgba(36,215,88,0.35); }
    .off-hero-btn svg { transition: transform 0.2s ease; }
    .off-hero-btn:hover svg { transform: translateX(3px); }

    /* Microtrust */
    .off-hero-microtrust {
      display: flex; align-items: center; justify-content: center;
      gap: 0.55rem; margin: 1rem 0 0; font-size: 0.8rem;
      color: rgba(255,255,255,0.48); flex-wrap: wrap;
    }
    .off-hero-microtrust-dot { color: rgba(255,255,255,0.2); }

    /* Stats strip */
    .off-hero-stats {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 1rem; margin: 2.25rem auto 0; max-width: 780px;
      padding: 1.25rem 1.75rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px; position: relative; overflow: hidden;
    }
    .off-hero-stats::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(ellipse at top, rgba(36,215,88,0.06) 0%, transparent 65%);
      pointer-events: none;
    }
    .off-hero-stat { display: flex; flex-direction: column; gap: 0.15rem; align-items: center; text-align: center; position: relative; z-index: 1; }
    .off-hero-stat-num {
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 1.35rem; font-weight: 700; color: #24d758;
      letter-spacing: -0.01em; font-variant-numeric: tabular-nums;
    }
    .off-hero-stat-label {
      font-size: 0.7rem; color: rgba(255,255,255,0.5);
      text-transform: uppercase; letter-spacing: 0.08em;
    }
    @media (max-width: 720px) {
      .off-hero-stats { grid-template-columns: repeat(2, 1fr); gap: 0.9rem 0.5rem; padding: 1rem; }
      .off-hero-stat-num { font-size: 1.15rem; }
    }

    /* Animated grid + orb backdrop */
    .off-hero-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(36,215,88,0.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(36,215,88,0.045) 1px, transparent 1px);
      background-size: 56px 56px;
      mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
      -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 30%, #000 0%, transparent 75%);
      pointer-events: none; z-index: 0;
      animation: offGridDrift 24s linear infinite;
    }
    @keyframes offGridDrift {
      from { background-position: 0 0, 0 0; }
      to   { background-position: 56px 56px, 56px 56px; }
    }
    .off-hero-orb {
      position: absolute; width: 520px; height: 520px;
      top: -180px; left: 50%; transform: translateX(-50%);
      background: radial-gradient(circle, rgba(36,215,88,0.08) 0%, rgba(36,215,88,0.02) 35%, transparent 65%);
      filter: blur(20px); pointer-events: none; z-index: 0;
      animation: offOrbDrift 9s ease-in-out infinite;
    }
    @keyframes offOrbDrift {
      0%, 100% { transform: translateX(-50%) translateY(0); opacity: 0.85; }
      50%      { transform: translateX(-50%) translateY(18px); opacity: 1; }
    }

    /* Crumbs above the hero */
    .off-hero-wrap .crumbs { position: relative; z-index: 1; }

    /* Method ribbon tuning */
    .off-hero-wrap .method-ribbon { margin-top: 2rem; position: relative; z-index: 1; }

    @media (prefers-reduced-motion: reduce) {
      .hero-fade-in, .neon-line-animate, .neon-line-animate .neon-line-parent,
      .neon-line-animate .neon-line-inner, .neon-line-animate .neon-line-shadow,
      .off-hero-pulse, .off-hero-orb, .off-hero-grid,
      .off-hero-rotator-word, .off-hero-rotator-caret {
        animation: none !important;
      }
      .hero-fade-in { opacity: 1; filter: none; transform: none; }
    }

    /* ═════════════════════════════════════════════════════════════
       Section-wide improvements (whole page)
       ═════════════════════════════════════════════════════════════ */

    /* Scroll reveal — any element with .off-reveal fades + lifts in */
    .off-reveal {
      opacity: 0; transform: translateY(18px);
      transition: opacity 0.7s ease, transform 0.7s ease;
      will-change: opacity, transform;
    }
    .off-reveal.is-visible { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .off-reveal { opacity: 1; transform: none; transition: none; }
    }

    /* Section header: subtle green eyebrow before every h2 */
    .off-section-eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem;
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: #24d758; margin: 0 0 0.5rem;
    }
    .off-section-eyebrow::before {
      content: ''; width: 22px; height: 1px;
      background: linear-gradient(90deg, #24d758, transparent);
    }

    /* Section dot grid backdrop — used on lighter sections */
    .off-section-dotted { position: relative; overflow: hidden; }
    .off-section-dotted::before {
      content: ''; position: absolute; inset: 0;
      background-image: radial-gradient(circle, rgba(36,215,88,0.06) 1px, transparent 1.5px);
      background-size: 32px 32px;
      mask-image: radial-gradient(ellipse 90% 70% at 50% 50%, #000 0%, transparent 80%);
      -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 50%, #000 0%, transparent 80%);
      pointer-events: none; z-index: 0;
    }
    .off-section-dotted > .container-medium,
    .off-section-dotted > .container { position: relative; z-index: 1; }

    /* ── Entry cards: add letter to card visually, connector feel ── */
