// PTES + HTB-aligned 8-stage process (client-facing adaptation)
const stages = [
  { num: "01", name: "Pre-Engagement", desc: "NDA, scoping workshop, rules of engagement, timeline, deliverable lock. We educate, you choose scope.", clientFacing: true },
  { num: "02", name: "Information Gathering", desc: "Passive + active reconnaissance. OSINT, enumeration, technology fingerprinting, attack-surface mapping." },
  { num: "03", name: "Vulnerability Assessment", desc: "Automated + manual analysis. Known CVE sweep, configuration review, version analysis, attack-vector hypothesis." },
  { num: "04", name: "Exploitation", desc: "Controlled execution of attack paths. Every exploit documented, every action reversible." },
  { num: "05", name: "Post-Exploitation", desc: "Privilege escalation, impact demonstration, pillaging for sensitive data. We show what an attacker would actually get." },
  { num: "06", name: "Lateral Movement", desc: "If in scope — pivot through the environment, chain access, demonstrate breach spread. Internal network engagements only." },
  { num: "07", name: "Proof-of-Concept", desc: "Reproducible evidence for every finding. Screenshots, scripts, step-by-step. No unverifiable claims." },
  { num: "08", name: "Post-Engagement", desc: "Executive summary, technical report, live walkthrough, clean-up evidence, free 30-day retest of critical/high fixes.", clientFacing: true },
];

// Scope chips — what client can include in engagement
const scopes = [
  { key: "network-ext", label: "External Network", desc: "Internet-exposed infrastructure, perimeter", href: "/services/offensive-security/network-penetration-testing" },
  { key: "network-int", label: "Internal Network", desc: "Corporate LAN, Active Directory, lateral movement", href: "/services/offensive-security/network-penetration-testing" },
  { key: "webapp", label: "Web Application", desc: "OWASP WSTG — authenticated, business logic", href: "/services/offensive-security/web-application-penetration-testing" },
  { key: "mobile", label: "Mobile App (iOS / Android)", desc: "OWASP MASTG — static + dynamic + runtime", href: "/services/offensive-security/mobile-application-penetration-testing", isNew: true },
  { key: "api", label: "API", desc: "OWASP API Top 10 — REST, GraphQL, SOAP", href: "/services/offensive-security/web-application-penetration-testing" },
  { key: "wireless", label: "Wireless", desc: "WiFi, rogue-AP, Evil Twin, WPA2/3 weaknesses", href: "#scoping" },
  { key: "phishing", label: "Phishing & Social Engineering", desc: "Email, SMS, vishing — realistic attacker simulation", href: "/services/offensive-security/phishing-simulation" },
  { key: "cloud", label: "Cloud Configuration", desc: "AWS, Azure, GCP — IAM, misconfig, privilege paths", href: "/services/cloud-security" },
  { key: "va-only", label: "VA only (budget)", desc: "Scan + prioritise. Compliance box-check, not a pen test", href: "/services/offensive-security/vulnerability-assessment" },
];

// Compliance framework → required/recommended scope mapping
const compliance = [
  { framework: "ISO 27001 (Annex A 8.8)", required: "VA + annual pen test", recommended: "External network + primary web app", link: "/services/grc/iso-27001-implementation" },
  { framework: "UAE IA V2 (T3.6.1)", required: "External + internal pen test", recommended: "+ phishing simulation + wireless", link: "/services/grc" },
  { framework: "ADHICS v2 (Healthcare UAE)", required: "Annual pen test", recommended: "+ mobile app (if patient-facing) + PHI systems", link: "/services/grc" },
  { framework: "PCI DSS 11.3", required: "Internal + external pen test", recommended: "+ segmentation testing + web app (if CDE)", link: "/services/grc" },
  { framework: "SOC 2 (CC7.1)", required: "Annual pen test", recommended: "External network + web app + API", link: "/services/grc" },
];

const comingY2 = [
  { slug: "third-party-vendor-risk", title: "Third-Party / Vendor Risk Assessment", desc: "Assess the cybersecurity posture of your suppliers and vendors. UAE IA V2 and ISO 27001 both require it — we deliver it via a scalable questionnaire framework." },
  { slug: "managed-vulnerability-management", title: "Managed Vulnerability Management", desc: "Continuous scanning, prioritisation, and remediation tracking — delivered as a monthly retainer with your named engineer." },
];

const comingY3 = [
  { slug: "red-team-exercises", title: "Red Team Exercises", desc: "Full-scope adversary simulation across people, process, and technology. Physical, digital, social engineering. Requires senior CRTO / OSEP hire." },
  { slug: "soc-mdr", title: "SOC-as-a-Service / MDR", desc: "24/7 monitoring, threat detection, and response. MSSP partnership bridge in Year 2 before own build in Year 3." },
  { slug: "dfir", title: "Digital Forensics & Incident Response (DFIR)", desc: "Breach investigation, forensic reporting, legal-grade evidence handling. Licensed tools + GCFE / GCFA certified analysts." },
  { slug: "cyber-threat-intelligence", title: "Cyber Threat Intelligence (CTI)", desc: "Sector-specific threat intel, dark-web brand monitoring, quarterly executive briefings." },
  { slug: "ot-ics-security", title: "OT / ICS Security (IEC 62443)", desc: "Operational technology security for utilities, energy, manufacturing. Specialist hire required; anchor-client driven." },
];

// Hub-level FAQ — answer-first, high commercial-intent. Powers FAQPage rich
// results + AI-answer citations. Additive: does not alter any existing copy.
const faqs = [
  { q: "How much does penetration testing cost in the UAE?", a: "Underwings publishes fixed pricing: engagements start at AED 9,000 (Starter — a single web app or external network up to 20 IPs), AED 12,000 for Essentials (manual OWASP Top 10 / authenticated testing with a 30-day free retest), and AED 25,000–45,000 for Professional multi-asset scopes. You receive a written, fixed-scope quote in AED within 48 hours of a scoping call." },
  { q: "What's the difference between a vulnerability assessment and a penetration test?", a: "A vulnerability assessment scans and prioritises known weaknesses — useful as a compliance box-check and triage step. A penetration test is manual: a certified tester actively exploits and chains weaknesses the way a real attacker would, including business-logic flaws scanners can't find. Underwings delivers manual testing aligned to PTES and OWASP, not scanner PDFs." },
  { q: "How long does a penetration test take?", a: "A single web application or small external network is typically 2–3 weeks end-to-end (scoping, testing, reporting, walkthrough). Larger or API-heavy scopes extend to 3–4 weeks. Expedited delivery is available." },
  { q: "Will your penetration test report satisfy ISO 27001, SOC 2, PCI DSS or NESA audits?", a: "Yes. Reports include scope, methodology, dates, named tester credentials, CVSS-scored findings, reproduction steps, remediation guidance, and retest validation — usable as audit evidence for ISO 27001, SOC 2, PCI DSS, HIPAA, NESA, and ADHICS." },
  { q: "Who performs the testing, and what certifications do they hold?", a: "Every engagement is delivered by named, certified practitioners — OSCP, CPTS, CDSA, CEH — with the tester named in the report. No anonymous juniors and no outsourcing." },
  { q: "Is a retest included after we fix the findings?", a: "Yes. One free retest of critical and high findings within 30 days of the final report is included on Essentials and above, with a separate report confirming remediation." },
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
      { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://underwings.org/services" },
      { "@type": "ListItem", "position": 3, "name": "Offensive Security", "item": "https://underwings.org/services/offensive-security" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Offensive Security Services — Underwings",
    "itemListElement": flagship.map((s, i) => ({
      "@type": "ListItem", "position": i + 1, "name": s.title, "url": `https://underwings.org${s.href}`
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
