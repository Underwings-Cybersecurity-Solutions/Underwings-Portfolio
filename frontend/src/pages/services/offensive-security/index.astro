    <!-- Hero JS — typewriter rotator + stat count-up + scroll reveal -->
    <script is:inline nonce={Astro.locals.nonce || ""}>
    function __offInit() {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var rotator = document.querySelector('.off-hero-rotator-word[data-rotate]');
      var wrap    = document.querySelector('.off-hero-rotator');
      if (!reduce && rotator && wrap) {
        var words;
        try { words = JSON.parse(rotator.getAttribute('data-rotate')); } catch (e) { words = []; }
        if (words.length > 1) {
          rotator.textContent = '';
          var wordIdx = 0, charIdx = 0, deleting = false;
          var TYPE_MIN = 55, TYPE_MAX = 110, DELETE_SPEED = 32, HOLD_FULL = 1400, HOLD_EMPTY = 240;
          function setState(s) {
            wrap.classList.remove('is-typing', 'is-deleting');
            if (s) wrap.classList.add(s);
          }
          function tick() {
            var word = words[wordIdx];
            if (!deleting) {
              setState('is-typing');
              charIdx++;
              rotator.textContent = word.slice(0, charIdx);
              if (charIdx === word.length) {
                setState(null); deleting = true;
                return setTimeout(tick, HOLD_FULL);
              }
              var jitter = TYPE_MIN + Math.random() * (TYPE_MAX - TYPE_MIN);
              return setTimeout(tick, jitter);
            } else {
              setState('is-deleting');
              charIdx--;
              rotator.textContent = word.slice(0, charIdx);
              if (charIdx === 0) {
                setState(null); deleting = false;
                wordIdx = (wordIdx + 1) % words.length;
                return setTimeout(tick, HOLD_EMPTY);
              }
              return setTimeout(tick, DELETE_SPEED);
            }
          }
          setTimeout(tick, 700);
        }
      }

      var hasIO = (typeof IntersectionObserver !== 'undefined');

      if (!reduce && hasIO) {
        var stats = document.querySelectorAll('.off-hero-stat-num[data-target]');
        if (stats.length) {
          var animated = new WeakSet();
          var io = new IntersectionObserver(function(entries) {
            entries.forEach(function(entry) {
              if (!entry.isIntersecting) return;
              var el = entry.target;
              if (animated.has(el)) return;
              animated.add(el);
              var target = parseInt(el.getAttribute('data-target'), 10) || 0;
              var suffix = el.getAttribute('data-suffix') || '';
              var dur = 1200, start = performance.now();
              function tick(now) {
                var t = Math.min(1, (now - start) / dur);
                var eased = 1 - Math.pow(1 - t, 3);
                el.textContent = Math.round(target * eased) + suffix;
                if (t < 1) requestAnimationFrame(tick);
              }
              requestAnimationFrame(tick);
            });
          }, { threshold: 0.4 });
          stats.forEach(function(s) { io.observe(s); });
        }
      }

      // Scroll-reveal for any element with .off-reveal
      var reveals = document.querySelectorAll('.off-reveal');
      if (!reveals.length) return;
      if (reduce || !hasIO) {
        reveals.forEach(function(r) { r.classList.add('is-visible'); });
        return;
      }
      var ro = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            ro.unobserve(entry.target);
          }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
      reveals.forEach(function(r) { ro.observe(r); });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', __offInit);
    } else {
      __offInit();
    }
    </script>

