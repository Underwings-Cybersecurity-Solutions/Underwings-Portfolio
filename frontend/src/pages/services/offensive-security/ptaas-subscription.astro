---
import { ORG_ID, leadPractitioner } from '../../../lib/team';
// ============================================================
// SERVICE PAGE — PTaaS (Penetration Testing as a Service)
// Category: Offensive Security (recurring service — continuous testing)
// ============================================================

import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import '../../../styles/category-hub.css';
import '../../../styles/service-page.css';

const faqs = [
  { q: "How is this different from a one-off pen test?",                           a: "A one-off annual pen test gives you a snapshot. PTaaS gives you continuous coverage — when you push code or change infrastructure, we re-test the affected attack surface within days, not 12 months later. Findings appear in a live portal as we discover them, not in a PDF six weeks after fieldwork." },
  { q: "Who runs the tests?",                                                      a: "Same OSCP / CPTS practitioners who deliver our one-off engagements — Nelson Durairaj leads. No anonymous offshore juniors, no scan-and-PDF outsourcing. Every test action is logged with the operator's name." },
  { q: "How do you scope which assets to test?",                                   a: "At onboarding we define your perimeter: web apps, external network ranges, APIs, optional internal/AD, optional cloud config. Asset list is updated quarterly (or on-demand for major launches). Out-of-scope assets are never touched." },
  { q: "What if we find a critical issue between engagements?",                    a: "Critical findings get a same-day PoC + remediation guidance via the portal. We coordinate with your team on Slack/Teams until the fix is verified. No waiting for the next 'engagement window'." },
  { q: "Can we cancel?",                                                           a: "After the 12-month minimum, you can cancel with 30 days' notice. Before then, only with cause (e.g., we fail to deliver against the SLA)." },
  { q: "Is this a replacement for compliance pen tests?",                          a: "Yes — the annual deep-dive included on Standard and Pro tiers satisfies ISO 27001 Annex A 8.8, UAE IA T3.6.1, ADHICS v2, PCI DSS 11.3, and SOC 2 CC7.1. We provide a signed attestation letter for your auditor." },
  { q: "Do you use automated tools?",                                              a: "Yes — Nuclei, Nessus, Burp Suite Pro, Nmap, BloodHound, custom recon tooling. Tools handle coverage; manual testing handles depth. Tools never write the report or decide what to exploit next." },
  { q: "What about destructive testing?",                                          a: "Never on production without explicit per-finding approval. Default rules of engagement exclude DoS, destructive exploits, and data-modifying actions. Anything risky is staged on copies first." },
];

const schema = [
  { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",                "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Services",            "item": "https://underwings.org/services" },
    { "@type": "ListItem", "position": 3, "name": "Offensive Security",  "item": "https://underwings.org/services/offensive-security" },
    { "@type": "ListItem", "position": 4, "name": "PTaaS — Penetration Testing as a Service", "item": "https://underwings.org/services/offensive-security/ptaas-subscription" }
  ]},
  { "@context": "https://schema.org", "@type": "Service", "name": "PTaaS — Penetration Testing as a Service",
    "serviceType": "Continuous Penetration Testing Subscription",
    "provider": [{ "@id": ORG_ID }, leadPractitioner('nelson-durairaj')],
    "areaServed": { "@type": "Country", "name": "United Arab Emirates" },
    "offers": { "@type": "AggregateOffer", "priceCurrency": "AED", "lowPrice": "6000", "highPrice": "14000" },
    "description": "UAE Penetration Testing as a Service — continuous OSCP-led testing, live findings portal, on-demand re-tests, included annual deep-dive. AED 6,000–14,000/month.",
    "url": "https://underwings.org/services/offensive-security/ptaas-subscription"
  },
  { "@context": "https://schema.org", "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
  }
];

// PTaaS vs Annual Pen Test — comparison rows
const compareRows = [
  { dim: "Testing cadence",         annual: "Once a year — snapshot",                    ptaas: "Continuous — quarterly to fortnightly active cycles" },
  { dim: "Coverage of new releases", annual: "Untested for up to 12 months",              ptaas: "Re-tested within days of deploy" },
  { dim: "Critical-finding response", annual: "Wait for next engagement window",          ptaas: "Same-day PoC + remediation on Slack/Teams" },
  { dim: "Re-test after fixes",     annual: "Out-of-scope or extra fee",                  ptaas: "Within 5 business days, included" },
  { dim: "Findings delivery",       annual: "PDF report, 4 – 6 weeks after fieldwork",    ptaas: "Live portal — visible the day discovered" },
  { dim: "Compliance attestation",  annual: "One letter, expires 12 months later",        ptaas: "Refreshed quarterly — always current" },
  { dim: "External recon",          annual: "Point-in-time during engagement",            ptaas: "Daily passive monitoring of perimeter" },
  { dim: "Operator continuity",     annual: "Different lead each year, in many shops",    ptaas: "Same named lead operator — every cycle" },
];

// Pricing feature matrix
const matrixRows = [
  { feature: "Monthly testing hours",          lite: "8 hrs",                  std: "16 hrs",               pro: "28 hrs" },
  { feature: "Active test cycle cadence",      lite: "Quarterly",              std: "Monthly",              pro: "Fortnightly" },
  { feature: "In-scope assets",                lite: "1 primary asset",        std: "Web + network + APIs", pro: "Web + network + AD + cloud + mobile" },
  { feature: "External IP range",              lite: "Up to 30 IPs",           std: "Up to 100 IPs",        pro: "Unlimited (in scope)" },
  { feature: "Continuous external recon",      lite: "Weekly",                 std: "Daily",                pro: "Daily + change-trigger" },
  { feature: "Live findings portal",           lite: true,                     std: true,                    pro: true },
  { feature: "Slack / Teams direct channel",   lite: "Business-hours",         std: "Business-hours",       pro: "Same-day weekdays" },
  { feature: "On-demand re-tests (5 BD SLA)",  lite: "On critical/high",       std: "All severities",       pro: "All severities + retest queue" },
  { feature: "Annual deep-dive engagement",    lite: false,                    std: true,                    pro: true },
  { feature: "Executive board readout",        lite: false,                    std: false,                   pro: true },
  { feature: "Compliance attestation letter",  lite: "Annual",                 std: "Quarterly",            pro: "Quarterly + framework mapping" },
  { feature: "Quarterly scope review",         lite: true,                     std: true,                    pro: true },
];

export const prerender = false;
---

<Layout
  title="PTaaS UAE — Penetration Testing as a Service | Underwings"
  description="Continuous OSCP-led penetration testing for UAE companies — live findings portal, on-demand retests and an annual deep-dive."
  keywords="PTaaS UAE, penetration testing as a service Dubai, continuous pentest UAE, OSCP managed pentest, on-demand pentest Abu Dhabi, pentest subscription"
  wfPage="services-page"
  schema={schema}
  bodyClass="body svc-compact"
>
  <Header currentPage="services" />

  <main id="main" class="main">

    <!-- ════════════════════════════════════════════════════════
         HERO — eyebrow + headline + microtrust + stat strip
         ════════════════════════════════════════════════════════ -->
    <section class="section bottom-padding-clear top-padding-small ptaas-hero-wrap">
      <div class="ptaas-hero-grid" aria-hidden="true"></div>
      <div class="ptaas-hero-orb" aria-hidden="true"></div>
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium" style="position:relative;z-index:1;">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">›</span>
          <a href="/services">Services</a><span aria-hidden="true">›</span>
          <a href="/services/offensive-security">Offensive Security</a><span aria-hidden="true">›</span>
          <span class="crumbs-current">PTaaS</span>
        </nav>

        <div class="svc-hero ptaas-hero">
          <span class="ptaas-hero-eyebrow">
            <span class="ptaas-hero-pulse" aria-hidden="true"></span>
            New · Recurring Service · Offensive Security
          </span>

          <h1 class="heading-large" style="margin-top:1.1rem;">
            PTaaS — Penetration Testing<br><span class="ptaas-gradient">as a Service for the UAE</span>
          </h1>

          <p class="text" style="max-width:680px;margin:1.1rem auto 0;">
            Stop testing once a year. <strong>Test every time something changes.</strong> Continuous OSCP-led coverage, a live findings portal, on-demand re-tests, and an included annual deep-dive — bundled into one monthly subscription.
          </p>

          <p class="ptaas-hero-microtrust">
            <span>Free 20-min scoping call</span>
            <span class="ptaas-hero-dot" aria-hidden="true">·</span>
            <span>OSCP-led, named operator</span>
            <span class="ptaas-hero-dot" aria-hidden="true">·</span>
            <span>Cancel after 12 months</span>
          </p>

          <div class="ptaas-hero-cta-row">
            <a href="/#contact?service=ptaas" class="ptaas-hero-btn ptaas-hero-btn-primary">
              <span>Book a 20-min scoping call</span>
              <svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true">
                <path d="M1.5 7.5h12M8 2l5.5 5.5L8 13" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
            <a href="#pricing" class="ptaas-hero-btn ptaas-hero-btn-secondary">
              <span>See pricing tiers</span>
            </a>
          </div>

          <!-- Stat strip -->
          <div class="ptaas-hero-stats">
            <div class="ptaas-hero-stat">
              <span class="ptaas-hero-stat-num">5<span class="ptaas-hero-stat-unit">d</span></span>
              <span class="ptaas-hero-stat-label">Re-test SLA</span>
            </div>
            <div class="ptaas-hero-stat">
              <span class="ptaas-hero-stat-num ptaas-hero-stat-text">Same-day</span>
              <span class="ptaas-hero-stat-label">Critical Findings</span>
            </div>
            <div class="ptaas-hero-stat">
              <span class="ptaas-hero-stat-num">1<span class="ptaas-hero-stat-unit">×</span></span>
              <span class="ptaas-hero-stat-label">Named Operator</span>
            </div>
            <div class="ptaas-hero-stat">
              <span class="ptaas-hero-stat-num ptaas-hero-stat-text">AED&nbsp;6k</span>
              <span class="ptaas-hero-stat-label">Entry / month</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         WHAT IT IS
         ════════════════════════════════════════════════════════ -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What it is</h2>
        <div class="svc-sec-body">
          <p>An annual penetration test produces a snapshot. The day after the report is delivered, your codebase changes, your infrastructure drifts, and the snapshot starts going stale. Twelve months later you find out what's broken — usually right before a customer audit, or after a breach.</p>
          <p>PTaaS is a <strong>continuous, OSCP-led testing programme</strong> with a live findings portal, on-demand re-tests when you push fixes, and a deep-dive annual engagement that satisfies your compliance pen-test obligation. You pay one monthly fee; we keep your offensive-security posture current.</p>
          <p>Same operators who deliver our one-off engagements. Same depth. Just continuous, with a portal between you and us instead of a PDF every twelve months.</p>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         PTaaS vs ANNUAL PEN TEST — comparison band
         ════════════════════════════════════════════════════════ -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">PTaaS vs the annual pen test</h2>
        <p class="svc-sec-body" style="margin-bottom:1.5rem;">Eight dimensions where a subscription beats a once-a-year engagement — especially if you ship code or change infrastructure between audits.</p>

        <div class="ptaas-compare">
          <div class="ptaas-compare-head">
            <div class="ptaas-compare-h ptaas-compare-h-dim">Dimension</div>
            <div class="ptaas-compare-h ptaas-compare-h-annual">Annual Pen Test</div>
            <div class="ptaas-compare-h ptaas-compare-h-ptaas">PTaaS <span class="ptaas-compare-tag">recommended</span></div>
          </div>
          {compareRows.map(r => (
            <div class="ptaas-compare-row">
              <div class="ptaas-compare-cell ptaas-compare-cell-dim">{r.dim}</div>
              <div class="ptaas-compare-cell ptaas-compare-cell-annual">
                <svg class="ptaas-compare-ico ptaas-compare-ico-no" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M3.5 3.5l7 7M10.5 3.5l-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                <span>{r.annual}</span>
              </div>
              <div class="ptaas-compare-cell ptaas-compare-cell-ptaas">
                <svg class="ptaas-compare-ico ptaas-compare-ico-yes" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{r.ptaas}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         WHAT THIS IS NOT
         ════════════════════════════════════════════════════════ -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What this is <em>not</em></h2>
        <div class="svc-not-list">
          <div class="svc-not-item"><div class="svc-not-ico" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div><div><strong>Not a vulnerability scanner subscription.</strong> Scans are part of the toolkit; the work and the findings are human.</div></div>
          <div class="svc-not-item"><div class="svc-not-ico" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div><div><strong>Not 24/7 SOC monitoring or incident response.</strong> We test attackers' paths; we don't watch your alerts. SOC / IR is a separate offering on the 2027 roadmap.</div></div>
          <div class="svc-not-item"><div class="svc-not-ico" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div><div><strong>Not unlimited testing.</strong> Each tier has a defined hours envelope per month; out-of-scope work is quoted separately.</div></div>
          <div class="svc-not-item"><div class="svc-not-ico" aria-hidden="true"><svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M3 3l6 6M9 3l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div><div><strong>Not red-team / adversary emulation.</strong> Full-scope adversary simulation (physical, social, multi-week campaigns) is a separate engagement on the 2028 roadmap.</div></div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         WHO IT'S FOR
         ════════════════════════════════════════════════════════ -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">Who this is for</h2>
        <p class="svc-sec-body" style="margin-bottom:1.25rem;">You're probably here because one of these is true:</p>
        <div class="svc-triggers">
          <div class="svc-trigger"><div class="svc-trigger-num">1</div><div>You're a SaaS or product team that <strong>ships code weekly or daily</strong> and can't wait 12 months between pen tests.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">2</div><div>You're under <strong>continuous compliance pressure</strong> (ISO 27001, ADHICS, PCI DSS) — this satisfies the annual pen-test requirement <em>plus</em> continuous control validation.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">3</div><div>You're a mid-market firm <strong>without an internal red team</strong> — you want offensive coverage without the headcount.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">4</div><div>You've been burned by a <strong>scan-and-PDF "VAPT"</strong> vendor and want live, named-practitioner testing with evidence trails.</div></div>
          <div class="svc-trigger"><div class="svc-trigger-num">5</div><div>An <strong>enterprise client or bank</strong> requires periodic pen-test attestation as a continuing onboarding condition.</div></div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         WHAT YOU GET — grouped into 4 pillars
         ════════════════════════════════════════════════════════ -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">What you get every month</h2>
        <p class="svc-sec-body" style="margin-bottom:1.5rem;">Four pillars — every tier includes all four; depth scales with the tier you pick.</p>

        <div class="ptaas-pillars">
          <div class="ptaas-pillar">
            <div class="ptaas-pillar-ico" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 20s7-3.5 7-9V6l-7-3-7 3v5c0 5.5 7 9 7 9z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 11l2.2 2.2L15 8.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="ptaas-pillar-title">Active Testing</h3>
            <ul class="ptaas-pillar-list">
              <li><strong>OSCP / CPTS-led testing</strong> — 8 / 16 / 28 hours per month by tier.</li>
              <li><strong>On-demand re-tests within 5 business days</strong> of remediation; unlimited free re-tests for critical/high findings within 14 days.</li>
              <li><strong>Annual deep-dive engagement</strong> (Standard &amp; Pro) — full-scope manual pen test; same depth as our standalone Professional tier.</li>
            </ul>
          </div>

          <div class="ptaas-pillar">
            <div class="ptaas-pillar-ico" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="M13 13l5.5 5.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M7 9h4M9 7v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <h3 class="ptaas-pillar-title">Continuous Visibility</h3>
            <ul class="ptaas-pillar-list">
              <li><strong>Daily passive recon</strong> of your in-scope external surface — new subdomains, exposed services, certificate changes, leaked credentials.</li>
              <li><strong>Live findings portal</strong> — every finding with PoC, screenshots, severity, remediation guidance, history. Visible the day discovered.</li>
              <li><strong>Monthly testing dashboard</strong> — what was tested, what was found, what was fixed.</li>
            </ul>
          </div>

          <div class="ptaas-pillar">
            <div class="ptaas-pillar-ico" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M3 5c0-1.1.9-2 2-2h12a2 2 0 012 2v9a2 2 0 01-2 2H8l-5 4V5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7 8h8M7 11h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <h3 class="ptaas-pillar-title">Direct Communication</h3>
            <ul class="ptaas-pillar-list">
              <li><strong>Slack / Teams channel</strong> direct to the operator — same-day weekday response on critical findings.</li>
              <li><strong>Same-day PoC</strong> for critical/high — remediation guidance the day we discover the issue.</li>
              <li><strong>Quarterly scope review</strong> — adjust asset list, add new launches, retire decommissioned systems.</li>
            </ul>
          </div>

          <div class="ptaas-pillar">
            <div class="ptaas-pillar-ico" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="3" width="16" height="16" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M3 7h16" stroke="currentColor" stroke-width="1.5"/><path d="M8 13l2.2 2.2L15 10.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <h3 class="ptaas-pillar-title">Compliance Ready</h3>
            <ul class="ptaas-pillar-list">
              <li><strong>Signed attestation letter</strong> mapping testing to ISO 27001 Annex A 8.8, UAE IA T3.6.1, ADHICS v2, PCI DSS 11.3, SOC 2 CC7.1.</li>
              <li><strong>Quarterly refresh</strong> on Standard &amp; Pro — your auditor always has a current letter.</li>
              <li><strong>Framework mapping pack</strong> (Pro) — finding-to-control traceability for ISMS evidence.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════════════════════════════════════════════════
         HOW WE DELIVER — vertical timeline
         ════════════════════════════════════════════════════════ -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"><div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div></div>
      <div class="container-medium">
        <h2 class="svc-sec-title">How we deliver</h2>
        <p class="svc-sec-body" style="margin-bottom:1.5rem;">Six stages — onboarding once, then a recurring rhythm of cycles, response, and review.</p>

        <ol class="ptaas-timeline">
          <li class="ptaas-timeline-item">
            <div class="ptaas-timeline-marker">01</div>
            <div class="ptaas-timeline-body">
              <div class="ptaas-timeline-head">
                <h3 class="ptaas-timeline-title">Onboarding &amp; perimeter mapping</h3>
                <span class="ptaas-timeline-dur">Week 1</span>
              </div>
              <p class="ptaas-timeline-desc">Asset inventory, rules of engagement signed, escalation contacts, blackout windows, portal account provisioned, Slack/Teams channel opened.</p>
            </div>
          </li>
          <li class="ptaas-timeline-item">
            <div class="ptaas-timeline-marker">02</div>
            <div class="ptaas-timeline-body">
              <div class="ptaas-timeline-head">
                <h3 class="ptaas-timeline-title">Baseline test cycle</h3>
                <span class="ptaas-timeline-dur">Weeks 2 – 4</span>
              </div>
              <p class="ptaas-timeline-desc">First active test cycle covering your primary asset. Establishes baseline finding inventory in the portal.</p>
            </div>
          </li>
          <li class="ptaas-timeline-item">
            <div class="ptaas-timeline-marker ptaas-timeline-marker-recurring">03</div>
            <div class="ptaas-timeline-body">
              <div class="ptaas-timeline-head">
                <h3 class="ptaas-timeline-title">Continuous monitoring + active cycles</h3>
