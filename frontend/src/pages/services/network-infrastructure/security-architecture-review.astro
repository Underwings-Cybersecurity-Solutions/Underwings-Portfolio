      <div class="container-medium">
        <h2 class="svc-sec-title">Your cert-backed team</h2>
        <div class="svc-team">
          <div class="svc-team-card">
            <p class="svc-team-role">Lead Architect</p>
            <h3 class="svc-team-name">Vinoth Samiyappa</h3>
