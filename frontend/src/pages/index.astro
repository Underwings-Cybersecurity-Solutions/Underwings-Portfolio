        grid-column-gap: 0px;
        grid-row-gap: 0px;
        width: calc(var(--sizes--motion-cubes) * 4.25);
        min-width: calc(var(--sizes--motion-cubes) * 4.25);
        flex-flow: row;
        grid-template-rows: auto;
        grid-template-columns: 1fr 1fr 1fr;
        grid-auto-columns: 1fr;
        align-items: end;
        margin-bottom: 0;
        display: grid;
      }
