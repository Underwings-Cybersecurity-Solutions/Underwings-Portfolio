      .vapt-hp-heading { font-size: 1.8rem; }
      .ind-grid { grid-template-columns: 1fr; }
      .ind-cta { flex-direction: column; text-align: center; }
    }

    /* Hero H1 — fluid sizing, exactly 2 lines on desktop, max 3 on mobile */
    .hero-heading-large {
      font-size: clamp(1.9rem, 4.3vw, 3.5rem) !important;
      line-height: 1.12 !important;
      letter-spacing: -0.02em !important;
      max-width: 1240px !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
    /* Mobile: remove forced break so heading wraps naturally */
    @media (max-width: 700px) {
      .hero-heading-large br { display: none; }
    }

    /* ── Hero compliance pill row ─────────────────────────────────── */
    .hero-compliance-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 0.3rem 0.55rem;
      max-width: 720px;
      margin: 0.85rem auto 0;
      padding: 0.4rem 0.85rem;
      background: rgba(55, 220, 130, 0.035);
      border: 1px solid rgba(55, 220, 130, 0.18);
      border-radius: 100px;
    }
    .hero-compliance-label {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.55);
      padding-right: 0.15rem;
    }
    .hero-compliance-chip {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: #9fe7bf;
      white-space: nowrap;
    }
    .hero-compliance-dot {
      color: rgba(55, 220, 130, 0.35);
      font-weight: 600;
      user-select: none;
    }
    @media (max-width: 600px) {
      .hero-compliance-row {
        padding: 0.6rem 0.85rem;
        border-radius: 14px;
        gap: 0.35rem 0.5rem;
      }
      .hero-compliance-label { width: 100%; text-align: center; font-size: 0.62rem; }
      .hero-compliance-chip { font-size: 0.72rem; }
    }

    /* ============================================================
       Hero dual CTA — matched primary + secondary button system
       Shared geometry; differ only in fill/outline + colour
       ============================================================ */
    .hero-cta-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.25rem;
    }

    /* Shared button geometry (BOTH primary and secondary inherit) */
    .hero-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.55rem;
      padding: 0.95rem 1.75rem;
      font-size: 0.95rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      border-radius: 100px;
      text-decoration: none;
      border: 1.5px solid transparent;
      transition: transform 0.2s ease, gap 0.25s ease, background 0.25s ease,
                  border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
      white-space: nowrap;
      cursor: pointer;
    }
    .hero-btn svg {
      transition: transform 0.25s ease;
      flex-shrink: 0;
    }
    .hero-btn:hover {
      gap: 0.85rem;
      transform: translateY(-1px);
    }
    .hero-btn:hover svg {
      transform: translateX(2px);
    }

    /* Primary — solid green fill, dark text */
    .hero-btn-primary {
      color: #051a0c;
      background: linear-gradient(135deg, #37dc82 0%, #27dab4 100%);
      border-color: rgba(55, 220, 130, 0.4);
      box-shadow: 0 4px 18px -4px rgba(55, 220, 130, 0.35);
    }
    .hero-btn-primary:hover {
      background: linear-gradient(135deg, #45e88d 0%, #2fe3bd 100%);
      box-shadow: 0 8px 24px -4px rgba(55, 220, 130, 0.55);
    }

    /* Secondary — outlined, transparent, green text */
    .hero-btn-secondary {
      color: #fff;
      background: rgba(255, 255, 255, 0.02);
      border-color: rgba(255, 255, 255, 0.18);
    }
    .hero-btn-secondary:hover {
      color: #37dc82;
      background: rgba(55, 220, 130, 0.06);
      border-color: rgba(55, 220, 130, 0.55);
      box-shadow: 0 4px 16px -4px rgba(55, 220, 130, 0.25);
    }

    /* Mobile: stack full-width */
    @media (max-width: 600px) {
      .hero-cta-row {
        gap: 0.75rem;
        flex-direction: column;
        padding: 0 1rem;
      }
      .hero-btn {
        width: 100%;
        padding: 0.95rem 1.5rem;
      }
    }

    /* Hero and categories share the same dark background so there's no
       visible seam between them — the cleanest possible transition. */

    /* Micro-trust line — removes friction before the click */
    .hero-microtrust {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      margin: 0.65rem auto 0;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.5);
      letter-spacing: 0.01em;
    }
    .hero-microtrust-dot {
      color: rgba(55, 220, 130, 0.55);
      font-weight: 700;
    }

    /* Cert badges — real credential artwork in a subtle gray "cover" card */
    .hero-cert-badges {
      margin: 1.5rem auto 0;
      max-width: 1000px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.95rem;
      padding: 1.35rem 2rem;
      background: linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.04) 0%,
        rgba(255, 255, 255, 0.015) 100%
      );
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.04),
        0 8px 32px -12px rgba(0, 0, 0, 0.4);
    }
    .hero-cert-label {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
    }
    .hero-cert-badge-grid {
      display: flex;
      flex-wrap: wrap;
