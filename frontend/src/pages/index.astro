      flex-direction: column;
      gap: 0.85rem;
      transition: border-color 0.18s, transform 0.18s, background 0.18s;
    }
    .founding-card:hover {
      border-color: rgba(36,215,88,0.28);
      transform: translateY(-2px);
      background: rgba(36,215,88,0.025);
