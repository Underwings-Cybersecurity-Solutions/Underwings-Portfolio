        margin-bottom: -3rem;
        transition-delay: 0.4s;
      }
      .motion-cube-col[data-cube="3"] {
        transition-delay: 0.3s;
      }
      .motion-cube-col.cube-visible {
        transform: translateY(0);
      }
      .cube-height {
        z-index: 1;
        width: var(--sizes--motion-cubes);
        height: var(--sizes--motion-cubes);
        transform-style: preserve-3d;
        margin-left: auto;
        margin-right: auto;
        position: relative;
        transform: rotateX(145deg) rotateY(45deg);
      }
      /* Cube rib-light styles (purged from webflow CSS) */
      .cube-rib-light {
        border: 1px dashed var(--colors--white-30);
        width: 100%;
        height: 1px;
        position: absolute;
        inset: auto 0% 0%;
      }
      .cube-rib-light.cube-rib-right {
        width: 1px;
        height: 100%;
        inset: 0% 0% 0% auto;
      }
      .cube-rib-light.cube-rib-right.cube-rib-right-topper {
        height: 7%;
        top: 100%;
        bottom: auto;
      }
      .cube-rib-light.cube-rib-left {
        width: 1px;
        height: 100%;
        inset: 0% auto 0% 0%;
      }
      .cube-rib-light.cube-rib-left.cube-rib-left-topper {
        height: 7%;
        top: 100%;
      }
      .cube-rib-light.cube-rib-left.cube-rib-left-long {
        height: 130%;
        top: -30%;
      }
      .cube-rib-light.cube-rib-topper {
        bottom: -7%;
      }
      /* Neon line looping animations */
      @keyframes neon-v-1 {
        0%, 100% { transform: translateY(13.75rem); }
        50% { transform: translateY(6.25rem); }
      }
      @keyframes neon-h-1 {
        0%, 100% { transform: translateX(13.75rem); }
        50% { transform: translateX(0); }
      }
      @keyframes neon-v-2 {
        0%, 100% { transform: translateY(13.75rem); }
        50% { transform: translateY(0); }
      }
      @keyframes neon-v-c3a {
        0%, 100% { transform: translateY(3rem); }
        50% { transform: translateY(18rem); }
      }
      @keyframes neon-v-c3b {
        0%, 100% { transform: translateY(13.75rem); }
        50% { transform: translateY(6.25rem); }
      }
      /* Cube 1 neon animations */
      [data-cube="1"] .cube-neon-vertical {
        animation: neon-v-1 5s ease-in-out infinite;
      }
