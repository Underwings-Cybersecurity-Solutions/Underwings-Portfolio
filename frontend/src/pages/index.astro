      border: 1px solid rgba(255,255,255,0.06);
    }
    .vapt-hp-diagram img {
      width: 100%;
      height: auto;
      display: block;
    }
    /* ---- Founding Client Program ---- */
    .founding-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
      margin-top: 2.5rem;
    }
    .founding-card {
      padding: 1.75rem;
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 14px;
