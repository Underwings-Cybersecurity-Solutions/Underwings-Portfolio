---
// ===========================================
// HOMEPAGE
// Underwings Cybersecurity Solutions
// ===========================================
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import { getPartners } from '../lib/partners';
import '../styles/category-hub.css';

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://underwings.org";

// Decides whether the "Trusted Technology Partners" section renders at all —
// the component alone would leave the heading stranded above an empty row.
const hasPartners = (await getPartners()).length > 0;

const schemas = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Underwings Cybersecurity Solutions",
    "url": siteUrl,
    "logo": `${siteUrl}/brand/logos/underwings-icon-green.png`,
    "description": "Cybersecurity startup offering security software sales, VAPT services, ISO 27001 implementation, and security awareness training in UAE.",
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "AE",
      "addressRegion": "Abu Dhabi"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+971-505670394",
      "email": "contact@underwings.org",
      "contactType": "sales"
    },
    "sameAs": [
      "https://www.linkedin.com/company/underwings-cybersecurity"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Cybersecurity Services",
    "provider": {
      "@type": "Organization",
      "name": "Underwings Cybersecurity Solutions"
    },
    "areaServed": {
      "@type": "Country",
      "name": "United Arab Emirates"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Cybersecurity Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Vulnerability Assessment & Penetration Testing (VAPT)" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "ISO 27001 Implementation & Audit Support" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cybersecurity Awareness Training" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Security Software Sales & Implementation" } }
      ]
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Where is Underwings based, and do you serve companies across the UAE?",
        "acceptedAnswer": { "@type": "Answer", "text": "We are a UAE-based cybersecurity company headquartered in Abu Dhabi, serving clients across the Emirates — Abu Dhabi, Dubai, Sharjah, and the Northern Emirates — on-site and remotely." }
      },
      {
        "@type": "Question",
        "name": "How much does a penetration test (VAPT) cost in the UAE?",
        "acceptedAnswer": { "@type": "Answer", "text": "Pricing is published per service. A vulnerability assessment starts around AED 3,500, web and network penetration tests typically run AED 12,000–48,000 depending on scope, and you receive a written quote within 48 hours." }
      },
      {
        "@type": "Question",
        "name": "Can you help with UAE compliance — ISO 27001, NESA / UAE IA, PDPL, and ADHICS?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. Our GRC work is led by an ISO 27001 Lead Auditor and covers ISO 27001:2022, NESA / UAE IA V2, UAE PDPL, and ADHICS v2 for Abu Dhabi healthcare — from gap assessment to implementation and audit support." }
      },
      {
        "@type": "Question",
        "name": "How quickly can you start, and when do I get the report?",
        "acceptedAnswer": { "@type": "Answer", "text": "Most engagements begin within one to two weeks of a signed scope. You get a detailed findings report with prioritised remediation, plus a free first retest once fixes are in place." }
      },
      {
        "@type": "Question",
        "name": "Do you provide services and support in Arabic?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes — our team works in both Arabic and English, and Arabic-language reports and documentation are available on request." }
      },
      {
        "@type": "Question",
        "name": "Are your testers certified?",
        "acceptedAnswer": { "@type": "Answer", "text": "Every engagement is delivered by named, certified practitioners — OSCP, CPTS, ISO 27001 Lead Auditor, CCNP, Fortinet NSE, and Azure Security — never anonymous subcontractors." }
      }
    ]
  }
];
---

<Layout
  title="Underwings – Cybersecurity Solutions | UAE"
  description="Cybersecurity startup in UAE. OSCP+ & CPTS certified VAPT, ISO 27001 implementation, security awareness training, and software sales with hands-on support."
  keywords="cybersecurity UAE, VAPT services Abu Dhabi, ISO 27001 implementation, security software sales, penetration testing, cybersecurity training, OSCP penetration testing, compliance services UAE"
  wfPage="6920627afaad5c7afb54bfa8"
  schema={schemas}
>
  <Fragment slot="head">
    <style is:inline>
