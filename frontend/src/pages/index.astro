      box-shadow: 0 8px 28px rgba(36,215,88,0.28);
    }
    .founding-cta-btn svg { transition: transform 0.2s; }
    .founding-cta-btn:hover svg { transform: translateX(3px); }
    .founding-availability {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.45);
      margin: 0;
    }
    @media (max-width: 768px) {
      .founding-grid { grid-template-columns: 1fr; }
    }

    /* ---- Healthcare wedge panel ---- */
    .hc-panel {
      margin-top: 2.5rem;
      padding: 2rem;
      border-radius: 16px;
      background: linear-gradient(135deg, rgba(36,215,88,0.05), rgba(39,218,180,0.025));
      border: 1px solid rgba(36,215,88,0.22);
      position: relative;
      overflow: hidden;
    }
    .hc-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at top right, rgba(36,215,88,0.08), transparent 60%);
      pointer-events: none;
    }
    .hc-panel-inner {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
      gap: 2rem;
      align-items: center;
      position: relative;
      z-index: 1;
    }
    .hc-panel-text { display: flex; flex-direction: column; gap: 0.85rem; }
    .hc-panel-eyebrow {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.35rem 0.85rem; border-radius: 100px;
      background: rgba(36,215,88,0.08);
      border: 1px solid rgba(36,215,88,0.28);
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.7rem; letter-spacing: 0.14em;
      text-transform: uppercase; color: #24d758;
      width: fit-content;
    }
    .hc-panel-pulse {
      width: 7px; height: 7px; border-radius: 50%; background: #24d758;
      box-shadow: 0 0 0 0 rgba(36,215,88,0.55);
      animation: hcPanelPulse 2.2s ease-out infinite;
    }
    @keyframes hcPanelPulse {
      0%   { box-shadow: 0 0 0 0 rgba(36,215,88,0.55); opacity: 1; }
      70%  { box-shadow: 0 0 0 10px rgba(36,215,88,0); opacity: 0.7; }
      100% { box-shadow: 0 0 0 0 rgba(36,215,88,0); opacity: 1; }
    }
    .hc-panel-title {
      font-size: 1.65rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: #fff;
      margin: 0;
      line-height: 1.2;
    }
    .hc-panel-body {
      font-size: 0.95rem;
      color: rgba(255,255,255,0.78);
      line-height: 1.65;
      margin: 0;
    }
    .hc-panel-cta-row {
      display: flex; flex-wrap: wrap; gap: 0.65rem;
      margin-top: 0.75rem;
    }
    .hc-panel-btn {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.7rem 1.1rem; border-radius: 8px;
      font-size: 0.85rem; font-weight: 500;
      text-decoration: none;
      transition: transform 0.18s, background 0.18s, border-color 0.18s, box-shadow 0.2s;
    }
    .hc-panel-btn-primary {
      background: linear-gradient(135deg, #24d758, #27dab4);
      color: #0a0a0a; font-weight: 600;
      box-shadow: 0 3px 14px rgba(36,215,88,0.18);
    }
    .hc-panel-btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 22px rgba(36,215,88,0.28); }
    .hc-panel-btn-secondary {
      background: rgba(255,255,255,0.04);
      color: #fff;
      border: 1px solid rgba(255,255,255,0.14);
    }
    .hc-panel-btn-secondary:hover { background: rgba(36,215,88,0.06); border-color: rgba(36,215,88,0.35); }
    .hc-panel-trust {
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.04em;
      color: rgba(255,255,255,0.5);
      margin: 0.6rem 0 0;
      line-height: 1.6;
    }
    .hc-panel-visual {
      display: flex; align-items: center; justify-content: center;
    }
    .hc-panel-visual svg { width: 100%; max-width: 260px; height: auto; }
    .ind-other-eyebrow {
      margin: 2.5rem 0 0;
      font-family: 'Geist Mono', ui-monospace, monospace;
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      text-align: center;
    }
    @media (max-width: 991px) {
      .hc-panel-inner { grid-template-columns: 1fr; }
      .hc-panel-visual { order: -1; max-width: 200px; margin: 0 auto; }
    }
    @media (max-width: 600px) {
      .hc-panel { padding: 1.5rem; }
      .hc-panel-title { font-size: 1.35rem; }
      .hc-panel-cta-row { flex-direction: column; }
      .hc-panel-btn { width: 100%; justify-content: space-between; }
