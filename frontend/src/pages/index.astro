    }
    .founding-desc {
      font-size: 0.9rem;
      color: rgba(255,255,255,0.7);
      margin: 0;
      line-height: 1.6;
    }
    .founding-cta-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.6rem;
      margin-top: 2rem;
    }
    .founding-cta-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
