---
// ===========================================
// BRAND GUIDELINES PAGE
// Underwings Cybersecurity Solutions
// ===========================================

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export const prerender = false;
---

<Layout
  title="Brand Guidelines | Underwings Cybersecurity Solutions"
  description="Official Underwings brand guidelines. Logo usage rules, color palette, Geist typography, and downloadable brand assets for partners and media."
  keywords="Underwings brand, brand guidelines, logo, brand assets, media kit"
  wfPage="brand-page"
  bodyClass="body"
>
  <Fragment slot="head">
    <style is:inline>
    /* Neon line + hero fade (shared with services hero) */
    .neon-line-animate { animation: bNeonFadeIn 0.8s ease-out 0.3s both; }
    .neon-line-animate .neon-line-parent { animation: bNeonColorIn 1s ease-out 0.6s both; }
    .neon-line-animate .neon-line-inner { transform: translate3d(-50%, 0, 0); animation: bNeonSweep 3s ease-in-out 0.8s infinite; }
    .neon-line-animate .neon-line-shadow { opacity: 0; animation: bNeonGlow 3s ease-in-out 0.8s infinite; }
    @keyframes bNeonFadeIn { from { filter: blur(3px); opacity: 0; } to { filter: blur(0); opacity: 1; } }
    @keyframes bNeonColorIn { from { filter: grayscale(100%); } to { filter: grayscale(0%); } }
    @keyframes bNeonSweep { 0% { transform: translate3d(-50%, 0, 0); } 50% { transform: translate3d(0%, 0, 0); } 100% { transform: translate3d(-50%, 0, 0); } }
    @keyframes bNeonGlow { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.9; } }
    .hero-fade-in { animation: bHeroFadeIn 0.8s ease-out both; animation-delay: 0.4s; }
    @keyframes bHeroFadeIn {
      from { filter: blur(3px); opacity: 0; transform: translateY(1rem); }
      to   { filter: blur(0);   opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-fade-in, .neon-line-animate, .neon-line-animate .neon-line-parent,
      .neon-line-animate .neon-line-inner, .neon-line-animate .neon-line-shadow {
        animation: none !important;
      }
      .hero-fade-in { opacity: 1; filter: none; transform: none; }
    }
    </style>
  </Fragment>

  <Header currentPage="brand" />

  <main id="main" class="main">

    <!-- ============ HERO ============ -->
    <section class="section top-padding-small bottom-padding-medium brand-hero-wrap">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="brand-hero-orb" aria-hidden="true"></div>
      <div class="container-medium" style="position: relative; z-index: 1;">
        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="neon-line-box neon-line-animate">
              <div class="neon-line-parent"><div class="neon-line-inner"></div></div>
              <div class="neon-line-shadow"></div>
            </div>
            <div class="hero-heading-wrapper">
              <div class="brand-label hero-fade-in">
                <div class="text-small color-grey">Brand Guidelines</div>
              </div>
              <h1 class="heading-large hero-heading-large hero-fade-in" style="animation-delay: 0.2s">The <span class="text-gradient-clip bg-color-green-gradient">Underwings</span> Brand</h1>
              <p class="text hero-fade-in" style="animation-delay: 0.4s; max-width: 640px; margin: 1rem auto 0; text-align: center;">Logos, color, typography and usage rules — everything you need to represent Underwings accurately in press, partnerships, and marketing.</p>
            </div>
            <!-- Featured primary lockup -->
            <div class="brand-hero-showcase hero-fade-in" style="animation-delay: 0.6s">
              <img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Underwings primary logo" loading="eager">
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ LOCKUPS ============ -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div style="text-align: center; margin-bottom: 1.75rem;">
          <div class="brand-label"><div class="text-small color-grey">Logo Lockups</div></div>
          <h2 class="heading heading-center" style="margin-top: 0.75rem;">Logo <span class="text-gradient-clip bg-color-green-gradient">Variants</span></h2>
          <p class="text" style="max-width: 580px; margin: 1rem auto 0; text-align: center; color: rgba(255,255,255,0.6);">Pick the right lockup for the background you're placing it on. The primary green-on-dark lockup is preferred whenever possible.</p>
        </div>

        <div class="brand-logo-grid">
          <!-- Primary (dark bg) -->
          <div class="brand-logo-card brand-logo-dark">
            <div class="brand-logo-preview"><img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Primary lockup — green icon + white wordmark" loading="lazy"></div>
            <div class="brand-logo-info">
              <div><span class="brand-logo-label">Primary — dark backgrounds</span><span class="brand-logo-sub">Green icon + white wordmark</span></div>
              <a href="/brand/logos/underwings-lockup-primary.png?v=2" download class="brand-logo-dl" aria-label="Download primary lockup">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 2v9M4 8l4 4 4-4M2 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <!-- Light bg -->
          <div class="brand-logo-card brand-logo-light">
            <div class="brand-logo-preview"><img src="/brand/logos/underwings-lockup-light.png?v=2" alt="Light lockup — green icon + black wordmark" loading="lazy"></div>
            <div class="brand-logo-info">
              <div><span class="brand-logo-label">Light backgrounds</span><span class="brand-logo-sub">Green icon + black wordmark</span></div>
              <a href="/brand/logos/underwings-lockup-light.png?v=2" download class="brand-logo-dl" aria-label="Download light lockup">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 2v9M4 8l4 4 4-4M2 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <!-- Monochrome green -->
          <div class="brand-logo-card brand-logo-light">
            <div class="brand-logo-preview"><img src="/brand/logos/underwings-lockup-green.png?v=2" alt="Monochrome green lockup" loading="lazy"></div>
            <div class="brand-logo-info">
              <div><span class="brand-logo-label">Monochrome — green</span><span class="brand-logo-sub">Single-color brand tint</span></div>
              <a href="/brand/logos/underwings-lockup-green.png?v=2" download class="brand-logo-dl" aria-label="Download green monochrome lockup">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 2v9M4 8l4 4 4-4M2 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
          <!-- Reversed / white -->
          <div class="brand-logo-card brand-logo-dark">
            <div class="brand-logo-preview"><img src="/brand/logos/underwings-lockup-white.png?v=2" alt="Reversed white lockup" loading="lazy"></div>
            <div class="brand-logo-info">
              <div><span class="brand-logo-label">Reversed — white</span><span class="brand-logo-sub">For colored / photo backgrounds</span></div>
              <a href="/brand/logos/underwings-lockup-white.png?v=2" download class="brand-logo-dl" aria-label="Download white reversed lockup">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M8 2v9M4 8l4 4 4-4M2 13h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ ICON + WORDMARK ============ -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div style="text-align: center; margin-bottom: 1.75rem;">
          <div class="brand-label"><div class="text-small color-grey">Mark & Wordmark</div></div>
          <h2 class="heading heading-center" style="margin-top: 0.75rem;">Icon & <span class="text-gradient-clip bg-color-green-gradient">Wordmark</span></h2>
          <p class="text" style="max-width: 580px; margin: 1rem auto 0; text-align: center; color: rgba(255,255,255,0.6);">Use the icon for favicons, app tiles, and tight spaces. Use the wordmark alone in text-heavy contexts where the icon would duplicate context.</p>
        </div>

        <div class="brand-asset-grid">
          <!-- Icon green -->
          <div class="brand-asset-card">
            <div class="brand-asset-preview brand-asset-light"><img src="/brand/logos/underwings-icon-green.png?v=2" alt="Icon — green" loading="lazy"></div>
            <div class="brand-asset-info">
              <span class="brand-asset-name">Icon — Primary</span>
              <span class="brand-asset-spec">Green square · PNG</span>
              <a href="/brand/logos/underwings-icon-green.png?v=2" download class="brand-asset-dl">Download</a>
            </div>
          </div>
          <!-- Icon black -->
          <div class="brand-asset-card">
            <div class="brand-asset-preview brand-asset-dark"><img src="/brand/logos/underwings-icon-black.png?v=2" alt="Icon — black" loading="lazy"></div>
            <div class="brand-asset-info">
              <span class="brand-asset-name">Icon — Black</span>
              <span class="brand-asset-spec">For neutral surfaces · PNG</span>
              <a href="/brand/logos/underwings-icon-black.png?v=2" download class="brand-asset-dl">Download</a>
            </div>
          </div>
          <!-- Icon mono -->
          <div class="brand-asset-card">
            <div class="brand-asset-preview brand-asset-light"><img src="/brand/logos/underwings-icon-mono.png?v=2" alt="Icon — monochrome" loading="lazy"></div>
            <div class="brand-asset-info">
              <span class="brand-asset-name">Icon — Mono</span>
              <span class="brand-asset-spec">Single-ink press · PNG</span>
              <a href="/brand/logos/underwings-icon-mono.png?v=2" download class="brand-asset-dl">Download</a>
            </div>
          </div>
          <!-- Wordmark dark -->
          <div class="brand-asset-card">
            <div class="brand-asset-preview brand-asset-light"><img src="/brand/logos/underwings-wordmark-dark.png?v=2" alt="Wordmark — dark" loading="lazy"></div>
            <div class="brand-asset-info">
              <span class="brand-asset-name">Wordmark — Dark</span>
              <span class="brand-asset-spec">For light backgrounds · PNG</span>
              <a href="/brand/logos/underwings-wordmark-dark.png?v=2" download class="brand-asset-dl">Download</a>
            </div>
          </div>
          <!-- Wordmark light -->
          <div class="brand-asset-card">
            <div class="brand-asset-preview brand-asset-dark"><img src="/brand/logos/underwings-wordmark-light.png?v=2" alt="Wordmark — light" loading="lazy"></div>
            <div class="brand-asset-info">
              <span class="brand-asset-name">Wordmark — Light</span>
              <span class="brand-asset-spec">For dark backgrounds · PNG</span>
              <a href="/brand/logos/underwings-wordmark-light.png?v=2" download class="brand-asset-dl">Download</a>
            </div>
          </div>
          <!-- Favicon set -->
          <div class="brand-asset-card">
            <div class="brand-asset-preview brand-asset-dark brand-favicon-strip">
              <img src="/brand/favicons/icon-512.png?v=2" alt="512px" loading="lazy" width="56" height="56">
              <img src="/brand/favicons/icon-180.png?v=2" alt="180px" loading="lazy" width="40" height="40">
              <img src="/brand/favicons/icon-32.png?v=2"  alt="32px"  loading="lazy" width="28" height="28">
              <img src="/brand/favicons/icon-16.png?v=2"  alt="16px"  loading="lazy" width="18" height="18">
            </div>
            <div class="brand-asset-info">
              <span class="brand-asset-name">Favicons</span>
              <span class="brand-asset-spec">16 · 32 · 180 · 192 · 512 px</span>
              <div class="brand-favicon-dl-row">
                <a href="/brand/favicons/icon-16.png?v=2"  download class="brand-asset-dl-mini">16</a>
                <a href="/brand/favicons/icon-32.png?v=2"  download class="brand-asset-dl-mini">32</a>
                <a href="/brand/favicons/icon-180.png?v=2" download class="brand-asset-dl-mini">180</a>
                <a href="/brand/favicons/icon-192.png?v=2" download class="brand-asset-dl-mini">192</a>
                <a href="/brand/favicons/icon-512.png?v=2" download class="brand-asset-dl-mini">512</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ CLEAR SPACE + MIN SIZE ============ -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div style="text-align: center; margin-bottom: 1.75rem;">
          <div class="brand-label"><div class="text-small color-grey">Construction</div></div>
          <h2 class="heading heading-center" style="margin-top: 0.75rem;">Clear Space & <span class="text-gradient-clip bg-color-green-gradient">Sizing</span></h2>
        </div>

        <div class="brand-construct-grid">
          <!-- Clear space diagram -->
          <div class="brand-construct-card">
            <div class="brand-construct-visual">
              <div class="brand-clearspace-box">
                <span class="brand-clearspace-marker brand-cs-t">x</span>
                <span class="brand-clearspace-marker brand-cs-r">x</span>
                <span class="brand-clearspace-marker brand-cs-b">x</span>
                <span class="brand-clearspace-marker brand-cs-l">x</span>
                <img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Clear space example">
              </div>
            </div>
            <div class="brand-construct-info">
              <h3 class="brand-construct-title">Clear Space</h3>
              <p class="brand-construct-text">Keep clear space equal to the height of the icon (<strong>x</strong>) on all four sides. Never crowd the mark with type, imagery, or other logos.</p>
            </div>
          </div>
          <!-- Min size -->
          <div class="brand-construct-card">
            <div class="brand-construct-visual">
              <div class="brand-minsize-row">
                <div class="brand-minsize-item">
                  <img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Minimum digital size" style="height: 24px;">
                  <span class="brand-minsize-label">120px digital</span>
                </div>
                <div class="brand-minsize-item">
                  <img src="/brand/logos/underwings-icon-green.png?v=2" alt="Minimum icon size" style="height: 24px; width: 24px;">
                  <span class="brand-minsize-label">24px icon</span>
                </div>
                <div class="brand-minsize-item">
                  <img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Minimum print size" style="height: 18px;">
                  <span class="brand-minsize-label">30mm print</span>
                </div>
              </div>
            </div>
            <div class="brand-construct-info">
              <h3 class="brand-construct-title">Minimum Size</h3>
              <p class="brand-construct-text">Never reproduce the lockup below <strong>120 px / 30 mm</strong>. Below that, use the icon alone at 24 px minimum so the "U" remains legible.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ DO / DON'T ============ -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div style="text-align: center; margin-bottom: 1.75rem;">
          <div class="brand-label"><div class="text-small color-grey">Rules</div></div>
          <h2 class="heading heading-center" style="margin-top: 0.75rem;">Do & <span class="text-gradient-clip bg-color-green-gradient">Don't</span></h2>
        </div>

        <div class="brand-dodont-grid">
          <div class="brand-dodont-card brand-do">
            <div class="brand-dodont-visual"><img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Correct usage"></div>
            <div class="brand-dodont-body">
              <span class="brand-dodont-tag brand-tag-do">Do</span>
              <p>Use the primary lockup on dark, high-contrast backgrounds.</p>
            </div>
          </div>
          <div class="brand-dodont-card brand-do">
            <div class="brand-dodont-visual brand-bg-light"><img src="/brand/logos/underwings-lockup-light.png?v=2" alt="Correct light-bg usage"></div>
            <div class="brand-dodont-body">
              <span class="brand-dodont-tag brand-tag-do">Do</span>
              <p>Swap to the light-background lockup on any surface lighter than #F0F0F0.</p>
            </div>
          </div>
          <div class="brand-dodont-card brand-dont">
            <div class="brand-dodont-visual"><img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Stretched logo" style="transform: scaleX(1.6);"></div>
            <div class="brand-dodont-body">
              <span class="brand-dodont-tag brand-tag-dont">Don't</span>
              <p>Never stretch, squash, or distort the proportions of the mark.</p>
            </div>
          </div>
          <div class="brand-dodont-card brand-dont">
            <div class="brand-dodont-visual"><img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Rotated logo" style="transform: rotate(-8deg);"></div>
            <div class="brand-dodont-body">
              <span class="brand-dodont-tag brand-tag-dont">Don't</span>
              <p>Never rotate or tilt the logo. Keep the baseline horizontal at all times.</p>
            </div>
          </div>
          <div class="brand-dodont-card brand-dont">
            <div class="brand-dodont-visual" style="background: linear-gradient(135deg, #ff4b4b, #b63cc7);"><img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Off-brand color backdrop"></div>
            <div class="brand-dodont-body">
              <span class="brand-dodont-tag brand-tag-dont">Don't</span>
              <p>Never place on low-contrast or off-brand color fields. Use reversed white instead.</p>
            </div>
          </div>
          <div class="brand-dodont-card brand-dont">
            <div class="brand-dodont-visual"><img src="/brand/logos/underwings-lockup-primary.png?v=2" alt="Recoloured logo" style="filter: hue-rotate(180deg) saturate(1.4);"></div>
            <div class="brand-dodont-body">
              <span class="brand-dodont-tag brand-tag-dont">Don't</span>
              <p>Never recolor the icon or wordmark outside the approved palette.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ COLORS ============ -->
    <section class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div style="text-align: center; margin-bottom: 1.75rem;">
          <div class="brand-label">
            <div class="text-small color-grey">Colors</div>
          </div>
          <h2 class="heading heading-center" style="margin-top: 0.75rem;">Color <span class="text-gradient-clip bg-color-green-gradient">Palette</span></h2>
        </div>

        <div class="brand-color-grid">
          <!-- Primary -->
          <div class="brand-color-card">
            <div class="brand-color-swatch" style="background: #24d758;"></div>
            <div class="brand-color-details">
              <span class="brand-color-name">Green Primary</span>
              <code class="brand-color-code">#24D758</code>
              <span class="brand-color-use">Accents, CTAs, highlights</span>
            </div>
          </div>
          <div class="brand-color-card">
            <div class="brand-color-swatch" style="background: #27dab4;"></div>
            <div class="brand-color-details">
              <span class="brand-color-name">Teal Secondary</span>
              <code class="brand-color-code">#27DAB4</code>
              <span class="brand-color-use">Gradient end, secondary accent</span>
            </div>
          </div>
          <div class="brand-color-card">
            <div class="brand-color-swatch" style="background: linear-gradient(135deg, #24d758, #27dab4);"></div>
            <div class="brand-color-details">
              <span class="brand-color-name">Brand Gradient</span>
              <code class="brand-color-code">#24D758 → #27DAB4</code>
              <span class="brand-color-use">Headings, badges, key elements</span>
            </div>
          </div>
          <!-- Neutrals -->
          <div class="brand-color-card">
            <div class="brand-color-swatch" style="background: #171717;"></div>
            <div class="brand-color-details">
              <span class="brand-color-name">Black</span>
              <code class="brand-color-code">#171717</code>
              <span class="brand-color-use">Primary background</span>
            </div>
          </div>
          <div class="brand-color-card">
            <div class="brand-color-swatch" style="background: #1e1e1e;"></div>
            <div class="brand-color-details">
              <span class="brand-color-name">Dark</span>
              <code class="brand-color-code">#1E1E1E</code>
              <span class="brand-color-use">Card backgrounds, sections</span>
            </div>
          </div>
          <div class="brand-color-card">
            <div class="brand-color-swatch" style="background: #ffffff; border: 1px solid rgba(255,255,255,0.15);"></div>
            <div class="brand-color-details">
              <span class="brand-color-name">White</span>
              <code class="brand-color-code">#FFFFFF</code>
              <span class="brand-color-use">Primary text, headings</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ TYPOGRAPHY ============ -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container">
        <div style="text-align: center; margin-bottom: 1.75rem;">
          <div class="brand-label">
            <div class="text-small color-grey">Typography</div>
          </div>
          <h2 class="heading heading-center" style="margin-top: 0.75rem;">Type <span class="text-gradient-clip bg-color-green-gradient">System</span></h2>
        </div>

        <div class="brand-type-grid">
          <!-- Geist -->
          <div class="brand-type-card">
            <div class="brand-type-preview" style="font-family: 'Geist', sans-serif;">
              <span class="brand-type-sample">Aa</span>
              <span class="brand-type-alphabet">ABCDEFGHIJKLMNOPQRSTUVWXYZ<br>abcdefghijklmnopqrstuvwxyz<br>0123456789</span>
            </div>
            <div class="brand-type-info">
              <span class="brand-type-name">Geist</span>
              <span class="brand-type-use">Headings & Display</span>
