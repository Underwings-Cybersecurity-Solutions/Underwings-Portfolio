---
// ===========================================
// CAREERS PAGE
// Underwings Cybersecurity Solutions
// ===========================================

export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { supabase } from '../lib/supabase';

let positions: Array<{title: string; location: string; description: string; requirements: string[]; status: string}> = [];
try {
  const { data } = await supabase
    .from('career_openings')
    .select('title, location, description, requirements, status')
    .order('display_order', { ascending: true });
  if (data) positions = data;
} catch {
  // empty fallback
}

const activePositions = positions.filter(p => p.status === 'active');
const futurePositions = positions.filter(p => p.status === 'future');

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Careers", "item": "https://underwings.org/careers" }
  ]
};
---

<Layout
  title="Careers — Join Underwings | Cybersecurity Jobs UAE"
  description="Join Underwings, a UAE cybersecurity practice hiring named, certified practitioners across penetration testing, GRC and cloud security."
  keywords="cybersecurity jobs UAE, penetration tester jobs UAE, ISO 27001 consultant jobs, security careers Abu Dhabi"
  wfPage="careers-page"
  schema={breadcrumbSchema}
  bodyClass="body"
>
  <Header currentPage="careers" />

  <main id="main" class="main">

    <!-- ───────── HERO ───────── -->
    <section class="section top-padding-small bottom-padding-medium">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper crs-hero">
              <div class="label"><div class="text-small color-grey">Careers</div></div>
              <h1 class="heading-large hero-heading-large">Work with named practitioners.<br><span class="text-gradient-clip bg-color-green-gradient">No anonymous juniors.</span></h1>
              <p class="text text-center crs-sub">Underwings is a small UAE cybersecurity practice. We work on real engagements — pen tests, ISO&nbsp;27001 implementations, cloud reviews — and we put the people doing the work on the engagement letter. If that matches how you want to work, read on.</p>
              <div class="crs-hero-cta">
                <a href="#openings" class="crs-btn crs-btn-primary">
                  <span>See open roles</span>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <a href="mailto:careers@underwings.org" class="crs-btn crs-btn-secondary">
                  <span>Email careers@underwings.org</span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── WHY UNDERWINGS ───────── -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="vertical-heading-top">
          <div class="label"><div class="text-small color-grey">Why join</div></div>
          <h2 class="heading heading-center">A practice, not an <span class="text-gradient-clip bg-color-green-gradient">agency</span></h2>
          <p class="crs-section-sub">Three things you'll get here that are hard to find at larger firms.</p>
        </div>

        <div class="crs-why-grid">
          <div class="crs-why">
            <h3 class="crs-why-title">Real engagements from week one</h3>
            <p class="crs-why-desc">Live pen tests, real ISMS implementations, real cloud reviews. You'll be on the kickoff call, in the report, and in front of the client. No sandbox period.</p>
          </div>
          <div class="crs-why">
            <h3 class="crs-why-title">Your name on the work</h3>
            <p class="crs-why-desc">Engagement letters list the practitioners. Reports are signed. Clients know who is testing their systems. We don't hide our team behind a generic firm name.</p>
          </div>
          <div class="crs-why">
            <h3 class="crs-why-title">Remote-first, output-measured</h3>
            <p class="crs-why-desc">UAE-anchored, but the team works from where it works best. We measure delivery quality and client outcomes, not seat-time. Async by default; deep-work blocks protected.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ───────── OPEN ROLES ───────── -->
    <section id="openings" class="section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="vertical-heading-top">
          <div class="label"><div class="text-small color-grey">Open roles</div></div>
          <h2 class="heading heading-center">Currently <span class="text-gradient-clip bg-color-green-gradient">hiring</span></h2>
          <p class="crs-section-sub">{activePositions.length > 0
            ? `${activePositions.length} position${activePositions.length === 1 ? '' : 's'} actively recruiting. Future openings listed below — register interest early.`
            : 'No active openings right now. Below are the roles we plan to open as we grow — express interest early and we\'ll reach out when we open them.'}</p>
        </div>

        {positions.length === 0 ? (
          <div class="crs-empty">
            <p>No openings published yet. Send your CV to <a href="mailto:careers@underwings.org">careers@underwings.org</a> and we'll keep you in mind as roles open.</p>
          </div>
        ) : (
          <div class="crs-roles">
            {[...activePositions, ...futurePositions].map((p) => (
              <article class="crs-role">
                <div class="crs-role-head">
                  <h3 class="crs-role-title">{p.title}</h3>
                  <div class="crs-role-meta">
                    <span class={p.status === 'active' ? 'crs-pill crs-pill-active' : 'crs-pill crs-pill-future'}>{p.status === 'active' ? 'Hiring now' : 'Planned'}</span>
                    <span class="crs-pill crs-pill-loc">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                      {p.location}
                    </span>
                  </div>
                </div>
                <p class="crs-role-desc">{p.description}</p>
                {p.requirements && p.requirements.length > 0 && (
                  <ul class="crs-role-reqs">
                    {p.requirements.map((r) => (<li>{r}</li>))}
                  </ul>
                )}
                <a href={`mailto:careers@underwings.org?subject=${encodeURIComponent('Interest: ' + p.title)}`} class="crs-role-apply">
                  {p.status === 'active' ? 'Apply' : 'Express interest'}
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </article>
            ))}
          </div>
        )}
      </div>
    </section>

    <!-- ───────── WHAT WE LOOK FOR ───────── -->
    <section class="section bg-color-dark">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="vertical-heading-top">
          <div class="label"><div class="text-small color-grey">What we look for</div></div>
          <h2 class="heading heading-center">Honest about <span class="text-gradient-clip bg-color-green-gradient">our bar</span></h2>
          <p class="crs-section-sub">Whatever the role, four things matter to us — in this order.</p>
        </div>

        <ol class="crs-values">
          <li><strong>Technical depth in your stated craft.</strong> If you say you do web pen-testing, you can walk us through a recent finding end-to-end — discovery, exploitation, business impact, remediation guidance. Same applies to ISO&nbsp;27001 work, cloud reviews, or engineering.</li>
          <li><strong>Honesty over polish.</strong> "I don't know" is a complete sentence in interviews and on engagements. Saying you've done something you haven't is the fastest way out.</li>
          <li><strong>Writing that stands up.</strong> Half of security work is the report. If your written English is sharp, we read it; if it isn't, the client will spot it.</li>
          <li><strong>Ownership.</strong> Engagements have edges nobody owns by default — scoping calls, late-hour findings, the awkward client conversation. We notice who picks them up.</li>
        </ol>
      </div>
    </section>

    <!-- ───────── HOW TO APPLY ───────── -->
    <section class="section bg-color-grey-gradient">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="vertical-heading-top" style="text-align:center;">
          <div class="label" style="margin: 0 auto;"><div class="text-small color-grey">How to apply</div></div>
          <h2 class="heading heading-center">Three steps. <span class="text-gradient-clip bg-color-green-gradient">No theatre.</span></h2>
          <p class="crs-section-sub" style="margin-left:auto;margin-right:auto;">Email <a href="mailto:careers@underwings.org" class="crs-link">careers@underwings.org</a> with your CV and a short note (3–5 sentences) about which role you want and why. We reply within one working day, even if it's a no.</p>

          <ol class="crs-steps">
            <li><strong>Apply</strong><span>CV + short note</span></li>
            <li><strong>Intro call</strong><span>30 minutes, founder + one practitioner</span></li>
            <li><strong>Craft check</strong><span>A relevant exercise or technical conversation — never unpaid client work</span></li>
          </ol>

          <div class="crs-apply-cta">
            <a href="mailto:careers@underwings.org" class="crs-btn crs-btn-primary">
              <span>Email careers@underwings.org</span>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/underwings-cybersecurity" target="_blank" rel="noopener noreferrer nofollow" class="crs-btn crs-btn-secondary">
              <span>or message us on LinkedIn</span>
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style is:inline>
  /* ───────── Hero ───────── */
  .crs-hero { display: flex; flex-direction: column; align-items: center; gap: 1.1rem; }
  .crs-hero > * { margin: 0; }
  .crs-sub { max-width: 660px; color: rgba(255,255,255,0.62); }
  .crs-hero-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; margin-top: 0.75rem; }

  /* ───────── Buttons (shared with section CTAs) ───────── */
  .crs-btn {
    display: inline-flex; align-items: center; gap: 0.55rem;
    padding: 0.85rem 1.3rem; border-radius: 10px;
    font-family: 'Geist', sans-serif; font-weight: 600; font-size: 0.92rem;
    text-decoration: none; transition: all 0.2s ease;
    border: 1px solid transparent;
  }
  .crs-btn-primary { background: #24d758; color: #051a0c; }
  .crs-btn-primary:hover { background: #1fc54f; transform: translateY(-1px); }
  .crs-btn-secondary { background: rgba(255,255,255,0.04); color: #fff; border-color: rgba(255,255,255,0.12); }
  .crs-btn-secondary:hover { background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.2); }

  /* ───────── Section sub-text ───────── */
  .crs-section-sub {
    max-width: 600px; margin: 0.6rem auto 2.5rem;
    text-align: center; color: rgba(255,255,255,0.55);
    font-size: 0.95rem; line-height: 1.65;
  }

  /* ───────── Why-join cards ───────── */
  .crs-why-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem;
  }
  .crs-why {
    padding: 1.6rem; border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; background: rgba(255,255,255,0.015);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .crs-why:hover { border-color: rgba(36,215,88,0.25); background: rgba(36,215,88,0.025); }
  .crs-why-title {
    font-family: 'Geist', sans-serif; font-size: 1.05rem; font-weight: 600;
    color: #fff; margin: 0 0 0.5rem; letter-spacing: -0.01em;
  }
  .crs-why-desc {
    margin: 0; font-size: 0.9rem; color: rgba(255,255,255,0.6); line-height: 1.6;
  }
  @media (max-width: 800px) { .crs-why-grid { grid-template-columns: 1fr; } }

  /* ───────── Roles list ───────── */
  .crs-roles {
    display: flex; flex-direction: column; gap: 0.85rem;
    max-width: 820px; margin: 0 auto;
  }
  .crs-role {
    padding: 1.5rem 1.6rem; border: 1px solid rgba(255,255,255,0.08);
    border-radius: 12px; background: rgba(255,255,255,0.015);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .crs-role:hover { border-color: rgba(36,215,88,0.22); background: rgba(36,215,88,0.02); }
  .crs-role-head {
    display: flex; align-items: flex-start; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap; margin-bottom: 0.5rem;
  }
  .crs-role-title {
    font-family: 'Geist', sans-serif; font-size: 1.1rem; font-weight: 600;
    color: #fff; margin: 0; letter-spacing: -0.01em;
  }
  .crs-role-meta { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .crs-pill {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.7rem; font-weight: 600; font-family: 'Geist Mono', monospace;
    padding: 0.25rem 0.6rem; border-radius: 100px;
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .crs-pill-active { background: rgba(36,215,88,0.12); color: #24d758; border: 1px solid rgba(36,215,88,0.25); }
  .crs-pill-future { background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.55); border: 1px solid rgba(255,255,255,0.1); }
  .crs-pill-loc { background: transparent; color: rgba(255,255,255,0.5); border: 1px solid rgba(255,255,255,0.08); text-transform: none; letter-spacing: 0; }
  .crs-role-desc { font-size: 0.92rem; color: rgba(255,255,255,0.65); line-height: 1.65; margin: 0.4rem 0 0.8rem; }
  .crs-role-reqs {
    list-style: none; padding: 0; margin: 0 0 1rem;
    display: flex; flex-wrap: wrap; gap: 0.4rem 0.7rem;
  }
  .crs-role-reqs li {
    font-size: 0.78rem; color: rgba(255,255,255,0.55);
    padding: 0.25rem 0.6rem; background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06); border-radius: 6px;
  }
  .crs-role-apply {
    display: inline-flex; align-items: center; gap: 0.4rem;
    color: #24d758; font-weight: 600; font-size: 0.88rem;
    text-decoration: none; transition: gap 0.2s ease;
  }
  .crs-role-apply:hover { gap: 0.6rem; }
  .crs-empty {
    text-align: center; padding: 2rem; max-width: 520px; margin: 0 auto;
    border: 1px dashed rgba(255,255,255,0.1); border-radius: 12px;
    color: rgba(255,255,255,0.6);
  }
  .crs-empty a { color: #24d758; text-decoration: none; border-bottom: 1px dashed rgba(36,215,88,0.4); }

  /* ───────── Values (numbered list) ───────── */
  .crs-values {
    counter-reset: cv; list-style: none; padding: 0;
    max-width: 720px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 1rem;
  }
  .crs-values li {
    counter-increment: cv;
    position: relative; padding: 1.2rem 1.4rem 1.2rem 3.2rem;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    color: rgba(255,255,255,0.7); font-size: 0.95rem; line-height: 1.7;
  }
  .crs-values li::before {
    content: counter(cv, decimal-leading-zero);
    position: absolute; left: 1.2rem; top: 1.2rem;
    font-family: 'Geist Mono', monospace; font-size: 0.78rem;
    font-weight: 700; color: #24d758; letter-spacing: 0.04em;
  }
  .crs-values strong { color: #fff; font-weight: 600; }

  /* ───────── How-to-apply steps ───────── */
  .crs-link { color: #24d758; text-decoration: none; border-bottom: 1px dashed rgba(36,215,88,0.4); }
  .crs-steps {
    counter-reset: cs; list-style: none; padding: 0;
    max-width: 760px; margin: 1.5rem auto 2rem;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.85rem;
    text-align: left;
  }
  .crs-steps li {
    counter-increment: cs;
    padding: 1.1rem 1.2rem; border-radius: 10px;
    background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.08);
    display: flex; flex-direction: column; gap: 0.3rem;
    position: relative;
  }
  .crs-steps li::before {
    content: counter(cs);
    position: absolute; right: 1rem; top: 0.85rem;
    font-family: 'Geist Mono', monospace; font-size: 1.2rem;
    color: rgba(36,215,88,0.35); font-weight: 700;
  }
  .crs-steps strong { color: #fff; font-weight: 600; font-size: 0.95rem; font-family: 'Geist', sans-serif; letter-spacing: -0.01em; }
  .crs-steps span { color: rgba(255,255,255,0.55); font-size: 0.82rem; line-height: 1.55; }
  @media (max-width: 720px) { .crs-steps { grid-template-columns: 1fr; } }

  .crs-apply-cta { display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center; margin-top: 1rem; }
</style>
