---
// ===========================================
// BLOG LISTING PAGE
// ===========================================
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getBlogPosts } from '../../lib/supabase';

const POSTS_PER_PAGE = 12;
const pageParam = Astro.url.searchParams.get('page');
const currentPage = Math.max(1, parseInt(pageParam || '1', 10) || 1);
const offset = (currentPage - 1) * POSTS_PER_PAGE;

// Fetch one extra to know if there's a next page
const posts = await getBlogPosts(POSTS_PER_PAGE + 1, offset);
const hasNextPage = posts.length > POSTS_PER_PAGE;
const displayPosts = hasNextPage ? posts.slice(0, POSTS_PER_PAGE) : posts;

// Split featured post (first post on page 1) from the rest
const featuredPost = currentPage === 1 && displayPosts.length > 0 ? displayPosts[0] : null;
const gridPosts = currentPage === 1 ? displayPosts.slice(1) : displayPosts;

// Extract unique categories for filter
const allCategories = [...new Set(displayPosts.map(p => p.category).filter(Boolean))];

// Helper: estimate read time
function readTime(content: string) {
  if (!content) return 1;
  return Math.max(1, Math.round(content.split(/\s+/).length / 230));
}

// Helper: format date
function fmtDate(d: string) {
  return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://underwings.org" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://underwings.org/blog" }
  ]
};
---

<Layout
  title={currentPage > 1 ? `Blog - Page ${currentPage} - Underwings Cybersecurity Solutions` : "Blog - Underwings Cybersecurity Solutions"}
  description="Expert insights on cybersecurity, compliance frameworks, penetration testing, and security best practices from the Underwings team. Stay ahead of threats."
  keywords="cybersecurity blog, penetration testing insights, ISO 27001 guide, security best practices, VAPT blog, compliance tips, cybersecurity news UAE"
  schema={breadcrumbSchema}
  noindex={currentPage > 1}
  canonical={currentPage > 1 ? `${Astro.url.origin}/blog?page=${currentPage}` : undefined}
>
  <Fragment slot="head">
    {currentPage > 1 && <link rel="prev" href={currentPage === 2 ? '/blog' : `/blog?page=${currentPage - 1}`} />}
    {hasNextPage && <link rel="next" href={`/blog?page=${currentPage + 1}`} />}
  </Fragment>
  <Header currentPage="blog" />

  <main id="main" class="main">
    <!-- Hero -->
    <section class="section bottom-padding-clear top-padding-small">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        <div class="hero">
          <div class="hero-main-wrapper">
            <div class="hero-heading-wrapper">
              <div class="label">
                <div class="text-small color-grey">Blog</div>
              </div>
              <h1 class="heading-large hero-heading-large">Security Insights & <span class="text-gradient-clip bg-color-green-gradient">Resources</span></h1>
              <p class="text text-center bl-hero-subtitle">Expert insights on cybersecurity, compliance frameworks, penetration testing, and security best practices.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Category Filter -->
    {allCategories.length > 1 && (
      <section class="bl-filter-section">
        <div class="container-medium">
          <div class="bl-filter-bar" id="bl-filter-bar">
            <button class="bl-filter-chip is-active" data-category="all">All Posts</button>
            {allCategories.map(cat => (
              <button class="bl-filter-chip" data-category={cat}>{cat}</button>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Featured Post (page 1 only) -->
    {featuredPost && (
      <section class="bl-featured-section">
        <div class="container-medium">
          <a href={`/blog/${featuredPost.slug}`} class="bl-featured" data-category={featuredPost.category}>
            <div class="bl-featured-content">
              <div class="bl-featured-meta-row">
                {featuredPost.category && <span class="bl-featured-cat">{featuredPost.category}</span>}
                <span class="bl-featured-dot">&middot;</span>
                <span class="bl-featured-date">{fmtDate(featuredPost.published_at)}</span>
                <span class="bl-featured-dot">&middot;</span>
                <span class="bl-featured-read">{readTime(featuredPost.content)} min read</span>
              </div>
              <h2 class="bl-featured-title">{featuredPost.title}</h2>
              {featuredPost.excerpt && <p class="bl-featured-excerpt">{featuredPost.excerpt}</p>}
              <div class="bl-featured-cta">
                <span class="bl-featured-link">Read article</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </div>
            </div>
            <div class="bl-featured-visual">
              {featuredPost.featured_image ? (
                <img src={featuredPost.featured_image} alt={featuredPost.title} loading="eager" />
              ) : (
                <div class="bl-featured-placeholder">
                  <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.3"><path d="M12 2L4 6v6c0 5.5 3.5 8.5 8 10 4.5-1.5 8-4.5 8-10V6l-8-4z"/><path d="M9 12l2 2 4-4"/></svg>
                </div>
              )}
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- Posts Grid -->
    <section class="bl-grid-section">
      <div data-wf--noise--variant="absolute" class="noise-wrapper w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab">
        <div class="noise w-variant-4c0280f5-2522-b840-9cb4-de0542cf64ab"></div>
      </div>
      <div class="container-medium">
        {gridPosts.length > 0 ? (
          <div class="bl-grid" id="bl-grid">
            {gridPosts.map((post, i) => (
              <a href={`/blog/${post.slug}`} class="bl-card bl-stagger" data-category={post.category}>
                <div class="bl-card-image">
                  {post.featured_image ? (
                    <img src={post.featured_image} alt={post.title} loading="lazy" width="600" height="338" />
                  ) : (
                    <div class="bl-card-placeholder">
                      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                      </svg>
                    </div>
                  )}
                </div>
                <div class="bl-card-body">
                  <div class="bl-card-top">
                    {post.category && <span class="bl-card-cat">{post.category}</span>}
                    <span class="bl-card-readtime">{readTime(post.content)} min</span>
                  </div>
                  <h3 class="bl-card-title">{post.title}</h3>
                  {post.excerpt && <p class="bl-card-excerpt">{post.excerpt}</p>}
                  <div class="bl-card-meta">
                    {post.author_name && <span class="bl-card-author">{post.author_name}</span>}
                    {post.published_at && <span class="bl-card-date">{fmtDate(post.published_at)}</span>}
                  </div>
                </div>
                <div class="bl-card-glow"></div>
              </a>
            ))}
          </div>
        ) : currentPage === 1 && !featuredPost ? (
          <div class="bl-empty">
            <div class="bl-empty-icon">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
            </div>
            <p class="bl-empty-text">No blog posts yet. Check back soon!</p>
          </div>
        ) : null}

        <!-- Pagination -->
        {(currentPage > 1 || hasNextPage) && (
          <nav class="bl-pagination" aria-label="Blog pagination">
            {currentPage > 1 ? (
              <a href={currentPage === 2 ? '/blog' : `/blog?page=${currentPage - 1}`} class="bl-page-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                Newer Posts
              </a>
            ) : <span />}
            <span class="bl-page-current">Page {currentPage}</span>
            {hasNextPage ? (
              <a href={`/blog?page=${currentPage + 1}`} class="bl-page-btn">
                Older Posts
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            ) : <span />}
          </nav>
        )}
      </div>
    </section>

    <!-- Newsletter CTA -->
    <section class="bl-newsletter-section">
      <div class="container-medium">
        <div class="bl-newsletter">
          <div class="bl-newsletter-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#24d758" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <h3 class="bl-newsletter-title">Stay ahead of threats</h3>
          <p class="bl-newsletter-desc">Get cybersecurity insights delivered to your inbox. No spam, just actionable security knowledge.</p>
          <a href="/#contact" class="bl-newsletter-btn">
            <span>Subscribe to Updates</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style is:inline>
  /* ---- Hero ---- */
  .bl-hero-subtitle {
    max-width: 620px;
    margin: 1.5rem auto 0;
  }

  /* ---- Filter Bar ---- */
  .bl-filter-section {
    padding: 0 0 1rem;
  }
  .bl-filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0 5vw;
  }
  .bl-filter-chip {
    padding: 0.4rem 1rem;
    border: 1px dashed rgba(255,255,255,0.12);
    border-radius: 20px;
    background: transparent;
    color: rgba(255,255,255,0.5);
    font-size: 0.78rem;
    font-family: 'Geist Mono', monospace;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .bl-filter-chip:hover {
    border-color: rgba(36,215,88,0.35);
    color: rgba(255,255,255,0.8);
  }
  .bl-filter-chip.is-active {
    border-style: solid;
    border-color: rgba(36,215,88,0.5);
    background: rgba(36,215,88,0.06);
    color: #24d758;
  }

  /* ---- Featured Post ---- */
  .bl-featured-section {
    padding: 2rem 0 0;
  }
  .bl-featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.35s ease, box-shadow 0.35s ease;
    position: relative;
  }
  .bl-featured::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 17px;
    padding: 1px;
    background: linear-gradient(135deg, rgba(36,215,88,0), rgba(36,215,88,0), rgba(39,218,180,0));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .bl-featured:hover {
    border-color: rgba(36,215,88,0.25);
    box-shadow: 0 8px 40px rgba(36,215,88,0.06);
  }
  .bl-featured:hover::before {
    background: linear-gradient(135deg, rgba(36,215,88,0.4), rgba(36,215,88,0.1), rgba(39,218,180,0.4));
    opacity: 1;
  }
  .bl-featured-content {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .bl-featured-meta-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  .bl-featured-cat {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #24d758;
    font-weight: 600;
    font-family: 'Geist Mono', monospace;
  }
  .bl-featured-dot {
    color: rgba(255,255,255,0.2);
    font-size: 0.7rem;
  }
  .bl-featured-date,
  .bl-featured-read {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
    font-family: 'Geist Mono', monospace;
  }
  .bl-featured-title {
    font-family: 'Geist', sans-serif;
    font-size: 1.85rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #fff;
    margin-bottom: 1rem;
  }
  .bl-featured-excerpt {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.65;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bl-featured-cta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
  }
  .bl-featured-link {
    font-size: 0.88rem;
    font-weight: 600;
    color: #24d758;
    transition: gap 0.2s ease;
  }
  .bl-featured-cta svg {
    color: #24d758;
    transition: transform 0.25s ease;
  }
  .bl-featured:hover .bl-featured-cta svg {
    transform: translateX(4px);
  }
  .bl-featured-visual {
    position: relative;
    overflow: hidden;
    background: rgba(255,255,255,0.03);
    min-height: 320px;
  }
  .bl-featured-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .bl-featured:hover .bl-featured-visual img {
    transform: scale(1.04);
  }
  .bl-featured-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.15);
    background: linear-gradient(135deg, rgba(36,215,88,0.03), rgba(39,218,180,0.02));
  }
  @media (max-width: 768px) {
    .bl-featured {
      grid-template-columns: 1fr;
    }
    .bl-featured-visual {
      min-height: 200px;
      order: -1;
    }
    .bl-featured-content {
      padding: 1.75rem;
    }
    .bl-featured-title {
      font-size: 1.4rem;
    }
  }

  /* ---- Cards Grid ---- */
  .bl-grid-section {
    padding: 2.5rem 0 2rem;
    position: relative;
  }
  .bl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* ---- Card ---- */
  .bl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .bl-card:hover {
    border-color: rgba(36,215,88,0.3);
    transform: translateY(-4px);
  }
  .bl-card-glow {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    box-shadow: inset 0 0 30px rgba(36,215,88,0.03), 0 0 20px rgba(36,215,88,0.04);
  }
  .bl-card:hover .bl-card-glow {
    opacity: 1;
  }

  .bl-card-image {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: rgba(255,255,255,0.03);
    position: relative;
  }
  .bl-card-image::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 40%;
    background: linear-gradient(to top, rgba(23,23,23,0.6), transparent);
    pointer-events: none;
  }
  .bl-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .bl-card:hover .bl-card-image img {
    transform: scale(1.06);
  }
  .bl-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.12);
    background: linear-gradient(160deg, rgba(36,215,88,0.02), transparent);
  }

  .bl-card-body {
    padding: 1.35rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }
  .bl-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .bl-card-cat {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: #24d758;
    font-weight: 600;
    font-family: 'Geist Mono', monospace;
  }
  .bl-card-readtime {
    font-size: 0.68rem;
    color: rgba(255,255,255,0.3);
    font-family: 'Geist Mono', monospace;
    letter-spacing: 0.02em;
  }
  .bl-card-title {
    font-family: 'Geist', sans-serif;
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.35;
    color: #fff;
    margin: 0;
    letter-spacing: -0.015em;
  }
  .bl-card-excerpt {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.5);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .bl-card-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.35);
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255,255,255,0.05);
    font-family: 'Geist Mono', monospace;
  }

  @media (max-width: 992px) {
    .bl-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .bl-grid { grid-template-columns: 1fr; }
  }

  /* ---- Empty State ---- */
  .bl-empty {
    text-align: center;
    padding: 5rem 2rem;
  }
  .bl-empty-icon {
    color: rgba(255,255,255,0.1);
    margin-bottom: 1.5rem;
  }
  .bl-empty-text {
    color: rgba(255,255,255,0.4);
    font-size: 1rem;
  }

  /* ---- Pagination ---- */
  .bl-pagination {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px dashed rgba(255,255,255,0.08);
  }
  .bl-page-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    background: rgba(255,255,255,0.03);
    border: 1px dashed rgba(255,255,255,0.12);
    border-radius: 8px;
    color: rgba(255,255,255,0.7);
    text-decoration: none;
    font-size: 0.82rem;
    font-family: 'Geist Mono', monospace;
    transition: all 0.25s ease;
  }
  .bl-page-btn:hover {
    background: rgba(36,215,88,0.06);
    border-color: rgba(36,215,88,0.3);
    color: #24d758;
  }
  .bl-page-current {
    color: rgba(255,255,255,0.4);
    font-size: 0.78rem;
    font-family: 'Geist Mono', monospace;
    letter-spacing: 0.05em;
  }

  /* ---- Newsletter CTA ---- */
  .bl-newsletter-section {
    padding: 0 0 5rem;
  }
  .bl-newsletter {
    text-align: center;
    padding: 3rem 2.5rem;
    background: rgba(36,215,88,0.02);
    border: 1px dashed rgba(36,215,88,0.15);
    border-radius: 16px;
    position: relative;
    overflow: hidden;
  }
  .bl-newsletter::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -80px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(36,215,88,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .bl-newsletter::after {
    content: '';
    position: absolute;
    bottom: -60px;
    left: -60px;
    width: 160px;
    height: 160px;
    background: radial-gradient(circle, rgba(39,218,180,0.04) 0%, transparent 70%);
    pointer-events: none;
  }
  .bl-newsletter-icon {
    margin-bottom: 1rem;
  }
  .bl-newsletter-title {
    font-family: 'Geist', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff;
    margin-bottom: 0.6rem;
    letter-spacing: -0.02em;
  }
  .bl-newsletter-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.5);
    max-width: 440px;
    margin: 0 auto 1.75rem;
    line-height: 1.6;
  }
  .bl-newsletter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    background: linear-gradient(135deg, #24d758, #27dab4);
    color: #0a0a0a;
    font-weight: 600;
    font-size: 0.88rem;
    border-radius: 8px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    z-index: 1;
  }
  .bl-newsletter-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(36,215,88,0.2);
  }
  .bl-newsletter-btn svg {
    transition: transform 0.2s ease;
  }
  .bl-newsletter-btn:hover svg {
    transform: translateX(3px);
  }

  /* ---- Stagger animation ---- */
  .bl-stagger {
    opacity: 0;
    transform: translateY(18px);
  }
</style>

<script is:inline nonce={Astro.locals.nonce || ""}>
// Category filter
(function() {
  var bar = document.getElementById('bl-filter-bar');
  if (!bar) return;
  var chips = bar.querySelectorAll('.bl-filter-chip');
  var featured = document.querySelector('.bl-featured');
  var cards = document.querySelectorAll('.bl-card');

  chips.forEach(function(chip) {
    chip.addEventListener('click', function() {
      chips.forEach(function(c) { c.classList.remove('is-active'); });
      chip.classList.add('is-active');
      var cat = chip.getAttribute('data-category');

      // Filter featured
      if (featured) {
        if (cat === 'all' || featured.getAttribute('data-category') === cat) {
          featured.closest('.bl-featured-section').style.display = '';
        } else {
          featured.closest('.bl-featured-section').style.display = 'none';
        }
      }

      // Filter grid cards
      cards.forEach(function(card) {
        if (cat === 'all' || card.getAttribute('data-category') === cat) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
})();

// Stagger animation
(function() {
  if (typeof IntersectionObserver === 'undefined') return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var items = document.querySelectorAll('.bl-stagger');
  items.forEach(function(el) {
    el.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
  });
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        var parent = entry.target.parentElement;
        var siblings = parent ? Array.from(parent.children).filter(function(c) { return c.classList.contains('bl-stagger') && c.style.opacity !== '1'; }) : [];
        var idx = siblings.indexOf(entry.target);
        setTimeout(function() {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }, Math.max(0, idx) * 80);
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });
  items.forEach(function(el) { observer.observe(el); });
})();
</script>
