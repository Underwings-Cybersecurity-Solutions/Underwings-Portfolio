  </div>
</header>

<!-- Noise (kept exactly as original) -->
<div data-wf--noise--variant="base" class="noise-wrapper">
  <div data-w-id="71d94dcc-6696-ef8a-8008-1058c6cb48e2" class="noise"></div>
</div>

<!--
  Mobile drawer — lives here in the source but is teleported to <body>
  by the script below, so position:fixed always uses the real viewport
  (GSAP/Webflow transforms on ancestor elements cannot break it).
-->
<div id="mob-drawer" class="mob-drawer" aria-hidden="true">
  <!-- semi-transparent backdrop -->
  <div class="mob-backdrop" id="mob-backdrop"></div>

  <!-- slide-in panel -->
  <div class="mob-panel" role="dialog" aria-modal="true" aria-label="Navigation">

    <div class="mob-panel-top">
      <a href="/" class="mob-logo">
        <img src="/brand/logos/underwings-lockup-primary.png?v=3" alt="Underwings" width="120">
      </a>
      <button id="mob-close" class="mob-close" aria-label="Close menu" type="button">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M1 1l14 14M15 1L1 15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="mob-nav" aria-label="Mobile navigation">
      <span class="mob-label">Services</span>
      <a href="/services/grc"                     class="mob-link">Cybersecurity GRC</a>
      <a href="/services/grc#managed-grc" class="mob-link mob-link-sub">↳ Managed GRC · Continuous Compliance</a>
      <a href="/services/offensive-security"      class="mob-link">Offensive Security</a>
      <a href="/services/offensive-security#ptaas" class="mob-link mob-link-sub">↳ PTaaS</a>
      <a href="/services/cloud-security"          class="mob-link">Cloud Security</a>
      <a href="/services/network-infrastructure"  class="mob-link">Network &amp; Infrastructure</a>
      <a href="/services/training-awareness"      class="mob-link">Training &amp; Awareness</a>
      <div class="mob-divider"></div>
      <a href="/software" class="mob-link">Software</a>
      <a href="/updates"  class="mob-link">Updates</a>
      <a href="/about"    class="mob-link">About</a>
      <a href="/blog"     class="mob-link">Blog</a>
    </nav>

    <div class="mob-cta">
      <button type="button" class="mob-btn mob-btn-green" data-book-call aria-label="Book a call">Book a Call</button>
      <a href="/#contact" class="mob-btn mob-btn-outline">Let's Talk</a>
    </div>

  </div>
</div>

<!-- ═══════════════════════════════════════════════════
     STYLES — all prefixed mob-* / completely isolated
═══════════════════════════════════════════════════ -->
<style is:global>

  /* suppress Webflow's own hamburger everywhere */
  .w-nav-button { display: none !important; }

  /* hide desktop pieces on mobile */
  @media (max-width: 991px) {
    .uw-desktop-nav { display: none !important; }
    .uw-desktop-cta { display: none !important; }
    .w-nav-menu     { display: none !important; }
  }

  /* ── tighten the header bar on small screens ─────── */
  @media (max-width: 479px) {
    .navbar {
      padding-top: .625rem !important;
      padding-bottom: .625rem !important;
    }
    /* shrink container side gutters */
    .container-medium.header-container-medium {
      padding-left: .875rem !important;
      padding-right: .875rem !important;
    }
    /* smaller logo */
    .logo {
      height: 1.35rem !important;
    }
  }

  /* ── hamburger button ───────────────────────────── */
  .mob-toggle {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: transparent;
    border: 1px dashed rgba(255,255,255,0.35);
    border-radius: 50%;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color .2s;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 991px) {
    .mob-toggle { display: flex; }
  }
  @media (max-width: 479px) {
    .mob-toggle { width: 36px; height: 36px; gap: 4px; }
  }

  /* ── Desktop: hard-hide the mobile drawer entirely ─ */
  /*    Defensive against any rule that might break the
        visibility/transform chain on larger viewports. */
  @media (min-width: 992px) {
    #mob-drawer,
    .mob-drawer,
    .mob-toggle {
      display: none !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
  }
  .mob-toggle:hover { border-color: rgba(255,255,255,.7); }

  .mob-bar {
    display: block;
    width: 16px;
    height: 1.5px;
    border-radius: 2px;
    background: #fff;
    transition: transform .28s ease, opacity .2s ease;
    transform-origin: center center;
  }
  @media (max-width: 479px) {
    .mob-bar { width: 14px; }
  }
  /* X animation */
  .mob-toggle[aria-expanded="true"] .mob-bar-t { transform: translateY(6px)  rotate(45deg);  }
  .mob-toggle[aria-expanded="true"] .mob-bar-m { opacity: 0; transform: scaleX(0);           }
  .mob-toggle[aria-expanded="true"] .mob-bar-b { transform: translateY(-6px) rotate(-45deg); }

  /* ── drawer root (teleported to body by JS) ─────── */
  .mob-drawer {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }
  .mob-drawer.mob-open {
    visibility: visible;
    pointer-events: auto;
  }

  /* ── backdrop ───────────────────────────────────── */
  .mob-backdrop {
    position: fixed;
    inset: 0;
    z-index: 9000;
    background: rgba(0,0,0,.55);
    opacity: 0;
    transition: opacity .3s ease;
  }
  .mob-open .mob-backdrop { opacity: 1; }

  /* ── slide-in panel ─────────────────────────────── */
  .mob-panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 9001;
    /* fluid width: 300px on tablet, scales down on phones */
    width: min(300px, 88vw);
    height: 100vh;
    height: 100dvh;
    background: #0d0d0d;
    border-left: 1px solid rgba(255,255,255,.08);
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition: transform .32s cubic-bezier(.4,0,.2,1);
  }
  /* on very small screens take almost full width */
  @media (max-width: 360px) {
    .mob-panel { width: 92vw; }
  }
  .mob-open .mob-panel { transform: translateX(0); }

  /* ── panel top bar ──────────────────────────────── */
  .mob-panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: .875rem 1rem;
    border-bottom: 1px solid rgba(255,255,255,.07);
    flex-shrink: 0;
  }
  @media (max-width: 479px) {
    .mob-panel-top { padding: .7rem .875rem; }
  }
  .mob-logo img { display: block; width: 110px; height: auto; }
  @media (max-width: 479px) {
    .mob-logo img { width: 96px; }
  }

  .mob-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 7px;
    color: rgba(255,255,255,.7);
    cursor: pointer;
    transition: background .2s, color .2s;
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 479px) {
    .mob-close { width: 30px; height: 30px; border-radius: 6px; }
  }
  .mob-close:hover { background: rgba(255,255,255,.12); color: #fff; }

  /* ── nav links ──────────────────────────────────── */
  .mob-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: .625rem .5rem;
    gap: 1px;
    overflow-y: auto;
  }
  @media (max-width: 479px) {
    .mob-nav { padding: .5rem .375rem; }
  }

  .mob-label {
    display: block;
    padding: .45rem .625rem .25rem;
    font-size: .6rem;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(255,255,255,.3);
  }

  .mob-link {
    display: block;
    padding: .55rem .75rem;
    font-size: .9375rem;
    font-weight: 500;
    color: rgba(255,255,255,.78);
    text-decoration: none;
    border-radius: 7px;
    transition: background .15s, color .15s;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 479px) {
    .mob-link { padding: .5rem .625rem; font-size: .875rem; }
  }
  .mob-link:hover,
  .mob-link:focus-visible { background: rgba(255,255,255,.06); color: #fff; outline: none; }
  .mob-link-dim { color: rgba(255,255,255,.35); font-size: .85rem; }
  .mob-link-sub { padding-left: 1.5rem; color: rgba(36,215,88,0.85); font-size: .85rem; }
  @media (max-width: 479px) {
    .mob-link-dim { font-size: .8rem; }
    .mob-link-sub { font-size: .8rem; }
  }
  .nav-mega-sub { padding-left: 2.4rem !important; opacity: 0.92; }
  .nav-mega-new {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.06rem 0.35rem;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #0a0a0a;
    background: linear-gradient(135deg, #24d758, #27dab4);
    border-radius: 4px;
    vertical-align: middle;
  }
  .mob-divider { height: 1px; background: rgba(255,255,255,.07); margin: .4rem 0; }

  /* ── CTA buttons ────────────────────────────────── */
  .mob-cta {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    padding: .75rem .75rem 2rem;
    border-top: 1px solid rgba(255,255,255,.07);
    flex-shrink: 0;
  }
  @media (max-width: 479px) {
    .mob-cta { padding: .625rem .625rem 1.5rem; gap: .4rem; }
  }

  .mob-btn {
    display: block;
    width: 100%;
    text-align: center;
    text-decoration: none;
    font-family: inherit;
    font-size: .9rem;
    font-weight: 600;
    padding: .7rem 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity .2s;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 479px) {
    .mob-btn { font-size: .825rem; padding: .6rem .875rem; border-radius: 7px; }
  }
  .mob-btn:hover { opacity: .85; }
  .mob-btn-green   { background: #24d758; color: #000; }
  .mob-btn-outline {
    background: transparent;
    color: rgba(255,255,255,.8);
    border: 1px solid rgba(255,255,255,.18);
  }

  /* ═══════════════════════════════════════════════════
     Auto-hide navbar on scroll-down, reveal on scroll-up
  ═══════════════════════════════════════════════════ */
  .header {
    transition: transform .35s cubic-bezier(.22, 1, .36, 1),
                background-color .25s ease,
                backdrop-filter .25s ease,
                box-shadow .25s ease;
    will-change: transform;
  }
  .header.is-hidden  { transform: translateY(-100%); }
  .header.is-pinned  { transform: translateY(0); }

  /* Frosted glass — light tint, strong blur. Content shows through
     while text stays legible thanks to the blur softening backgrounds. */
  .header.is-scrolled {
    background-color: rgba(10, 10, 12, .35);
    -webkit-backdrop-filter: saturate(160%) blur(20px);
            backdrop-filter: saturate(160%) blur(20px);
    box-shadow: inset 0 -1px 0 rgba(255, 255, 255, .08);
  }
  /* Browsers without backdrop-filter (rare) get a slightly stronger
     fallback so text doesn't become unreadable. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .header.is-scrolled {
      background-color: rgba(10, 10, 12, .72);
    }
  }

  /* Never hide the header while the mobile drawer is open */
  body.mob-drawer-open .header {
    transform: translateY(0) !important;
  }

  /* Respect reduced-motion preference */
  @media (prefers-reduced-motion: reduce) {
    .header { transition: none; }
  }

</style>

<!-- ═══════════════════════════════════════════════════
     SCRIPT
     • Teleports #mob-drawer to <body> immediately so
       position:fixed is always viewport-relative and
       cannot be broken by GSAP / Webflow transforms.
     • No Webflow, no jQuery dependencies.
═══════════════════════════════════════════════════ -->
<script is:inline nonce={nonce}>
(function () {
  function init() {
    var toggle   = document.getElementById('mob-toggle');
    var drawer   = document.getElementById('mob-drawer');
    var backdrop = document.getElementById('mob-backdrop');
    var closeBtn = document.getElementById('mob-close');

    if (!toggle || !drawer || !backdrop || !closeBtn) {
      return;
    }

    /* ── TELEPORT: move drawer to <body> ───────────────
       Escapes every transformed / filtered ancestor so
       position:fixed uses the real viewport.            */
    document.body.appendChild(drawer);

    var open = false;

    function openMenu() {
      open = true;
      drawer.classList.add('mob-open');
      drawer.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      document.body.classList.add('mob-drawer-open');
      setTimeout(function () { closeBtn.focus(); }, 40);
    }

    function closeMenu() {
      open = false;
      drawer.classList.remove('mob-open');
      drawer.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      document.body.classList.remove('mob-drawer-open');
      toggle.focus();
    }

    toggle.addEventListener('click', function () {
      open ? closeMenu() : openMenu();
    });

    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);

    drawer.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && open) closeMenu();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
}());
</script>

<!-- ═══════════════════════════════════════════════════
     Auto-hide navbar on scroll-down, reveal on scroll-up.
     • passive scroll listener + rAF batching
     • ignores micro-scrolls and bounce/overscroll
     • always shown near the top of the page
     • re-shown on keyboard focus into the header (a11y)
═══════════════════════════════════════════════════ -->
<script is:inline nonce={nonce}>
(function () {
  function init() {
    var header = document.getElementById('header');
    if (!header) return;

    var lastY    = window.scrollY || 0;
    var ticking  = false;
    var DELTA    = 8;    // ignore tiny scroll jitter
    var TOP_ZONE = 80;   // always show in the top zone
    var HIDE_AT  = 120;  // don't hide until scrolled past hero

    function update() {
      var y    = window.scrollY || 0;
      var diff = y - lastY;

      // Solid bg once user has moved off the very top
      if (y > 10) header.classList.add('is-scrolled');
      else        header.classList.remove('is-scrolled');

      // Always reveal near top
      if (y < TOP_ZONE) {
        header.classList.remove('is-hidden');
        header.classList.add('is-pinned');
        lastY = y;
        ticking = false;
        return;
      }

      // Drawer open: never hide
      if (document.body.classList.contains('mob-drawer-open')) {
        ticking = false;
        return;
      }

      // Ignore micro-scrolls
      if (Math.abs(diff) < DELTA) {
        ticking = false;
        return;
      }

      // Don't react to bounce at the very bottom
      var docH = document.documentElement.scrollHeight;
      if (y + window.innerHeight >= docH - 2) {
        ticking = false;
        return;
      }

      if (diff > 0 && y > HIDE_AT) {
        header.classList.add('is-hidden');
        header.classList.remove('is-pinned');
      } else if (diff < 0) {
        header.classList.remove('is-hidden');
        header.classList.add('is-pinned');
      }

      lastY = y;
      ticking = false;
    }

    window.addEventListener('scroll', function () {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });

    // Reveal when keyboard focus enters the header
    header.addEventListener('focusin', function () {
      header.classList.remove('is-hidden');
      header.classList.add('is-pinned');
    });

    // Initial paint
    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
}());
</script>
