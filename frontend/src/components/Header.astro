                    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <div class="nav-mega-content" role="menu" aria-label="Services submenu">
                  <a href="/services/grc" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.3"/><path d="M7 10l2 2 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 7h14" stroke="currentColor" stroke-width="1.3"/></svg>
                    </div>
                    <div><span class="nav-mega-title">Cybersecurity GRC</span><span class="nav-mega-desc">ISO 27001, NESA, PDPL — implementation, not just advice</span></div>
                  </a>
                  <a href="/services/grc#managed-grc" class="nav-mega-item nav-mega-sub" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 10a7 7 0 0112-4.95L17 7M17 3v4h-4M17 10a7 7 0 01-12 4.95L3 13M3 17v-4h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">Managed GRC — Continuous Compliance <span class="nav-mega-new">NEW</span></span><span class="nav-mega-desc">Monthly maintenance for certified ISMS — audits, evidence, liaison</span></div>
                  </a>
                  <a href="/services/offensive-security" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 18s6.5-3 6.5-8V5L10 2 3.5 5v5c0 5 6.5 8 6.5 8z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M7 10l2 2 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">Offensive Security</span><span class="nav-mega-desc">Pen testing, phishing sims, vulnerability assessments</span></div>
                  </a>
                  <a href="/services/offensive-security#ptaas" class="nav-mega-item nav-mega-sub" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 10a7 7 0 0112-4.95L17 7M17 3v4h-4M17 10a7 7 0 01-12 4.95L3 13M3 17v-4h4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">PTaaS — Penetration Testing as a Service <span class="nav-mega-new">NEW</span></span><span class="nav-mega-desc">Continuous OSCP-led testing, live findings portal, on-demand retests</span></div>
                  </a>
                  <a href="/services/cloud-security" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M6 14a4 4 0 010-8 5 5 0 019-1 3.5 3.5 0 012 6.5" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M7 14h7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">Cloud Security</span><span class="nav-mega-desc">Azure &amp; Microsoft 365 assessments vs CIS benchmarks</span></div>
                  </a>
                  <a href="/services/network-infrastructure" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="7" width="14" height="6" rx="1.5" stroke="currentColor" stroke-width="1.3"/><circle cx="7" cy="10" r="0.8" fill="currentColor"/><circle cx="10" cy="10" r="0.8" fill="currentColor"/><circle cx="13" cy="10" r="0.8" fill="currentColor"/><path d="M10 3v4M10 13v4M3 10H1M19 10h-2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">Network &amp; Infrastructure</span><span class="nav-mega-desc">FortiGate &amp; architecture reviews by CCNP + OSCP</span></div>
                  </a>
                  <a href="/services/training-awareness" class="nav-mega-item" role="menuitem">
                    <div class="nav-mega-icon" aria-hidden="true">
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="7" cy="8" r="2.5" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 17c0-3 2-4.5 4.5-4.5s4.5 1.5 4.5 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="14" cy="8" r="2" stroke="currentColor" stroke-width="1.3"/><path d="M14 12c1.5 0 3.5.8 3.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
                    </div>
                    <div><span class="nav-mega-title">Training &amp; Awareness</span><span class="nav-mega-desc">Workshops &amp; tabletop exercises that measurably stick</span></div>
                  </a>
                </div>
              </div>
              <a data-name="scramble" href="/software" class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'software' ? 'w--current' : ''}`}>Software</a>
              <a data-name="scramble" href="/updates"  class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'updates'  ? 'w--current' : ''}`}>Updates</a>
              <a data-name="scramble" href="/about"    class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'about'    ? 'w--current' : ''}`}>About</a>
              <a data-name="scramble" href="/blog"     class={`nav-link nav-link-gradient w-nav-link ${currentPage === 'blog'     ? 'w--current' : ''}`}>Blog</a>
            </div>
          </nav>
        </div>

        <!-- Desktop CTA -->
        <div class="uw-desktop-cta header-cta-button">
          <div class="button">
            <button type="button" class="button-hidden w-button" data-book-call aria-label="Book a call">Book a Call</button>
            <div class="button-wrapper"><div class="button-text">Book a Call</div></div>
            <div class="button-accent-gradinet"></div>
          </div>
          <div class="button">
            <a href="/#contact" class="button-hidden w-button">Let's Talk</a>
            <div class="button-wrapper"><div class="button-text">Let's Talk</div></div>
