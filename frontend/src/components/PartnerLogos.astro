---
// ===========================================
// PARTNER LOGOS GRID
// Underwings Cybersecurity Solutions
// ===========================================
//
// Renders nothing when the partners table has no visible rows, so callers can
// drop it in without guarding. Pages that wrap it in a titled section should
// still call getPartners() themselves to decide whether to render the heading
// — see index.astro.

import { getPartners } from '../lib/partners';

export interface Props {
  size?: 'small' | 'large';
  linkTo?: string;
}

const { size = 'small', linkTo = '#' } = Astro.props;

// Logos are bounded by BOTH axes, not height alone: a wide horizontal
// lockup (e.g. Sophos, ~10.5:1) sized purely by height would run 3x the
// width of the others. The width cap keeps every mark at a comparable
// optical weight in the row.
const logoHeight = size === 'large' ? 36 : 30;
const logoMaxWidth = size === 'large' ? 240 : 200;

// Optical correction for lockups that pair a FULL-HEIGHT ICON with a much
// SHORTER WORDMARK. An equal box makes their text read far smaller than the
// rest of the row, because the icon — not the text — sets the height.
//
// Measured wordmark height as a share of each logo's own box (rasterised at
// 200px and alpha-scanned, splitting icon from wordmark at the widest empty
// column run):
//   hexnode 100%  ·  sophos 97%  ·  trillium/TISS 75%  ·  sprinto 44%
//
// Sprinto is the clear outlier: its square "S" is full height while SPRINTO
// is under half, so at a shared 30px box the wordmark rendered ~13px against
// hexnode's ~30px. 1.33x lifts it to ~18px, in line with TISS, while keeping
// Sprinto's official lockup intact (cropping the icon would match better
// still, but altering a partner's mark is their call, not ours).
//
// Keyed on the logo filename so it survives partner renames in the DB.
// MEASURE before adding an entry here — do not guess a value.
const OPTICAL_SCALE: Record<string, number> = {
  'sprinto.png': 1.33,
};

const scaleFor = (logoUrl: string) => {
  const file = (logoUrl || '').split('/').pop() || '';
  return OPTICAL_SCALE[file] ?? 1;
};

const partners = await getPartners();
---

{partners.map((p) => {
  const s = scaleFor(p.logo_url);
  return (
    <a href={linkTo} class={`partner-logo ${p.invert_logo ? 'partner-logo--invert' : ''}`} title={p.name}>
      <img
        src={p.logo_url}
        alt={p.name}
        loading="lazy"
        style={`max-height: ${Math.round(logoHeight * s)}px; max-width: ${Math.round(logoMaxWidth * s)}px; width: auto; height: auto; object-fit: contain;`}
      >
    </a>
  );
})}

<style is:inline>
  .partner-logo {
    opacity: 0.85;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partner-logo--invert {
    filter: brightness(0) invert(1);
  }
  .partner-logo:hover {
    opacity: 1;
    filter: drop-shadow(0 0 12px rgba(36,215,88,0.6));
  }
  .partner-logo--invert:hover {
    opacity: 1;
    filter: brightness(0) invert(1) drop-shadow(0 0 12px rgba(36,215,88,0.6));
  }
</style>
