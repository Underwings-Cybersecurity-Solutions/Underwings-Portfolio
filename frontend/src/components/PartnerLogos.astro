---
// ===========================================
// PARTNER LOGOS GRID
// Underwings Cybersecurity Solutions
// ===========================================
//
// Renders nothing when the partners table has no visible rows, so callers can
// drop it in without guarding. Pages that wrap it in a titled section should
// still call getPartners() themselves to decide whether to render the heading
// — see index.astro.

import { getPartners } from '../lib/partners';

export interface Props {
  size?: 'small' | 'large';
  linkTo?: string;
}

const { size = 'small', linkTo = '#' } = Astro.props;

// Logos are bounded by BOTH axes, not height alone: a wide horizontal
// lockup (e.g. Sophos, ~10.5:1) sized purely by height would run 3x the
// width of the others. The width cap keeps every mark at a comparable
// optical weight in the row.
const logoHeight = size === 'large' ? 36 : 30;
const logoMaxWidth = size === 'large' ? 240 : 200;

const partners = await getPartners();
---

{partners.map((p) => (
  <a href={linkTo} class={`partner-logo ${p.invert_logo ? 'partner-logo--invert' : ''}`} title={p.name}>
    <img src={p.logo_url} alt={p.name} loading="lazy" style={`max-height: ${logoHeight}px; max-width: ${logoMaxWidth}px; width: auto; height: auto; object-fit: contain;`}>
  </a>
))}

<style is:inline>
  .partner-logo {
    opacity: 0.85;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .partner-logo--invert {
    filter: brightness(0) invert(1);
  }
  .partner-logo:hover {
    opacity: 1;
    filter: drop-shadow(0 0 12px rgba(36,215,88,0.6));
  }
  .partner-logo--invert:hover {
    opacity: 1;
    filter: brightness(0) invert(1) drop-shadow(0 0 12px rgba(36,215,88,0.6));
  }
</style>
