                </li>
                <li class="footer-nav-list-item">
                  <a data-name="scramble" href="/privacy-policy" class="footer-nav-link footer-nav-link-icon nav-link-gradient w-inline-block">
                    <svg class="footer-nav-ico" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5l5 2v4.5c0 3-2 4.9-5 6-3-1.1-5-3-5-6V3.5l5-2z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M6 8l1.5 1.5L10 7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
