<style is:inline>
  /* ── Tagline ───────────────────────────────────────── */
  #footer .footer-tagline {
    font-size: 0.82rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.7;
    margin-top: 1rem;
    max-width: 280px;
  }

  /* ── Contact CTA card in footer brand column ──── */
  #footer .footer-scope-cta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-top: 1.1rem;
    padding: 0.75rem 0.95rem;
    background: linear-gradient(135deg, rgba(36,215,88,0.08) 0%, rgba(36,215,88,0.02) 100%);
    border: 1px solid rgba(36,215,88,0.28);
    border-radius: 10px;
    color: #fff;
    text-decoration: none;
    max-width: 280px;
    transition: all 180ms ease;
  }
  #footer .footer-scope-cta:hover {
    background: linear-gradient(135deg, rgba(36,215,88,0.14) 0%, rgba(36,215,88,0.04) 100%);
    border-color: rgba(36,215,88,0.5);
    transform: translateY(-1px);
  }
  #footer .footer-scope-cta-ico {
    flex-shrink: 0;
    width: 1.85rem;
    height: 1.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #24d758;
    background: rgba(36,215,88,0.14);
    border: 1px solid rgba(36,215,88,0.28);
    border-radius: 7px;
  }
  #footer .footer-scope-cta-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  #footer .footer-scope-cta-eyebrow {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #24d758;
  }
  #footer .footer-scope-cta-title {
    font-size: 0.86rem;
    font-weight: 600;
    color: #fff;
    line-height: 1.25;
  }
  #footer .footer-scope-cta-arrow { color: #24d758; flex-shrink: 0; }

  /* ── Social media icon row ────────────────────────── */
  #footer .footer-social {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.1rem;
    max-width: 280px;
  }
  #footer .footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    color: rgba(255,255,255,0.65);
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 8px;
    text-decoration: none;
    transition: all 180ms ease;
  }
  #footer .footer-social-link:hover {
