                <li class="footer-nav-list-item">
                  <a data-name="scramble" href="/services/training-awareness" class="footer-nav-link nav-link-gradient w-inline-block"><div>Training &amp; Awareness</div></a>
                </li>
                <li class="footer-nav-list-item">
                  <a data-name="scramble" href="/software" class="footer-nav-link nav-link-gradient w-inline-block"><div>Software</div></a>
                </li>
              </ul>

              <!-- Company Column -->
              <ul role="list" class="footer-nav-list w-list-unstyled">
                <li class="footer-nav-list-item footer-nav-list-head">
