                    <svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M6.53033 0.96967C6.23744 0.676777 5.76256 0.676777 5.46967 0.96967L0.696699 5.74264C0.403806 6.03553 0.403806 6.51041 0.696699 6.8033C0.989592 7.09619 1.46447 7.09619 1.75736 6.8033L6 2.56066L10.2426 6.8033C10.5355 7.09619 11.0104 7.09619 11.3033 6.8033C11.5962 6.51041 11.5962 6.03553 11.3033 5.74264L6.53033 0.96967ZM6 2.5L6.75 2.5L6.75 1.5L6 1.5L5.25 1.5L5.25 2.5L6 2.5Z" fill="white"></path>
                    </svg>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </nav>
      </div>

      <!-- ════════════════════════════════════════════════
           CERTIFICATIONS + METHODOLOGY + COMPLIANCE trust strip
           ════════════════════════════════════════════════ -->
      <div class="footer-trust">
        <div class="footer-trust-col">
          <span class="footer-trust-label">Underwings is certified</span>
          <div class="footer-trust-chips">
            <span class="footer-trust-chip footer-trust-chip-cert">ISO/IEC 27001 · Information Security</span>
            <span class="footer-trust-chip footer-trust-chip-cert">ISO 9001 · Quality Management</span>
          </div>
        </div>
        <div class="footer-trust-col">
          <span class="footer-trust-label">Methodology</span>
          <div class="footer-trust-chips">
            <span class="footer-trust-chip">PTES</span>
            <span class="footer-trust-chip">OWASP WSTG</span>
            <span class="footer-trust-chip">OWASP MASTG</span>
            <span class="footer-trust-chip">OWASP API Top 10</span>
            <span class="footer-trust-chip">NIST SP 800-115</span>
            <span class="footer-trust-chip">MITRE ATT&amp;CK</span>
          </div>
        </div>
        <div class="footer-trust-col">
          <span class="footer-trust-label">Client work aligned to</span>
          <div class="footer-trust-chips">
            <span class="footer-trust-chip footer-trust-chip-green">ISO 27001</span>
            <span class="footer-trust-chip footer-trust-chip-green">UAE IA V2</span>
            <span class="footer-trust-chip footer-trust-chip-green">ADHICS v2</span>
            <span class="footer-trust-chip footer-trust-chip-green">PCI DSS</span>
            <span class="footer-trust-chip footer-trust-chip-green">SOC 2</span>
            <span class="footer-trust-chip footer-trust-chip-green">UAE PDPL</span>
          </div>
        </div>
      </div>

      <!-- ════════════════════════════════════════════════
           NEWSLETTER — cleaned up
           ════════════════════════════════════════════════ -->
      <div class="footer-newsletter">
        <div class="footer-newsletter-inner">
          <div class="footer-newsletter-text">
            <h3 class="footer-newsletter-heading">Monthly UAE Cybersecurity Threat Briefing</h3>
            <p class="footer-newsletter-desc">UAE-specific vulnerability alerts, compliance updates (IA V2, ADHICS, PDPL), real incidents, and practical defensive tips — delivered once a month. No fluff.</p>
            <div class="nl-what-you-get">
              <span>Zero-Day Alerts</span>
              <span>UAE Compliance Updates</span>
              <span>Attack Trend Analysis</span>
              <span>Tool Reviews</span>
            </div>
          </div>
          <form id="newsletter-form" class="footer-newsletter-form">
            <label for="nl-email" class="nl-visually-hidden">Email address</label>
            <div class="footer-newsletter-input-wrap">
              <input type="email" id="nl-email" placeholder="your@email.com" required autocomplete="email" aria-required="true">
              <button type="submit" class="footer-newsletter-btn">
                <span class="nl-btn-text">Subscribe Free</span>
                <span class="nl-btn-loading" style="display:none;">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-dasharray="30 15" stroke-linecap="round"><animateTransform attributeName="transform" type="rotate" from="0 8 8" to="360 8 8" dur="0.8s" repeatCount="indefinite"/></circle></svg>
                </span>
              </button>
            </div>
            <div class="nl-msg nl-success" style="display:none;" role="status" aria-live="polite">You're in. Check your inbox for the welcome briefing.</div>
            <div class="nl-msg nl-error" style="display:none;" role="alert" aria-live="assertive">Something went wrong. Try again or email us.</div>
            <p class="nl-privacy-note">Free · Unsubscribe anytime · No third-party sharing.</p>
          </form>
        </div>
