# ===========================================
# UNDERWINGS DOCKERIZED ENVIRONMENT
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# DOMAIN CONFIGURATION
# ===========================================
SITE_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com
ADMIN_URL=https://admin.yourdomain.com
STUDIO_URL=https://studio.yourdomain.com

# ===========================================
# POSTGRES DATABASE
# ===========================================
POSTGRES_PASSWORD=your-super-secret-db-password-min-32-chars
POSTGRES_USER=postgres
POSTGRES_DB=underwings
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===========================================
# JWT / AUTH
# ===========================================
JWT_SECRET=your-super-secret-jwt-token-min-32-characters-long
ANON_KEY=your-anon-key-will-be-generated
SERVICE_ROLE_KEY=your-service-role-key-will-be-generated

# ===========================================
# SUPABASE CONFIG
# ===========================================
SUPABASE_PUBLIC_URL=https://api.yourdomain.com
SUPABASE_ANON_KEY=${ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SERVICE_ROLE_KEY}

# ===========================================
# SMTP / EMAIL
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Underwings Technologies

# ===========================================
# STUDIO ADMIN
# ===========================================
STUDIO_USERNAME=admin
STUDIO_PASSWORD=your-studio-password

# ===========================================
# DASHBOARD ADMIN
# ===========================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-admin-password

# ===========================================
# SECURITY
# ===========================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# ===========================================
# CAL.COM SELF-HOSTED (Phase 3a)
# Admin creds for book.underwings.org, plus the per-webhook signing secret
# n8n uses for HMAC verification (set the same value in Cal.com when adding
# the webhook in Settings → Developer → Webhooks).
# ===========================================
CALCOM_ADMIN_EMAIL=admin@yourdomain.com
CALCOM_ADMIN_PASSWORD=<set in env>
CALCOM_WEBHOOK_SIGNING_SECRET=<openssl rand -hex 32>
CALCOM_API_KEY=<populate after generating from Cal.com Settings → Developer → API Keys, optional>

# ===========================================
# AUTOMATION TOKENS (Phase 1+)
# Shared secret between the website forms and the n8n inbound webhook.
# ===========================================
INBOUND_WEBHOOK_TOKEN=<openssl rand -hex 24>
SLACK_CHANNEL_NEW_LEADS=<channel id, e.g. C0123456789>
SLACK_CHANNEL_HOT_LEADS_MANOJ=<channel id>

# ===========================================
# n8n INSTANCE
# ===========================================
N8N_DB_PASSWORD=<set in env>
N8N_ENCRYPTION_KEY=<openssl rand -hex 32 — back this up; losing it bricks all stored credentials>

# ===========================================
# PLANE — project management (Phase 3c)
# Generate token from Plane: Workspace Settings -> Developer settings
# -> Access Tokens (workspace admin role required).
# ===========================================
PLANE_API_TOKEN=<paste workspace API token>
PLANE_BASE_URL=https://plan.underwings.org
PLANE_WORKSPACE_SLUG=<your workspace slug, usually 'underwings'>
PLANE_PROJECT_ID=<UUID of project to drop discovery-call cards into>

# --- Website form notifications (contact / newsletter / waitlist) ---
# Who gets told about every form submission (comma-separated).
FORM_NOTIFY_TO=admin@yourdomain.com,sales@yourdomain.com
# Dedicated relay for those notifications. Leave NOTIFY_SMTP_HOST empty to
# fall back to SMTP_* above. In production this is the Brevo relay, because
# the self-hosted Stalwart treats the company domain as local and would keep
# the mail instead of delivering it to the domain's MX.
NOTIFY_SMTP_HOST=smtp-relay.brevo.com
NOTIFY_SMTP_PORT=2525
NOTIFY_SMTP_USER=your-brevo-smtp-login
NOTIFY_SMTP_PASS=your-brevo-smtp-key
